---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import { getUserAuth, updateUser, deleteUser, getCollection, getImageUrl, PB_URL } from '../../js/backend.js';
import PbImage from '../../components/PbImage.astro';
import heartIcon    from '../../assets/icon/like.svg';
import likeFillIcon from '../../assets/icon/like_fill.svg';
import instaIcon    from '../../assets/icon/insta.svg';
import facebookIcon from '../../assets/icon/facebook.svg';
import discordIcon  from '../../assets/icon/discord.svg';
import badgeVip     from '../../assets/icon/badge_vip.svg';
import badgePremium from '../../assets/icon/badge_pernuim.svg';

// Auth guard
const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

let updateError   = '';
let updateSuccess = false;
let pwdError      = '';
let pwdSuccess    = false;
let emailError    = '';
let emailSuccess  = false;
let activeTab     = Astro.url.searchParams.get('tab') ?? 'profil';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action   = formData.get('_action')?.toString();

  if (action === 'logout') {
    Astro.cookies.delete('pb_token',   { path: '/' });
    Astro.cookies.delete('pb_user_id', { path: '/' });
    return Astro.redirect('/');
  }

  if (action === 'delete') {
    await deleteUser(userId, token);
    Astro.cookies.delete('pb_token',   { path: '/' });
    Astro.cookies.delete('pb_user_id', { path: '/' });
    return Astro.redirect('/');
  }

  if (action === 'edit') {
    const pbData = new FormData();
    for (const field of ['prenom', 'nom', 'pseudo', 'age', 'ville', 'insta', 'facbook', 'discord', 'description']) {
      const val = formData.get(field);
      if (val !== null && val.toString() !== '') pbData.append(field, val.toString());
    }
    const avatarFile = formData.get('avatar');
    if (avatarFile instanceof File && avatarFile.size > 0) pbData.append('avatar', avatarFile, avatarFile.name);
    const result = await updateUser(userId, token, pbData);
    if (result) { updateSuccess = true; } else { updateError = 'Erreur lors de la mise à jour.'; }
    activeTab = 'profil';
  }

  if (action === 'change_password') {
    const oldPwd     = formData.get('old_password')?.toString()     ?? '';
    const newPwd     = formData.get('new_password')?.toString()     ?? '';
    const confirmPwd = formData.get('confirm_password')?.toString() ?? '';
    if (!oldPwd || !newPwd || !confirmPwd) {
      pwdError = 'Tous les champs sont requis.';
    } else if (newPwd !== confirmPwd) {
      pwdError = 'Les mots de passe ne correspondent pas.';
    } else if (newPwd.length < 8) {
      pwdError = 'Le mot de passe doit contenir au moins 8 caractères.';
    } else {
      const pbData = new FormData();
      pbData.append('oldPassword',     oldPwd);
      pbData.append('password',        newPwd);
      pbData.append('passwordConfirm', confirmPwd);
      const result = await updateUser(userId, token, pbData);
      if (result) { pwdSuccess = true; } else { pwdError = 'Mot de passe actuel incorrect.'; }
    }
    activeTab = 'parametres';
  }

  if (action === 'change_email') {
    const newEmail = formData.get('new_email')?.toString().trim() ?? '';
    if (!newEmail || !newEmail.includes('@')) {
      emailError = 'Adresse email invalide.';
    } else {
      const pbData = new FormData();
      pbData.append('email', newEmail);
      const result = await updateUser(userId, token, pbData);
      if (result) { emailSuccess = true; } else { emailError = 'Erreur lors de la mise à jour.'; }
    }
    activeTab = 'parametres';
  }
}

// Données utilisateur
const user = await getUserAuth(userId, token);
if (!user || user.code === 404) {
  Astro.cookies.delete('pb_token',   { path: '/' });
  Astro.cookies.delete('pb_user_id', { path: '/' });
  return Astro.redirect('/connexion');
}

// Notifications
let notifications = [];
try {
  notifications = await getCollection('notifications', {
    filter:  `user = "${userId}"`,
    sort:    '-created',
    perPage: 50
  });
} catch {}

// Bars découverts
const barDecouver = Array.isArray(user.bar_decouver) ? user.bar_decouver : [];
let totalBars = 0;
try {
  const bRes = await fetch(`${PB_URL}/api/collections/bar/records?perPage=1`);
  if (bRes.ok) { const bd = await bRes.json(); totalBars = bd.totalItems ?? 0; }
} catch {}

// Bars favoris (tous)
let barsFavori = [];
try {
  const favIds = Array.isArray(user.bar_favori) ? user.bar_favori : [];
  if (favIds.length > 0) {
    const filterStr = favIds.map(id => `id="${id}"`).join('||');
    barsFavori = await getCollection('bar', { filter: filterStr, perPage: 200 });
  }
} catch {}

// Jeux favoris (expand via getUserAuth)
const jeuxFavori = (user.expand?.jeux_favori ?? []);

// Boissons favorites (expand via getUserAuth)
const boissonsFavori = (user.expand?.boisson_favori ?? []);

// Invitations de session entrantes
const demandeSession = (user.expand?.demande_session ?? []).map(s => ({
  id: s.id,
  nom: s.nom ?? 'Session sans nom',
  date: s.date_session ?? null,
  hote: s.id_hote ?? null,
}));

// Demandes d'amis entrantes (expand already done in getUserAuth)
const demandeAmies = (user.expand?.demande_amies ?? []).map(u => ({
  id: u.id, collectionName: u.collectionName,
  pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '',
  avatar: u.avatar ?? null,
}));
const amiesIds    = Array.isArray(user.amies) ? user.amies : [];
const amiesExpand = (user.expand?.amies ?? []).map(u => ({
  id: u.id, collectionName: u.collectionName,
  pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '',
  avatar: u.avatar ?? null, abonnements: u.abonnements ?? 'Gratuit',
}));

// Tous les utilisateurs pour le modal ami (exclure soi-même)
let allUsers = [];
try {
  const usersRes = await getCollection('users', { sort: 'pseudo', perPage: 200 });
  allUsers = usersRes
    .filter(u => u.id !== userId)
    .map(u => ({
      id: u.id, collectionName: u.collectionName,
      pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '',
      avatar: u.avatar ?? null,
    }));
} catch {}

const avatarUrl    = user.avatar ? getImageUrl(user, user.avatar) : null;
const createdAt    = user.created
  ? new Date(user.created).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })
  : '—';
const unreadNotifs = notifications.filter(n => !n.lu).length;

function timeAgo(dateStr) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1)  return "À l'instant";
  if (mins < 60) return `Il y a ${mins} min`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Il y a ${hrs}h`;
  return `Il y a ${Math.floor(hrs / 24)}j`;
}

const displayName = user.prenom
  ? `${user.prenom} ${user.nom ?? ''}`.trim()
  : (user.nom ?? user.pseudo ?? '');
---

<Layout title="Mon profil — Bargo">
  <section class="bg-neutral-200 overflow-x-hidden">

    <!-- ===== MOBILE PROFILE HEADER ===== -->
    <div class="block lg:hidden px-5 pt-8 pb-6">
      <!-- Avatar -->
      <div class="mx-auto w-25 h-25 rounded-full overflow-hidden" style="border: 8px solid #dfdfdf;">
        {avatarUrl
          ? <img src={avatarUrl} alt="Avatar" class="w-full h-full object-cover" />
          : <div class="w-full h-full bg-neutral-800 flex items-center justify-center">
              <span class="text-white font-bold" style="font-size: 36px;">
                {(user.pseudo || user.email || '?')[0].toUpperCase()}
              </span>
            </div>
        }
      </div>
      <h2 class="text-black m-0 mt-4 text-center text-7">{displayName}</h2>
      <div class="flex items-center justify-center gap-2 mt-1">
        <h3 class="m-0 text-primary-500">{user.pseudo ?? ''}</h3>
        {user.abonnements === 'VIP'     && <img src={badgeVip.src}     alt="VIP"     width="24" height="24" />}
        {user.abonnements === 'Premium' && <img src={badgePremium.src} alt="Premium" width="24" height="24" />}
      </div>
      <p class="m-0 mt-2 text-center text-neutral-800 text-4 font-medium">{amiesIds.length} ami(e)s</p>
      <div class="mt-3 h-12.5 bg-primary-900 rounded-1.25 flex items-center justify-center gap-4">
        <h3 class="text-white m-0">Points :</h3>
        <h3 class="text-white m-0">{user.points ?? 0}</h3>
      </div>
      {user.description && (
        <div class="mt-4">
          <p class="m-0 text-4 font-medium text-black uppercase">DESCRIPTION</p>
          <p class="m-0 mt-1 text-neutral-500 text-4 font-medium leading-[1.4]">{user.description}</p>
        </div>
      )}
    </div>

    <!-- ===== DESKTOP PROFILE HEADER ===== -->
    <div class="hidden lg:block relative" style="height: 420px;">
      <!-- Photo de profil -->
      <div id="profile-avatar-wrap" class="absolute left-20 top-29.75 size-46.75 rounded-full overflow-hidden z-2"
        style="border: 15px solid #dfdfdf;">
        {avatarUrl
          ? <img src={avatarUrl} alt="Avatar" class="w-full h-full object-cover" />
          : <div class="w-full h-full bg-neutral-800 flex items-center justify-center">
              <span class="text-white font-bold" style="font-size: 60px;">
                {(user.pseudo || user.email || '?')[0].toUpperCase()}
              </span>
            </div>
        }
      </div>
      <!-- Nom -->
      <h2 class="absolute m-0 text-black overflow-hidden text-ellipsis whitespace-nowrap w-86"
        style="left: calc(16.67% + 59px); top: 119px;">
        {displayName}
      </h2>
      <!-- Pseudo -->
      <div class="absolute flex items-center gap-2" style="left: calc(16.67% + 59px); top: 185px;">
        <h3 class="m-0 text-primary-500">{user.pseudo ?? ''}</h3>
        {user.abonnements === 'VIP'     && <img src={badgeVip.src}     alt="VIP"     width="28" height="28" />}
        {user.abonnements === 'Premium' && <img src={badgePremium.src} alt="Premium" width="28" height="28" />}
      </div>
      <!-- Ami(e)s -->
      <p class="absolute m-0 text-neutral-800 text-4 font-medium leading-[1.4]"
        style="left: calc(33.33% + 79px); top: 198px;">
        {amiesIds.length} ami(e)s
      </p>
      <!-- Points badge -->
      <div class="absolute h-16.25 w-86 bg-primary-900 rounded-1.25 shadow-[0px_4px_10px_0px_rgba(0,0,0,0.25)] flex items-center pl-4 gap-4"
        style="left: calc(16.67% + 59px); top: 241px;">
        <h3 class="text-white m-0">Points :</h3>
        <h3 class="text-white m-0">{user.points ?? 0}</h3>
      </div>
      <!-- DESCRIPTION label -->
      <p class="absolute m-0 text-4 font-medium text-black uppercase leading-[1.4]"
        style="left: calc(50% + 17px); top: 127px;">
        DESCRIPTION
      </p>
      <!-- Description text -->
      <p class="absolute m-0 text-neutral-500 text-4 font-medium leading-[1.4] w-155.75"
        style="left: calc(50% + 16px); top: 174px;">
        {user.description ?? '—'}
      </p>
    </div>

    <!-- Séparateur shadow (desktop only) -->
    <div class="hidden lg:block h-4.5 bg-neutral-200 shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)] z-3"></div>

    <!-- ===== DEUX COLONNES ===== -->
    <div class="flex flex-col lg:flex-row">

      <!-- SIDEBAR SOMBRE (desktop only) -->
      <div class="hidden lg:block lg:w-94 lg:shrink-0 bg-neutral-800 overflow-y-auto">
        <div class="px-8 pt-6 pb-10 flex flex-col gap-5">

          <!-- Boutique -->
          <a href="/boutique"
            class="flex items-center justify-center border-2 border-white text-white text-4 font-medium leading-[1.4] h-15 w-59.25 hover:bg-white hover:text-neutral-800 transition-colors shrink-0">
            Boutique
          </a>

          <!-- Ajouter des amis -->
          <button id="btn-open-friends"
            class="flex items-center justify-center border-2 border-white text-white text-4 font-medium leading-[1.4] h-15 w-59.25 hover:bg-white hover:text-neutral-800 transition-colors cursor-pointer bg-transparent shrink-0">
            Ajouter des amis
          </button>

          <!-- Liste des amis -->
          {amiesExpand.length > 0 && (
            <div class="flex flex-col gap-5 mt-3">
              {amiesExpand.map(ami => (
                <a href={`/profil/${ami.id}`} class="flex items-center gap-4 no-underline hover:opacity-80 transition-opacity">
                  <div class="w-16 h-16 rounded-full overflow-hidden shrink-0">
                    {ami.avatar
                      ? <img src={getImageUrl(ami, ami.avatar)} alt={ami.pseudo} class="w-full h-full object-cover" />
                      : <div class="w-full h-full bg-primary-600 flex items-center justify-center">
                          <span class="text-white font-bold text-6">{(ami.pseudo || ami.prenom || '?')[0].toUpperCase()}</span>
                        </div>
                    }
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <p class="text-white font-bold text-4 m-0 truncate">{ami.pseudo || ''}</p>
                      {ami.abonnements === 'VIP'     && <img src={badgeVip.src}     alt="VIP"     width="18" height="18" class="shrink-0" />}
                      {ami.abonnements === 'Premium' && <img src={badgePremium.src} alt="Premium" width="18" height="18" class="shrink-0" />}
                    </div>
                    <p class="text-neutral-300 text-3.5 font-medium m-0 truncate">{`${ami.prenom ?? ''} ${ami.nom ?? ''}`.trim()}</p>
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- CONTENU PRINCIPAL -->
      <div class="flex-1 bg-neutral-200">

        <!-- BARRE D'ONGLETS BLANCHE -->
        <div class="bg-white flex flex-wrap items-stretch px-4 lg:px-20 shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)] min-h-16 lg:h-25">
          <div id="tab-list" class="relative flex items-stretch h-full overflow-x-auto">
            <button data-tab="profil"
              class="tab-btn px-4 lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap">
              Mon profil
            </button>
            <button data-tab="notifications"
              class="tab-btn px-4 lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 inline-flex items-center gap-2 whitespace-nowrap">
              Notifications
              {(unreadNotifs + demandeAmies.length + demandeSession.length) > 0 && (
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-500 text-white text-2.75 font-bold">{unreadNotifs + demandeAmies.length + demandeSession.length}</span>
              )}
            </button>
            <button data-tab="parametres"
              class="tab-btn px-4 lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap">
              Paramètres
            </button>
            <!-- Trait animé -->
            <div id="tab-indicator" class="absolute bottom-0 h-1 rounded-full" style="background:#72c073; transition: left 0.3s cubic-bezier(.4,0,.2,1), width 0.3s cubic-bezier(.4,0,.2,1); left:0; width:0;"></div>
          </div>

          <!-- Editer / Annuler (desktop only) -->
          <button id="edit-btn"
            class="hidden lg:flex ml-auto bg-primary-600 h-12.75 w-64.25 items-center justify-center text-white text-4 font-medium hover:opacity-90 transition-opacity cursor-pointer border-0 self-center">
            Editer le profil
          </button>
          <button id="cancel-btn" style="display: none;"
            class="ml-auto border-2 border-primary-600 text-primary-600 h-12.75 w-64.25 flex items-center justify-center text-4 font-medium hover:bg-primary-600 hover:text-white transition-colors cursor-pointer bg-transparent self-center">
            Annuler
          </button>
        </div>

        <!-- ============================= -->
        <!-- PANEL : MON PROFIL           -->
        <!-- ============================= -->
        <div id="panel-profil" data-panel class={activeTab !== 'profil' ? 'hidden' : ''}>
          <div class="px-4 lg:px-20 pt-8 lg:pt-11.25 pb-16 lg:pb-30">

            {updateSuccess && <p class="text-primary-600 text-sm font-medium mb-6 m-0">Profil mis à jour avec succès.</p>}
            {updateError   && <p class="text-red-500 text-sm font-medium mb-6 m-0">{updateError}</p>}

            <!-- H2 Données du compte + ligne décorative -->
            <div class="flex items-center gap-7.5 mb-11.25">
              <h2 class="text-black m-0 shrink-0">Données du compte</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

            <form method="POST" enctype="multipart/form-data" id="profile-form">
              <input type="hidden" name="_action" value="edit" />

              <!-- Box 1 : Informations personnelles -->
              <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-4 lg:px-7.5 py-5.5 mb-4.5">
                <h3 class="text-black m-0 mb-8.75">Informations personnel</h3>
                <div class="flex flex-col lg:flex-row gap-4 lg:gap-25">
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Ville</span>
                    <span class="view-field text-black text-4 font-medium leading-[1.4]">{user.ville ?? '—'}</span>
                    <input type="text" name="ville" value={user.ville ?? ''} placeholder="Ville"
                      class="edit-field hidden text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-1 outline-none w-35" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Âge</span>
                    <span class="view-field text-black text-4 font-medium leading-[1.4]">{user.age ? `${user.age} ans` : '—'}</span>
                    <input type="number" name="age" value={user.age ?? ''} placeholder="Âge" min="13" max="120"
                      class="edit-field hidden text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-1 outline-none w-25" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Membre depuis</span>
                    <span class="text-black text-4 font-medium leading-[1.4]">{createdAt}</span>
                  </div>
                </div>
              </div>

              <!-- Box 2 : Activité sur Bargo -->
              <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-4 lg:px-7.5 py-5.5 mb-4.5">
                <h3 class="text-black m-0 mb-8.75">Activité sur Bargo</h3>
                <div class="flex flex-col lg:flex-row gap-4 lg:gap-25">
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Sorties organisées</span>
                    <span class="text-black text-4 font-medium leading-[1.4]">
                      {user.barathon_organiser ? `${user.barathon_organiser} sorties` : '—'}
                    </span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Barathons réalisés</span>
                    <span class="text-black text-4 font-medium leading-[1.4]">
                      {user.barathon_participer ? `${user.barathon_participer} parcours` : '—'}
                    </span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Bars découverts</span>
                    <span class="text-black text-4 font-medium leading-[1.4]">{barDecouver.length}/{totalBars}</span>
                  </div>
                </div>
              </div>

              <!-- Box 3 : Réseaux sociaux -->
              <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-4 lg:px-7.5 py-5.5">
                <h3 class="text-black m-0 mb-8.75">Réseaux sociaux</h3>
                <div class="flex flex-wrap gap-10">
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Instagram</span>
                    <div class="view-field flex items-center gap-2">
                      <img src={instaIcon.src} alt="" width="18" height="18" />
                      <span class="text-black text-4 font-medium leading-[1.4]">{user.insta || '—'}</span>
                    </div>
                    <input type="text" name="insta" value={user.insta ?? ''} placeholder="@pseudo"
                      class="edit-field hidden text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-1 outline-none w-40" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Facebook</span>
                    <div class="view-field flex items-center gap-2">
                      <img src={facebookIcon.src} alt="" width="18" height="18" />
                      <span class="text-black text-4 font-medium leading-[1.4]">{user.facbook || '—'}</span>
                    </div>
                    <input type="text" name="facbook" value={user.facbook ?? ''} placeholder="Nom Facebook"
                      class="edit-field hidden text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-1 outline-none w-40" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-[1.4]">Discord</span>
                    <div class="view-field flex items-center gap-2">
                      <img src={discordIcon.src} alt="" width="18" height="18" />
                      <span class="text-black text-4 font-medium leading-[1.4]">{user.discord || '—'}</span>
                    </div>
                    <input type="text" name="discord" value={user.discord ?? ''} placeholder="@pseudo"
                      class="edit-field hidden text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-1 outline-none w-40" />
                  </div>
                </div>
              </div>

              <!-- Champs édition étendus (nom, prénom, pseudo, description, avatar) -->
              <div class="edit-field hidden mt-7.5"><div class="flex flex-col gap-5">
                <div class="flex gap-6 flex-wrap">
                  <div class="flex flex-col gap-1">
                    <label class="text-4 font-medium text-black">Prénom</label>
                    <input type="text" name="prenom" value={user.prenom ?? ''} placeholder="Prénom"
                      class="text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-2 outline-none w-50" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <label class="text-4 font-medium text-black">Nom</label>
                    <input type="text" name="nom" value={user.nom ?? ''} placeholder="Nom"
                      class="text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-2 outline-none w-50" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <label class="text-4 font-medium text-black">Pseudo</label>
                    <input type="text" name="pseudo" value={user.pseudo ?? ''} placeholder="Pseudo"
                      class="text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-2 outline-none w-50" />
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-4 font-medium text-black">Description</label>
                  <textarea name="description" placeholder="Votre description..."
                    class="text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-2 outline-none resize-none w-full max-w-150 h-25">{user.description ?? ''}</textarea>
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-4 font-medium text-black">Photo de profil</label>
                  <input id="avatar-upload" type="file" name="avatar" accept="image/*"
                    class="text-sm text-neutral-500 file:mr-4 file:py-2 file:px-4 file:border-0 file:bg-primary-600 file:text-white file:cursor-pointer cursor-pointer" />
                </div>
                <button type="submit"
                  class="inline-flex items-center gap-4 bg-primary-900 text-white text-4 font-medium leading-[1.4] px-12.5 py-2 hover:opacity-90 transition-opacity cursor-pointer border-0 w-fit">
                  Sauvegarder
                </button>
              </div></div>
            </form>

            <!-- H2 Favoris + ligne décorative -->
            <div class="flex items-center gap-7.5 mt-20 mb-14">
              <h2 class="text-black m-0 shrink-0">Favoris</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

            <!-- Grille favoris -->
            <!-- Bars favoris -->
            {barsFavori.length > 0 ? (
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-8.25">
                {barsFavori.map(bar => (
                  <div class="relative bg-white rounded-0.5 h-87.75 shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)]">
                    <div class="absolute top-0 left-0 right-0 h-50 overflow-hidden rounded-tl-0.5 rounded-tr-0.5">
                      <PbImage record={bar} recordImage={bar.img?.[0]} width={280} height={200} class="w-full h-full object-cover" />
                    </div>
                    <h3 class="absolute top-52.5 left-4.75 right-4.75 m-0 text-black">{bar.nom}</h3>
                    <button class="like-btn-bar absolute bottom-5.25 right-5.25 w-6 h-6 flex items-center justify-center bg-transparent border-0 cursor-pointer p-0" data-id={bar.id} type="button" aria-label="Retirer des favoris">
                      <img src={heartIcon.src}    alt="" width="24" height="24" class="like-empty hidden" />
                      <img src={likeFillIcon.src} alt="" width="24" height="24" class="like-filled" />
                    </button>
                    <a href={`/bar/${bar.id}`}
                      class="absolute bottom-5.25 left-4.75 w-37.5 h-11 bg-neutral-800 flex items-center justify-center text-white text-4 font-medium hover:opacity-80 transition-opacity">
                      En savoir plus
                    </a>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-neutral-500 text-4 font-medium m-0">Aucun bar favori pour l'instant.</p>
            )}

            <!-- H2 Jeux favoris + ligne décorative -->
            <div class="flex items-center gap-7.5 mt-20 mb-14">
              <h2 class="text-black m-0 shrink-0">Jeux favoris</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

            {jeuxFavori.length > 0 ? (
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-8.25">
                {jeuxFavori.map(jeu => {
                  const imgFile = Array.isArray(jeu.img) ? jeu.img[0] : jeu.img;
                  return (
                    <div class="relative bg-white rounded-0.5 h-87.75 shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)]">
                      <div class="absolute top-0 left-0 right-0 h-50 overflow-hidden rounded-tl-0.5 rounded-tr-0.5">
                        <PbImage record={jeu} recordImage={imgFile} width={280} height={200} class="w-full h-full object-cover" />
                      </div>
                      <h3 class="absolute top-52.5 left-4.75 right-4.75 m-0 text-black">{jeu.nom}</h3>
                      <button class="like-btn-jeux absolute bottom-5.25 right-5.25 w-6 h-6 flex items-center justify-center bg-transparent border-0 cursor-pointer p-0" data-id={jeu.id} type="button" aria-label="Retirer des favoris">
                        <img src={heartIcon.src}    alt="" width="24" height="24" class="like-empty hidden" />
                        <img src={likeFillIcon.src} alt="" width="24" height="24" class="like-filled" />
                      </button>
                      <a href="/jeux"
                        class="absolute bottom-5.25 left-4.75 w-37.5 h-11 bg-neutral-800 flex items-center justify-center text-white text-4 font-medium hover:opacity-80 transition-opacity">
                        Voir les jeux
                      </a>
                    </div>
                  );
                })}
              </div>
            ) : (
              <p class="text-neutral-500 text-4 font-medium m-0">Aucun jeu favori pour l'instant.</p>
            )}

            <!-- H2 Boissons favorites + ligne décorative -->
            <div class="flex items-center gap-7.5 mt-20 mb-14">
              <h2 class="text-black m-0 shrink-0">Boissons favorites</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

            {boissonsFavori.length > 0 ? (
              <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
                {boissonsFavori.map(b => (
                  <div class="flex flex-col gap-2">
                    <div class="h-40 lg:h-50 rounded-1.25 overflow-hidden shadow-[0px_4px_4px_0px_rgba(0,0,0,0.15)]">
                      <img src={getImageUrl(b, b.img)} alt={b.nom} class="w-full h-full object-cover" loading="lazy" />
                    </div>
                    <p class="text-black text-4 font-medium m-0 text-center">{b.nom}</p>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-neutral-500 text-4 font-medium m-0">Aucune boisson favorite pour l'instant.</p>
            )}

          </div>
        </div>

        <!-- ============================= -->
        <!-- PANEL : NOTIFICATIONS        -->
        <!-- ============================= -->
        <div id="panel-notifications" data-panel class={activeTab !== 'notifications' ? 'hidden' : ''}>
          <div class="px-4 lg:px-20 pt-8 lg:pt-11.25 pb-16 lg:pb-30">

            <div class="flex items-center gap-7.5 mb-11.25">
              <h2 class="text-black m-0 shrink-0">Notifications</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

            {demandeAmies.length > 0 && (
              <div id="friend-requests-section" class="mb-8">
                <h3 class="text-black m-0 mb-5">Demandes d'amis ({demandeAmies.length})</h3>
                <div class="flex flex-col gap-3">
                  {demandeAmies.map(requester => (
                    <div class="friend-request-item flex items-center gap-4 p-5 bg-white rounded-2.5 border-0.75 border-primary-500" data-friend-id={requester.id}>
                      <div class="w-12 h-12 rounded-full overflow-hidden shrink-0 bg-neutral-800 flex items-center justify-center">
                        {requester.avatar
                          ? <img src={getImageUrl(requester, requester.avatar)} alt="" class="w-full h-full object-cover" />
                          : <span class="text-white font-bold text-5">{(requester.pseudo || requester.prenom || '?')[0].toUpperCase()}</span>
                        }
                      </div>
                      <div class="flex-1 min-w-0">
                        <p class="text-4 font-medium text-black m-0">
                          <strong>{requester.pseudo || `${requester.prenom} ${requester.nom}`.trim() || 'Utilisateur'}</strong> vous a envoyé une demande d'ami
                        </p>
                      </div>
                      <div class="flex gap-2 shrink-0">
                        <button class="friend-accept bg-primary-600 text-white text-3.5 font-medium px-4 py-2 cursor-pointer border-0 rounded hover:opacity-90 transition-opacity">Accepter</button>
                        <button class="friend-refuse border-2 border-neutral-300 text-neutral-500 text-3.5 font-medium px-4 py-2 cursor-pointer bg-transparent rounded hover:border-neutral-500 transition-colors">Refuser</button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {demandeSession.length > 0 && (
              <div id="session-requests-section" class="mb-8">
                <h3 class="text-black m-0 mb-5">Invitations de session ({demandeSession.length})</h3>
                <div class="flex flex-col gap-3">
                  {demandeSession.map(s => (
                    <div class="session-invite-item flex items-center gap-4 p-5 bg-white rounded-2.5 border-0.75 border-primary-500" data-session-id={s.id}>
                      <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-primary-900">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round">
                          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                          <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                      </div>
                      <div class="flex-1 min-w-0">
                        <p class="text-4 font-medium text-black m-0">
                          Invitation au barathon <strong>{s.nom}</strong>
                        </p>
                        {s.date && (
                          <p class="text-sm text-neutral-500 m-0 mt-0.5">
                            {new Date(s.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                          </p>
                        )}
                      </div>
                      <div class="flex gap-2 shrink-0">
                        <button class="session-invite-accept bg-primary-600 text-white text-3.5 font-medium px-4 py-2 cursor-pointer border-0 rounded hover:opacity-90 transition-opacity" data-session-href={`/session/${s.id}`}>Accepter</button>
                        <button class="session-invite-refuse border-2 border-neutral-300 text-neutral-500 text-3.5 font-medium px-4 py-2 cursor-pointer bg-transparent rounded hover:border-neutral-500 transition-colors">Refuser</button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {notifications.length > 0 ? (
              <div class="flex flex-col gap-3">
                {notifications.map(notif => (
                  <div class={`flex items-start gap-4 p-5 bg-white rounded-2.5 border-0.75 ${!notif.lu ? 'border-primary-500' : 'border-neutral-300'}`}>
                    <div class={`w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${notif.type === 'success' ? 'bg-primary-500' : 'bg-primary-600'}`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                    <div class="flex-1">
                      <p class={`text-4 m-0 leading-[1.4] ${!notif.lu ? 'font-bold' : 'font-medium'} text-black`}>
                        {notif.message ?? notif.texte ?? notif.contenu ?? 'Notification'}
                      </p>
                      <p class="text-sm text-neutral-500 m-0 mt-1">{timeAgo(notif.created)}</p>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="flex flex-col items-center justify-center py-24">
                <div class="w-20 h-20 rounded-full bg-neutral-300 flex items-center justify-center mb-6">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="#646262" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="#646262" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <p class="text-neutral-500 text-4 font-medium m-0">Aucune notification</p>
                <p class="text-sm text-neutral-500 m-0 mt-2">Vous êtes à jour !</p>
              </div>
            )}
          </div>
        </div>

        <!-- ============================= -->
        <!-- PANEL : PARAMÈTRES           -->
        <!-- ============================= -->
        <div id="panel-parametres" data-panel class={activeTab !== 'parametres' ? 'hidden' : ''}>
          <div class="px-4 lg:px-20 pt-8 lg:pt-11.25 pb-16 lg:pb-30">

            <div class="flex items-center gap-7.5 mb-11.25">
              <h2 class="text-black m-0 shrink-0">Paramètres</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
              {user.admin && (
                <a href="/admin" class="shrink-0 inline-flex items-center justify-center h-10 px-6 bg-[#094736] text-white text-sm font-semibold rounded-sm hover:opacity-80 transition-opacity">
                  Panneau admin
                </a>
              )}
            </div>

            <!-- Email -->
            <h3 class="text-black m-0 mb-5">Email</h3>
            <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-7.5 py-5.5 mb-8">
              <div class="flex items-center border-b-2 border-neutral-300 pb-4 mb-5">
                <span class="text-4 font-medium text-black w-40 shrink-0">Email actuel</span>
                <span class="text-4 font-medium text-neutral-500">{user.email ?? '—'}</span>
              </div>
              {emailSuccess && <p class="text-primary-600 text-sm font-medium mb-4 m-0">Email mis à jour.</p>}
              {emailError   && <p class="text-red-500 text-sm font-medium mb-4 m-0">{emailError}</p>}
              <form method="POST" enctype="application/x-www-form-urlencoded" class="flex flex-col lg:flex-row lg:items-end gap-4">
                <input type="hidden" name="_action" value="change_email" />
                <div class="flex-1">
                  <label class="block text-4 font-medium text-black mb-2">Nouvel email</label>
                  <input type="email" name="new_email" placeholder="nouveau@email.com"
                    class="w-full text-4 font-medium bg-neutral-200 border-2 border-neutral-300 rounded px-4 py-2 outline-none" />
                </div>
                <button type="submit"
                  class="bg-primary-600 text-white text-4 font-medium px-8 py-2.25 hover:opacity-90 transition-opacity cursor-pointer border-0 rounded shrink-0">
                  Modifier
                </button>
              </form>
            </div>

            <!-- Mot de passe -->
            <h3 class="text-black m-0 mb-5">Sécurité</h3>
            <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-7.5 py-5.5 mb-8">
              {pwdSuccess && <p class="text-primary-600 text-sm font-medium mb-4 m-0">Mot de passe modifié.</p>}
              {pwdError   && <p class="text-red-500 text-sm font-medium mb-4 m-0">{pwdError}</p>}
              <form method="POST" enctype="application/x-www-form-urlencoded" class="flex flex-col gap-5">
                <input type="hidden" name="_action" value="change_password" />
                <div>
                  <label class="block text-4 font-medium text-black mb-2">Mot de passe actuel</label>
                  <input type="password" name="old_password" placeholder="••••••••"
                    class="w-full max-w-100 text-4 font-medium bg-neutral-200 border-2 border-neutral-300 rounded px-4 py-2 outline-none" />
                </div>
                <div class="flex gap-4">
                  <div class="flex-1">
                    <label class="block text-4 font-medium text-black mb-2">Nouveau mot de passe</label>
                    <input type="password" name="new_password" placeholder="••••••••"
                      class="w-full text-4 font-medium bg-neutral-200 border-2 border-neutral-300 rounded px-4 py-2 outline-none" />
                  </div>
                  <div class="flex-1">
                    <label class="block text-4 font-medium text-black mb-2">Confirmer</label>
                    <input type="password" name="confirm_password" placeholder="••••••••"
                      class="w-full text-4 font-medium bg-neutral-200 border-2 border-neutral-300 rounded px-4 py-2 outline-none" />
                  </div>
                </div>
                <button type="submit"
                  class="inline-flex items-center gap-3 bg-primary-900 text-white text-4 font-medium px-8 py-2.25 hover:opacity-90 transition-opacity cursor-pointer border-0 rounded w-fit">
                  Changer le mot de passe
                </button>
              </form>
            </div>

            <!-- Session -->
            <h3 class="text-black m-0 mb-5">Session</h3>
            <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-7.5 py-5.5 mb-8">
              <p class="text-4 font-medium text-black m-0 mb-4">
                Connecté en tant que <span class="text-primary-500">{user.pseudo ?? user.email}</span>
              </p>
              <form method="POST" enctype="application/x-www-form-urlencoded">
                <input type="hidden" name="_action" value="logout" />
                <button type="submit"
                  class="inline-flex items-center gap-3 border-2 border-neutral-800 text-neutral-800 text-4 font-medium px-8 py-2.25 hover:bg-neutral-800 hover:text-white transition-colors cursor-pointer bg-transparent rounded">
                  Se déconnecter
                </button>
              </form>
            </div>

            <!-- Zone dangereuse -->
            <h3 class="text-black m-0 mb-5">Zone dangereuse</h3>
            <div class="bg-white rounded-2.5 px-7.5 py-5.5" style="border: 3px solid #fecaca;">
              <div class="flex items-center justify-between gap-8">
                <div>
                  <p class="text-4 font-medium text-black m-0">Supprimer mon compte</p>
                  <p class="text-sm text-neutral-500 m-0 mt-1">Action irréversible. Toutes vos données seront supprimées définitivement.</p>
                </div>
                <form method="POST" enctype="application/x-www-form-urlencoded" id="delete-form" class="shrink-0">
                  <input type="hidden" name="_action" value="delete" />
                  <button type="button" id="delete-btn"
                    class="inline-flex items-center gap-2 border-2 border-red-500 text-red-500 text-4 font-medium px-6 py-2.25 hover:bg-red-500 hover:text-white transition-colors cursor-pointer bg-transparent rounded">
                    Supprimer
                  </button>
                </form>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- Friend modal -->
  <div id="friend-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65); z-index:50; align-items:center; justify-content:center;">
    <div style="background:#1e1e1e; width:min(520px,95vw); max-height:80vh; display:flex; flex-direction:column; border-radius:5px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.5);">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:20px 28px; border-bottom:1px solid rgba(255,255,255,0.1);">
        <h3 style="color:white; margin:0; font-size:25px; font-weight:500; letter-spacing:-1px;">Ajouter des amis</h3>
        <button id="friend-modal-close" style="background:transparent; border:none; color:white; font-size:26px; line-height:1; cursor:pointer; opacity:0.6;">×</button>
      </div>
      <div style="padding:14px 28px; border-bottom:1px solid rgba(255,255,255,0.1);">
        <div style="display:flex; align-items:center; gap:12px; background:#2c2c2c; border-radius:5px; padding:0 14px; height:42px;">
          <svg width="14" height="14" viewBox="0 0 18 18" fill="none"><circle cx="7.5" cy="7.5" r="5.5" stroke="#f7f1ed" stroke-opacity="0.4" stroke-width="1.5"/><path d="M12 12L16 16" stroke="#f7f1ed" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/></svg>
          <input id="friend-search" type="text" placeholder="Rechercher un utilisateur…" style="background:transparent; flex:1; font-size:14px; font-weight:500; outline:none; border:none; color:#f7f1ed;" class="placeholder-neutral-200/40" />
        </div>
      </div>
      <div id="friend-modal-list" style="overflow-y:auto; flex:1; padding:20px 28px;"></div>
    </div>
  </div>

  <script id="friend-data" type="application/json" set:html={JSON.stringify({ allUsers, amiesIds, userId, token, PB_URL })}></script>

  <script is:inline define:vars={{ token, userId, activeTab }}>
    if (token && userId) {
      window.__AUTH__ = { token, userId };
    }
    window.__ACTIVE_TAB__ = activeTab;
  </script>

  <script>
    import '../../js/profil.js';
    import '../../js/like.js';
    import '../../js/amis.js';
  </script>
</Layout>
