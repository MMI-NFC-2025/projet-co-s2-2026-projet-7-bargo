---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';

const token  = Astro.cookies.get('pb_token')?.value ?? '';
const userId = Astro.cookies.get('pb_user_id')?.value ?? '';
if (!token || !userId) return Astro.redirect('/connexion');

const PB_URL = 'https://pbbargo.pierre-mouilleseaux-lhuillier.fr';

const rawThemes = Astro.url.searchParams.get('themes') ?? '';
const themes    = rawThemes.split(',').filter(Boolean);
const time      = Math.max(5, Math.min(60, parseInt(Astro.url.searchParams.get('time') ?? '20')));
const sessionId = Astro.url.searchParams.get('session') ?? '';
const inSession = !!(sessionId && token && userId);

if (themes.length === 0) {
  return Astro.redirect('/jeux_questionaire');
}

const filterParts = themes.map(t => `theme="${t}"`).join('||');
const filter      = encodeURIComponent(filterParts);
const res         = await fetch(`${PB_URL}/api/collections/jeux_questionaire/records?perPage=100&sort=@random&filter=${filter}`);
const data        = await res.json();
const allQ        = data.items ?? [];
const fetchError  = !res.ok ? `HTTP ${res.status} — ${data?.message ?? 'erreur inconnue'}` : null;

// Shuffle + take 10
for (let i = allQ.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [allQ[i], allQ[j]] = [allQ[j], allQ[i]];
}

const themeLabels = { cultrue_g: 'Culture générale', jeux_video: 'Jeux vidéo', histoire: 'Histoire' };
function tLabel(t) { return themeLabels[t] ?? t.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()); }

const questions = allQ.slice(0, 10).map(q => ({
  q: q.question,
  c: [q.choix_1, q.choix_2, q.choix_3, q.choix_4],
  a: [q.reponse_1, q.reponse_2, q.reponse_3, q.reponse_4].findIndex(v => v === true),
  t: tLabel(q.theme),
}));
---

<Layout title="Quiz — Bargo" noFooter={true}>

  <!-- Barre de progression en haut -->
  <div class="fixed top-0 left-0 right-0 z-50 h-1 bg-[#333]">
    <div id="quiz-progress" class="h-full bg-[#72C073] transition-[width] duration-300" style="width:0%"></div>
  </div>

  {questions.length === 0 ? (
    <div class="min-h-screen bg-[#1E1E1E] flex flex-col items-center justify-center px-4 text-center">
      <p class="text-[#F7F1ED] text-4 font-medium mb-6">Aucune question trouvée pour ce thème.</p>
      {fetchError && <p class="text-red-400 text-3.5 font-medium mb-4 opacity-80">{fetchError}</p>}
      <a href="/jeux_questionaire" class="bg-[#347645] text-white px-8 h-12 flex items-center text-4 font-medium no-underline hover:opacity-90 transition-opacity">
        Retour
      </a>
    </div>
  ) : (

    <main class="min-h-screen bg-[#1E1E1E] flex flex-col items-center justify-center px-4 py-16">

      <!-- ===== PHASE JEU ===== -->
      <div id="phase-playing" class="w-full max-w-2xl">

        <!-- En-tête : compteur + timer texte -->
        <div class="flex items-center justify-between mb-3">
          <span id="q-counter" class="text-[#DFDFDF] text-3.5 font-medium tracking-wide uppercase opacity-70">Question 1 / {questions.length}</span>
          <div class="flex items-center gap-2">
            <span id="timer-text" class="font-bold text-5 tabular-nums" style="color:#72C073">{time}</span>
            <span class="text-[#DFDFDF] text-3.5 opacity-50">sec</span>
          </div>
        </div>

        <!-- Barre timer -->
        <div class="w-full h-1 bg-[#2c2c2c] rounded-full mb-8">
          <div id="timer-bar" class="h-full rounded-full" style="width:100%;background:#72C073;transition:width 0.9s linear,background 0.5s"></div>
        </div>

        <!-- Carte question -->
        <div class="bg-[#252525] border border-[#333] rounded-1 px-6 py-7 mb-5">
          <span id="q-theme-badge" class="inline-block text-[#72C073] text-3 font-medium uppercase tracking-widest mb-3 opacity-80"></span>
          <p id="q-text" class="m-0 text-white text-4.5 lg:text-5 font-medium leading-normal"></p>
        </div>

        <!-- Choix (2×2) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5">
          {[0,1,2,3].map(i => (
            <button
              id={`choice-${i}`}
              data-index={String(i)}
              class="choice-btn min-h-14 px-5 py-3.5 bg-[#252525] border border-[#3a3a3a] text-white text-3.5 font-medium text-left rounded-0.5 hover:border-[#72C073] hover:bg-[#2c3a2c] transition-all cursor-pointer flex items-center gap-4"
            >
              <span class="w-7 h-7 rounded-full border border-[#72C073] text-[#72C073] text-3 font-bold flex items-center justify-center shrink-0">{String.fromCharCode(65 + i)}</span>
              <span class="choice-text leading-snug"></span>
            </button>
          ))}
        </div>

      </div>

      <!-- ===== PHASE RÉSULTAT ===== -->
      <div id="phase-result" class="hidden w-full max-w-lg">

        <!-- Score card -->
        <div class="bg-[#252525] border border-[#333] rounded-1 p-8 lg:p-10 mb-6 text-center">

          <!-- Score visuel -->
          <div id="result-circle-section" class="flex items-center justify-center gap-6 mb-6">
            <div class="w-28 h-28 rounded-full flex flex-col items-center justify-center shrink-0" style="background: conic-gradient(#72C073 0deg, #72C073 calc(var(--pct,0) * 360deg), #333 calc(var(--pct,0) * 360deg)); padding: 4px;">
              <div class="w-full h-full rounded-full bg-[#252525] flex flex-col items-center justify-center">
                <span id="result-correct" class="text-white font-bold text-8 leading-none"></span>
                <span class="text-[#DFDFDF] text-3 font-medium opacity-60">/ {questions.length}</span>
              </div>
            </div>
            <div class="text-left">
              <h2 id="result-title" class="text-white m-0 mb-1 text-[22px]">Résultat</h2>
              <p id="result-score" class="text-[#72C073] text-7 font-bold m-0"></p>
              <p id="result-mult" class="text-[#DFDFDF] text-3 font-medium opacity-50 m-0 mt-1"></p>
            </div>
          </div>

          <!-- Barre de score -->
          <div class="w-full h-2 bg-[#333] rounded-full overflow-hidden">
            <div id="result-bar" class="h-full bg-[#72C073] rounded-full transition-[width] duration-700" style="width:0%"></div>
          </div>

        </div>

        <!-- Boutons -->
        <div class="flex flex-col gap-3">
          <a href={`/jeux_questionaire/jouer?themes=${encodeURIComponent(rawThemes)}&time=${time}`}
            class="h-12 bg-primary-600 text-white text-4 font-medium flex items-center justify-center no-underline hover:opacity-90 transition-opacity rounded-0.5">
            Rejouer
          </a>
          <div class="flex flex-col lg:flex-row gap-3">
            <a href="/jeux_questionaire"
              class="lg:flex-1 h-12 bg-[#2c2c2c] border border-[#3a3a3a] text-white text-4 font-medium flex items-center justify-center no-underline hover:opacity-80 transition-opacity rounded-0.5">
              Changer les paramètres
            </a>
            <a href="/jeux"
              class="lg:flex-1 h-12 bg-transparent border border-[#3a3a3a] text-[#DFDFDF] text-4 font-medium flex items-center justify-center no-underline hover:opacity-80 transition-opacity rounded-0.5">
              Retour aux jeux
            </a>
          </div>
        </div>

      </div>

    </main>
  )}

  <script is:inline define:vars={{ quizQuestions: questions, quizTime: time, quizPbUrl: PB_URL, quizToken: token, quizUserId: userId, quizInSession: inSession }}>
    window.__QUIZ__ = { questions: quizQuestions, time: quizTime, pbUrl: quizPbUrl, token: quizToken, userId: quizUserId, inSession: quizInSession };
  </script>
  <script>
    import '../../js/quiz.js';
  </script>

</Layout>
