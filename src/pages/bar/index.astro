---
import Layout from '../../layouts/Layout.astro';
import PbImage from '../../components/PbImage.astro';
import { getCollection } from '../../js/backend.js';
import heartIcon from '../../assets/icon/heart.svg';

const bars = await getCollection('bar', { sort: 'nom', perPage: 200 });
---

<Layout title="Nos bars — Bargo">

  <!-- ===== HERO ===== -->
  <section class="relative w-full bg-[#094736] h-[280px] lg:h-[450px]">
    <h1 class="absolute top-[60px] left-[20px] lg:top-[141px] lg:left-[74px] text-white uppercase m-0 text-[40px] lg:text-[90px]">
      Nos bars
    </h1>
    <p class="hidden lg:block absolute top-[155px] left-[calc(50%+16px)] w-[547px] text-[#f7f1ed] text-[16px] font-medium leading-[1.4] m-0">
      Explorez les bars de Montbéliard et choisissez les étapes de votre prochaine tournée.
      Créez un parcours sur mesure pour une soirée organisée et conviviale.
    </p>
  </section>

  <!-- ===== GRILLE DES BARS ===== -->
  <section class="w-full bg-[#f7f1ed] pt-8 lg:pt-[53px] pb-12 lg:pb-[120px]">
    <div class="max-w-[1440px] mx-auto px-4 lg:px-20">

      {bars.length === 0 && (
        <p class="text-[#646262] text-[16px] font-medium text-center py-20">
          Aucun bar disponible pour le moment.
        </p>
      )}

      <!-- Mobile: 1 col, Desktop: 3 cols -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-x-[33px] lg:gap-y-[82px]">
        {bars.map(bar => (
          <div class="relative bg-white rounded-[2px] shadow-[0px_7px_4px_0px_rgba(0,0,0,0.25)] overflow-hidden">

            <!-- Image -->
            <div class="w-full h-[200px] lg:h-[300px] overflow-hidden">
              <PbImage record={bar} recordImage={bar.img?.[0]} width={405} height={300} class="w-full h-full object-cover" />
            </div>

            <!-- Contenu -->
            <div class="relative p-4 lg:p-0 lg:h-[232px]">

              <!-- Nom du bar -->
              <h3 class="m-0 text-black truncate lg:absolute lg:top-[20px] lg:left-[19px] lg:right-[41px]">
                {bar.nom}
              </h3>

              <!-- Adresse -->
              <p class="mt-2 lg:mt-0 text-[#646262] text-[16px] font-medium leading-[1.4] m-0 lg:absolute lg:top-[73px] lg:left-[19px] lg:right-[167px]">
                {bar.adresse ?? ''}
              </p>

              <!-- Actions -->
              <div class="mt-4 lg:mt-0 flex items-center gap-3 lg:block">
                <!-- Bouton -->
                <a href={`/bar/${bar.id}`}
                  class="flex-1 lg:flex-none lg:absolute lg:top-[142px] lg:left-[19px] lg:w-[237px] lg:h-[60px] h-[48px] bg-[#1e1e1e] flex items-center justify-center text-white text-[16px] font-medium whitespace-nowrap hover:opacity-80 transition-opacity">
                  Choisir mes bars
                </a>
                <!-- Cœur -->
                <div class="lg:absolute lg:top-[151px] lg:right-[21px] w-[41px] h-[41px] flex items-center justify-center shrink-0">
                  <img src={heartIcon.src} alt="" width="24" height="24" />
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

</Layout>
