---
import Layout from '../../layouts/Layout.astro';
import PbImage from '../../components/PbImage.astro';
import { getCollection } from '../../js/backend.js';
import heartIcon from '../../assets/icon/heart.svg';

const bars = await getCollection('bar', { sort: 'nom', perPage: 200 });
---

<Layout title="Nos bars — Bargo">

  <!-- ===== HERO ===== -->
  <!-- Hauteur 450px = 542px (Figma) - 92px (header fixe) -->
  <section class="relative w-full h-[450px] bg-[#094736]">
    <!-- H1 à top-[141px] = 233px (Figma) - 92px (header) -->
    <h1 class="absolute top-[141px] left-[74px] text-white uppercase m-0">
      Nos bars
    </h1>
    <!-- Description à top-[155px] = 247px (Figma) - 92px (header) -->
    <p class="absolute top-[155px] left-[calc(50%+16px)] w-[547px] text-[#f7f1ed] text-[16px] font-medium leading-[1.4] m-0">
      Explorez les bars de Montbéliard et choisissez les étapes de votre prochaine tournée.
      Créez un parcours sur mesure pour une soirée organisée et conviviale.
    </p>
  </section>

  <!-- ===== GRILLE DES BARS ===== -->
  <!-- pt-[53px] = 503px (début cartes Figma - 92px header) - 450px (hero) -->
  <section class="w-full bg-[#f7f1ed] pt-[53px] pb-[120px]">
    <div class="max-w-[1440px] mx-auto px-20">

      {bars.length === 0 && (
        <p class="text-[#646262] text-[16px] font-medium text-center py-20">
          Aucun bar disponible pour le moment.
        </p>
      )}

      <!-- Grille 3 colonnes — gap-x-[33px] d'après Figma, gap-y-[82px] entre rangées -->
      <div class="grid grid-cols-3 gap-x-[33px] gap-y-[82px]">
        {bars.map(bar => (
          <div class="relative bg-white rounded-[2px] h-[532px] shadow-[0px_7px_4px_0px_rgba(0,0,0,0.25)]">

            <!-- Image : 300px tall = inset-[0_0_43.61%_0] × 532 -->
            <div class="absolute top-0 left-0 right-0 h-[300px] overflow-hidden rounded-tl-[2px] rounded-tr-[2px]">
              <PbImage record={bar} recordImage={bar.img?.[0]} width={405} height={300} class="w-full h-full object-cover" />
            </div>

            <!-- Nom du bar : top-[320px] = 60.15% × 532, left-[19px] = 4.69% × 405 -->
            <h3 class="absolute top-[320px] left-[19px] right-[41px] m-0 text-black">
              {bar.nom}
            </h3>

            <!-- Adresse : top-[373px] = 70.11% × 532 -->
            <p class="absolute top-[373px] left-[19px] right-[167px] text-[#646262] text-[16px] font-medium leading-[1.4] m-0">
              {bar.adresse ?? ''}
            </p>

            <!-- Icône cœur : top-[451px] = 84.77% × 532, right-[21px] = 5.19% × 405 -->
            <div class="absolute top-[451px] right-[21px] w-[41px] h-[41px] flex items-center justify-center">
              <img src={heartIcon.src} alt="" width="24" height="24" />
            </div>

            <!-- Bouton : top-[442px] = 83.08% × 532, left-[19px], w-[237px] h-[60px] -->
            <a href={`/bar/${bar.id}`}
              class="absolute top-[442px] left-[19px] w-[237px] h-[60px] bg-[#1e1e1e] flex items-center justify-center text-white text-[16px] font-medium leading-[1.4] whitespace-nowrap hover:opacity-80 transition-opacity">
              Choisir mes bars
            </a>

          </div>
        ))}
      </div>

    </div>
  </section>

</Layout>
