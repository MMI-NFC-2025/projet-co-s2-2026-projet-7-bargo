---
import Layout from '../layouts/Layout.astro';
import { getUserAuth, updateUser, deleteUser, getCollection, getImageUrl } from '../js/backend.js';
import PbImage from '../components/PbImage.astro';
import heartIcon from '../assets/icon/heart.svg';

// Auth guard
const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

let updateError   = '';
let updateSuccess = false;
let pwdError      = '';
let pwdSuccess    = false;
let emailError    = '';
let emailSuccess  = false;
let activeTab     = Astro.url.searchParams.get('tab') ?? 'profil';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action   = formData.get('_action')?.toString();

  if (action === 'logout') {
    Astro.cookies.delete('pb_token',   { path: '/' });
    Astro.cookies.delete('pb_user_id', { path: '/' });
    return Astro.redirect('/');
  }

  if (action === 'delete') {
    await deleteUser(userId, token);
    Astro.cookies.delete('pb_token',   { path: '/' });
    Astro.cookies.delete('pb_user_id', { path: '/' });
    return Astro.redirect('/');
  }

  if (action === 'edit') {
    const pbData = new FormData();
    for (const field of ['prenom', 'nom', 'pseudo', 'age', 'ville', 'instagram', 'devise']) {
      const val = formData.get(field);
      if (val !== null && val.toString() !== '') pbData.append(field, val.toString());
    }
    const avatarFile = formData.get('avatar');
    if (avatarFile instanceof File && avatarFile.size > 0) pbData.append('avatar', avatarFile, avatarFile.name);
    const result = await updateUser(userId, token, pbData);
    if (result) { updateSuccess = true; } else { updateError = 'Erreur lors de la mise à jour.'; }
    activeTab = 'profil';
  }

  if (action === 'change_password') {
    const oldPwd     = formData.get('old_password')?.toString()     ?? '';
    const newPwd     = formData.get('new_password')?.toString()     ?? '';
    const confirmPwd = formData.get('confirm_password')?.toString() ?? '';
    if (!oldPwd || !newPwd || !confirmPwd) {
      pwdError = 'Tous les champs sont requis.';
    } else if (newPwd !== confirmPwd) {
      pwdError = 'Les mots de passe ne correspondent pas.';
    } else if (newPwd.length < 8) {
      pwdError = 'Le mot de passe doit contenir au moins 8 caractères.';
    } else {
      const pbData = new FormData();
      pbData.append('oldPassword',     oldPwd);
      pbData.append('password',        newPwd);
      pbData.append('passwordConfirm', confirmPwd);
      const result = await updateUser(userId, token, pbData);
      if (result) { pwdSuccess = true; } else { pwdError = 'Mot de passe actuel incorrect.'; }
    }
    activeTab = 'parametres';
  }

  if (action === 'change_email') {
    const newEmail = formData.get('new_email')?.toString().trim() ?? '';
    if (!newEmail || !newEmail.includes('@')) {
      emailError = 'Adresse email invalide.';
    } else {
      const pbData = new FormData();
      pbData.append('email', newEmail);
      const result = await updateUser(userId, token, pbData);
      if (result) { emailSuccess = true; } else { emailError = 'Erreur lors de la mise à jour.'; }
    }
    activeTab = 'parametres';
  }
}

// Données utilisateur
const user = await getUserAuth(userId, token);
if (!user || user.code === 404) {
  Astro.cookies.delete('pb_token',   { path: '/' });
  Astro.cookies.delete('pb_user_id', { path: '/' });
  return Astro.redirect('/connexion');
}

// Notifications
let notifications = [];
try {
  notifications = await getCollection('notifications', {
    filter:  `user = "${userId}"`,
    sort:    '-created',
    perPage: 50
  });
} catch {}

// Bar favori
let barFavori = null;
try {
  const barFavoriId = Array.isArray(user.bar_favori) ? user.bar_favori[0] : user.bar_favori;
  if (barFavoriId) {
    const bars = await getCollection('bar', { filter: `id = "${barFavoriId}"`, perPage: 1 });
    if (bars.length > 0) barFavori = bars[0];
  }
} catch {}

const avatarUrl    = user.avatar ? getImageUrl(user, user.avatar) : null;
const createdAt    = user.created
  ? new Date(user.created).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })
  : '—';
const unreadNotifs = notifications.filter(n => !n.lu).length;

function timeAgo(dateStr) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1)  return "À l'instant";
  if (mins < 60) return `Il y a ${mins} min`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Il y a ${hrs}h`;
  return `Il y a ${Math.floor(hrs / 24)}j`;
}

const displayName = user.prenom
  ? `${user.prenom} ${user.nom ?? ''}`.trim()
  : (user.nom ?? user.pseudo ?? '');
---

<Layout title="Mon profil — Bargo">
  <section class="bg-[#f7f1ed] overflow-x-hidden">

    <!-- ===== MOBILE PROFILE HEADER ===== -->
    <div class="block lg:hidden px-5 pt-8 pb-6">
      <!-- Avatar -->
      <div class="mx-auto w-[100px] h-[100px] rounded-full overflow-hidden" style="border: 8px solid #dfdfdf;">
        {avatarUrl
          ? <img src={avatarUrl} alt="Avatar" class="w-full h-full object-cover" />
          : <div class="w-full h-full bg-[#1e1e1e] flex items-center justify-center">
              <span class="text-white font-bold" style="font-size: 36px;">
                {(user.pseudo ?? user.email ?? '?')[0].toUpperCase()}
              </span>
            </div>
        }
      </div>
      <h2 class="text-black m-0 mt-4 text-center text-[28px]">{displayName}</h2>
      <h3 class="m-0 mt-1 text-[#72c073] text-center">{user.pseudo ?? ''}</h3>
      <p class="m-0 mt-2 text-center text-[#1e1e1e] text-[16px] font-medium">{user.amis ?? 0} ami(e)s</p>
      <div class="mt-3 h-[50px] bg-[#094736] rounded-[5px] flex items-center justify-center gap-4">
        <h3 class="text-white m-0">Points :</h3>
        <h3 class="text-white m-0">{user.points ?? 0}</h3>
      </div>
      {user.devise && (
        <div class="mt-4">
          <p class="m-0 text-[16px] font-medium text-black uppercase">DESCRIPTION</p>
          <p class="m-0 mt-1 text-[#646262] text-[16px] font-medium leading-[1.4]">{user.devise}</p>
        </div>
      )}
    </div>

    <!-- ===== DESKTOP PROFILE HEADER ===== -->
    <div class="hidden lg:block relative" style="height: 420px;">
      <!-- Photo de profil -->
      <div class="absolute left-[80px] top-[119px] size-[187px] rounded-full overflow-hidden z-[2]"
        style="border: 15px solid #dfdfdf;">
        {avatarUrl
          ? <img src={avatarUrl} alt="Avatar" class="w-full h-full object-cover" />
          : <div class="w-full h-full bg-[#1e1e1e] flex items-center justify-center">
              <span class="text-white font-bold" style="font-size: 60px;">
                {(user.pseudo ?? user.email ?? '?')[0].toUpperCase()}
              </span>
            </div>
        }
      </div>
      <!-- Nom -->
      <h2 class="absolute m-0 text-black overflow-hidden text-ellipsis whitespace-nowrap w-[344px]"
        style="left: calc(16.67% + 59px); top: 119px;">
        {displayName}
      </h2>
      <!-- Pseudo -->
      <h3 class="absolute m-0 text-[#72c073]"
        style="left: calc(16.67% + 59px); top: 185px;">
        {user.pseudo ?? ''}
      </h3>
      <!-- Ami(e)s -->
      <p class="absolute m-0 text-[#1e1e1e] text-[16px] font-medium leading-[1.4]"
        style="left: calc(33.33% + 79px); top: 198px;">
        {user.amis ?? 0} ami(e)s
      </p>
      <!-- Points badge -->
      <div class="absolute h-[65px] w-[344px] bg-[#094736] rounded-[5px] shadow-[0px_4px_10px_0px_rgba(0,0,0,0.25)] flex items-center pl-[16px] gap-4"
        style="left: calc(16.67% + 59px); top: 241px;">
        <h3 class="text-white m-0">Points :</h3>
        <h3 class="text-white m-0">{user.points ?? 0}</h3>
      </div>
      <!-- DESCRIPTION label -->
      <p class="absolute m-0 text-[16px] font-medium text-black uppercase leading-[1.4]"
        style="left: calc(50% + 17px); top: 127px;">
        DESCRIPTION
      </p>
      <!-- Description text -->
      <p class="absolute m-0 text-[#646262] text-[16px] font-medium leading-[1.4] w-[623px]"
        style="left: calc(50% + 16px); top: 174px;">
        {user.devise ?? '—'}
      </p>
    </div>

    <!-- Séparateur shadow (desktop only) -->
    <div class="hidden lg:block h-[18px] bg-[#f7f1ed] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)] z-[3]"></div>

    <!-- ===== DEUX COLONNES ===== -->
    <div class="flex flex-col lg:flex-row">

      <!-- SIDEBAR SOMBRE (desktop only) -->
      <div class="hidden lg:block lg:w-[376px] lg:shrink-0 bg-[#1e1e1e]">
        <div class="px-[69px] pt-[16px] flex flex-col gap-[109px]">

          <!-- Boutique -->
          <a href="/boutique"
            class="flex items-center justify-center border-2 border-white text-white text-[16px] font-medium leading-[1.4] h-[60px] w-[237px] hover:bg-white hover:text-[#1e1e1e] transition-colors">
            Boutique
          </a>

          <!-- Amis (affichés si données disponibles) -->
          <div class="flex flex-col gap-[109px]">
            <!-- Placeholder — sera peuplé quand la collection amis sera prête -->
          </div>
        </div>
      </div>

      <!-- CONTENU PRINCIPAL -->
      <div class="flex-1 bg-[#f7f1ed]">

        <!-- BARRE D'ONGLETS BLANCHE -->
        <div class="bg-white flex flex-wrap items-stretch px-4 lg:px-[80px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)] min-h-[64px] lg:h-[100px]">
          <div class="flex items-stretch overflow-x-auto">
            <button data-tab="profil"
              class="tab-btn px-4 lg:px-[25px] text-[14px] lg:text-[16px] font-medium text-black border-b-[7px] border-transparent hover:border-[#dfdfdf] transition-colors cursor-pointer bg-transparent whitespace-nowrap"
              style={activeTab === 'profil' ? 'border-bottom-color: #72c073;' : ''}>
              Mon profil
            </button>
            <button data-tab="notifications"
              class="tab-btn px-4 lg:px-[25px] text-[14px] lg:text-[16px] font-medium text-black border-b-[7px] border-transparent hover:border-[#dfdfdf] transition-colors cursor-pointer bg-transparent inline-flex items-center gap-2 whitespace-nowrap"
              style={activeTab === 'notifications' ? 'border-bottom-color: #72c073;' : ''}>
              Notifications
              {unreadNotifs > 0 && (
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-500 text-white text-[11px] font-bold">{unreadNotifs}</span>
              )}
            </button>
            <button data-tab="parametres"
              class="tab-btn px-4 lg:px-[25px] text-[14px] lg:text-[16px] font-medium text-black border-b-[7px] border-transparent hover:border-[#dfdfdf] transition-colors cursor-pointer bg-transparent whitespace-nowrap"
              style={activeTab === 'parametres' ? 'border-bottom-color: #72c073;' : ''}>
              Paramètres
            </button>
          </div>

          <!-- Editer / Annuler (desktop only) -->
          <button id="edit-btn"
            class="hidden lg:flex ml-auto bg-[#347645] h-[51px] w-[257px] items-center justify-center text-white text-[16px] font-medium hover:opacity-90 transition-opacity cursor-pointer border-0 self-center">
            Editer le profil
          </button>
          <button id="cancel-btn" style="display: none;"
            class="ml-auto border-2 border-[#347645] text-[#347645] h-[51px] w-[257px] flex items-center justify-center text-[16px] font-medium hover:bg-[#347645] hover:text-white transition-colors cursor-pointer bg-transparent self-center">
            Annuler
          </button>
        </div>

        <!-- ============================= -->
        <!-- PANEL : MON PROFIL           -->
        <!-- ============================= -->
        <div id="panel-profil" data-panel class={activeTab !== 'profil' ? 'hidden' : ''}>
          <div class="px-4 lg:px-[80px] pt-8 lg:pt-[45px] pb-16 lg:pb-[120px]">

            {updateSuccess && <p class="text-[#347645] text-sm font-medium mb-6 m-0">Profil mis à jour avec succès.</p>}
            {updateError   && <p class="text-red-500 text-sm font-medium mb-6 m-0">{updateError}</p>}

            <!-- H2 Données du compte + ligne décorative -->
            <div class="flex items-center gap-[30px] mb-[45px]">
              <h2 class="text-black m-0 shrink-0">Données du compte</h2>
              <div class="flex-1 h-[2px] bg-[#dfdfdf]"></div>
            </div>

            <form method="POST" enctype="multipart/form-data" id="profile-form">
              <input type="hidden" name="_action" value="edit" />

              <!-- Box 1 : Informations personnelles -->
              <div class="bg-white border-[3px] border-[#dfdfdf] rounded-[10px] px-4 lg:px-[30px] py-[22px] mb-[18px]">
                <h3 class="text-black m-0 mb-[35px]">Informations personnel</h3>
                <div class="flex flex-col lg:flex-row gap-4 lg:gap-[100px]">
                  <div class="flex flex-col gap-1">
                    <span class="text-[#646262] text-[16px] font-medium leading-[1.4]">Ville</span>
                    <span class="view-field text-black text-[16px] font-medium leading-[1.4]">{user.ville ?? '—'}</span>
                    <input type="text" name="ville" value={user.ville ?? ''} placeholder="Ville"
                      class="edit-field hidden text-[16px] font-medium text-[#1e1e1e] bg-[#f7f1ed] border border-[#dfdfdf] rounded px-3 py-1 outline-none w-[140px]" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-[#646262] text-[16px] font-medium leading-[1.4]">Âge</span>
                    <span class="view-field text-black text-[16px] font-medium leading-[1.4]">{user.age ? `${user.age} ans` : '—'}</span>
                    <input type="number" name="age" value={user.age ?? ''} placeholder="Âge" min="13" max="120"
                      class="edit-field hidden text-[16px] font-medium text-[#1e1e1e] bg-[#f7f1ed] border border-[#dfdfdf] rounded px-3 py-1 outline-none w-[100px]" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-[#646262] text-[16px] font-medium leading-[1.4]">Membre depuis</span>
                    <span class="text-black text-[16px] font-medium leading-[1.4]">{createdAt}</span>
                  </div>
                </div>
              </div>

              <!-- Box 2 : Activité sur Bargo -->
              <div class="bg-white border-[3px] border-[#dfdfdf] rounded-[10px] px-4 lg:px-[30px] py-[22px] mb-[18px]">
                <h3 class="text-black m-0 mb-[35px]">Activité sur Bargo</h3>
                <div class="flex flex-col lg:flex-row gap-4 lg:gap-[100px]">
                  <div class="flex flex-col gap-1">
                    <span class="text-[#646262] text-[16px] font-medium leading-[1.4]">Sorties organisées</span>
                    <span class="text-black text-[16px] font-medium leading-[1.4]">
                      {user.barathon_organiser ? `${user.barathon_organiser} sorties` : '—'}
                    </span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-[#646262] text-[16px] font-medium leading-[1.4]">Barathons réalisés</span>
                    <span class="text-black text-[16px] font-medium leading-[1.4]">
                      {user.barathon_participer ? `${user.barathon_participer} parcours` : '—'}
                    </span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-[#646262] text-[16px] font-medium leading-[1.4]">Bars découverts</span>
                    <span class="text-black text-[16px] font-medium leading-[1.4]">—</span>
                  </div>
                </div>
              </div>

              <!-- Box 3 : Réseaux sociaux -->
              <div class="bg-white border-[3px] border-[#dfdfdf] rounded-[10px] px-4 lg:px-[30px] py-[22px]">
                <h3 class="text-black m-0 mb-[35px]">Réseaux sociaux</h3>
                <div class="flex gap-[100px]">
                  <div class="flex flex-col gap-1">
                    <span class="text-[#646262] text-[16px] font-medium leading-[1.4]">Instagram</span>
                    <span class="view-field text-black text-[16px] font-medium leading-[1.4]">{user.instagram ?? '—'}</span>
                    <input type="text" name="instagram" value={user.instagram ?? ''} placeholder="@pseudo"
                      class="edit-field hidden text-[16px] font-medium text-[#1e1e1e] bg-[#f7f1ed] border border-[#dfdfdf] rounded px-3 py-1 outline-none w-[160px]" />
                  </div>
                </div>
              </div>

              <!-- Champs édition étendus (nom, prénom, pseudo, description, avatar) -->
              <div class="edit-field hidden mt-[30px]"><div class="flex flex-col gap-5">
                <div class="flex gap-6 flex-wrap">
                  <div class="flex flex-col gap-1">
                    <label class="text-[16px] font-medium text-black">Prénom</label>
                    <input type="text" name="prenom" value={user.prenom ?? ''} placeholder="Prénom"
                      class="text-[16px] font-medium text-[#1e1e1e] bg-[#f7f1ed] border border-[#dfdfdf] rounded px-3 py-2 outline-none w-[200px]" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <label class="text-[16px] font-medium text-black">Nom</label>
                    <input type="text" name="nom" value={user.nom ?? ''} placeholder="Nom"
                      class="text-[16px] font-medium text-[#1e1e1e] bg-[#f7f1ed] border border-[#dfdfdf] rounded px-3 py-2 outline-none w-[200px]" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <label class="text-[16px] font-medium text-black">Pseudo</label>
                    <input type="text" name="pseudo" value={user.pseudo ?? ''} placeholder="Pseudo"
                      class="text-[16px] font-medium text-[#1e1e1e] bg-[#f7f1ed] border border-[#dfdfdf] rounded px-3 py-2 outline-none w-[200px]" />
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-[16px] font-medium text-black">Description</label>
                  <textarea name="devise" placeholder="Votre description..."
                    class="text-[16px] font-medium text-[#1e1e1e] bg-[#f7f1ed] border border-[#dfdfdf] rounded px-3 py-2 outline-none resize-none w-full max-w-[600px] h-[100px]">{user.devise ?? ''}</textarea>
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-[16px] font-medium text-black">Photo de profil</label>
                  <input type="file" name="avatar" accept="image/*"
                    class="text-sm text-[#646262] file:mr-4 file:py-2 file:px-4 file:border-0 file:bg-[#347645] file:text-white file:cursor-pointer cursor-pointer" />
                </div>
                <button type="submit"
                  class="inline-flex items-center gap-4 bg-[#094736] text-white text-[16px] font-medium leading-[1.4] px-[50px] py-[8px] hover:opacity-90 transition-opacity cursor-pointer border-0 w-fit">
                  Sauvegarder
                </button>
              </div></div>
            </form>

            <!-- H2 Favoris + ligne décorative -->
            <div class="flex items-center gap-[30px] mt-[80px] mb-[56px]">
              <h2 class="text-black m-0 shrink-0">Favoris</h2>
              <div class="flex-1 h-[2px] bg-[#dfdfdf]"></div>
            </div>

            <!-- Grille favoris -->
            {barFavori ? (
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-[33px]">
                <div class="relative bg-white rounded-[2px] h-[351px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)]">
                  <div class="absolute top-0 left-0 right-0 h-[200px] overflow-hidden rounded-tl-[2px] rounded-tr-[2px]">
                    <PbImage record={barFavori} recordImage={barFavori.img?.[0]} width={280} height={200} class="w-full h-full object-cover" />
                  </div>
                  <h3 class="absolute top-[210px] left-[19px] right-[19px] m-0 text-black">{barFavori.nom}</h3>
                  <div class="absolute bottom-[21px] right-[21px] w-[24px] h-[24px] flex items-center justify-center">
                    <img src={heartIcon.src} alt="" width="24" height="24" />
                  </div>
                  <a href={`/bar/${barFavori.id}`}
                    class="absolute bottom-[21px] left-[19px] w-[150px] h-[44px] bg-[#1e1e1e] flex items-center justify-center text-white text-[16px] font-medium hover:opacity-80 transition-opacity">
                    En savoir plus
                  </a>
                </div>
              </div>
            ) : (
              <p class="text-[#646262] text-[16px] font-medium m-0">Aucun favori pour l'instant.</p>
            )}

          </div>
        </div>

        <!-- ============================= -->
        <!-- PANEL : NOTIFICATIONS        -->
        <!-- ============================= -->
        <div id="panel-notifications" data-panel class={activeTab !== 'notifications' ? 'hidden' : ''}>
          <div class="px-4 lg:px-[80px] pt-8 lg:pt-[45px] pb-16 lg:pb-[120px]">

            <div class="flex items-center gap-[30px] mb-[45px]">
              <h2 class="text-black m-0 shrink-0">Notifications</h2>
              <div class="flex-1 h-[2px] bg-[#dfdfdf]"></div>
            </div>

            {notifications.length > 0 ? (
              <div class="flex flex-col gap-3">
                {notifications.map(notif => (
                  <div class={`flex items-start gap-4 p-5 bg-white rounded-[10px] border-[3px] ${!notif.lu ? 'border-[#72c073]' : 'border-[#dfdfdf]'}`}>
                    <div class={`w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${notif.type === 'success' ? 'bg-[#72c073]' : 'bg-[#347645]'}`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                    <div class="flex-1">
                      <p class={`text-[16px] m-0 leading-[1.4] ${!notif.lu ? 'font-bold' : 'font-medium'} text-black`}>
                        {notif.message ?? notif.texte ?? notif.contenu ?? 'Notification'}
                      </p>
                      <p class="text-sm text-[#646262] m-0 mt-1">{timeAgo(notif.created)}</p>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="flex flex-col items-center justify-center py-24">
                <div class="w-20 h-20 rounded-full bg-[#dfdfdf] flex items-center justify-center mb-6">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="#646262" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="#646262" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <p class="text-[#646262] text-[16px] font-medium m-0">Aucune notification</p>
                <p class="text-sm text-[#646262] m-0 mt-2">Vous êtes à jour !</p>
              </div>
            )}
          </div>
        </div>

        <!-- ============================= -->
        <!-- PANEL : PARAMÈTRES           -->
        <!-- ============================= -->
        <div id="panel-parametres" data-panel class={activeTab !== 'parametres' ? 'hidden' : ''}>
          <div class="px-4 lg:px-[80px] pt-8 lg:pt-[45px] pb-16 lg:pb-[120px]">

            <div class="flex items-center gap-[30px] mb-[45px]">
              <h2 class="text-black m-0 shrink-0">Paramètres</h2>
              <div class="flex-1 h-[2px] bg-[#dfdfdf]"></div>
            </div>

            <!-- Email -->
            <h3 class="text-black m-0 mb-5">Email</h3>
            <div class="bg-white border-[3px] border-[#dfdfdf] rounded-[10px] px-[30px] py-[22px] mb-8">
              <div class="flex items-center border-b-2 border-[#dfdfdf] pb-4 mb-5">
                <span class="text-[16px] font-medium text-black w-[160px] shrink-0">Email actuel</span>
                <span class="text-[16px] font-medium text-[#646262]">{user.email ?? '—'}</span>
              </div>
              {emailSuccess && <p class="text-[#347645] text-sm font-medium mb-4 m-0">Email mis à jour.</p>}
              {emailError   && <p class="text-red-500 text-sm font-medium mb-4 m-0">{emailError}</p>}
              <form method="POST" enctype="application/x-www-form-urlencoded" class="flex flex-col lg:flex-row lg:items-end gap-4">
                <input type="hidden" name="_action" value="change_email" />
                <div class="flex-1">
                  <label class="block text-[16px] font-medium text-black mb-2">Nouvel email</label>
                  <input type="email" name="new_email" placeholder="nouveau@email.com"
                    class="w-full text-[16px] font-medium bg-[#f7f1ed] border-2 border-[#dfdfdf] rounded px-4 py-2 outline-none" />
                </div>
                <button type="submit"
                  class="bg-[#347645] text-white text-[16px] font-medium px-8 py-[9px] hover:opacity-90 transition-opacity cursor-pointer border-0 rounded shrink-0">
                  Modifier
                </button>
              </form>
            </div>

            <!-- Mot de passe -->
            <h3 class="text-black m-0 mb-5">Sécurité</h3>
            <div class="bg-white border-[3px] border-[#dfdfdf] rounded-[10px] px-[30px] py-[22px] mb-8">
              {pwdSuccess && <p class="text-[#347645] text-sm font-medium mb-4 m-0">Mot de passe modifié.</p>}
              {pwdError   && <p class="text-red-500 text-sm font-medium mb-4 m-0">{pwdError}</p>}
              <form method="POST" enctype="application/x-www-form-urlencoded" class="flex flex-col gap-5">
                <input type="hidden" name="_action" value="change_password" />
                <div>
                  <label class="block text-[16px] font-medium text-black mb-2">Mot de passe actuel</label>
                  <input type="password" name="old_password" placeholder="••••••••"
                    class="w-full max-w-[400px] text-[16px] font-medium bg-[#f7f1ed] border-2 border-[#dfdfdf] rounded px-4 py-2 outline-none" />
                </div>
                <div class="flex gap-4">
                  <div class="flex-1">
                    <label class="block text-[16px] font-medium text-black mb-2">Nouveau mot de passe</label>
                    <input type="password" name="new_password" placeholder="••••••••"
                      class="w-full text-[16px] font-medium bg-[#f7f1ed] border-2 border-[#dfdfdf] rounded px-4 py-2 outline-none" />
                  </div>
                  <div class="flex-1">
                    <label class="block text-[16px] font-medium text-black mb-2">Confirmer</label>
                    <input type="password" name="confirm_password" placeholder="••••••••"
                      class="w-full text-[16px] font-medium bg-[#f7f1ed] border-2 border-[#dfdfdf] rounded px-4 py-2 outline-none" />
                  </div>
                </div>
                <button type="submit"
                  class="inline-flex items-center gap-3 bg-[#094736] text-white text-[16px] font-medium px-8 py-[9px] hover:opacity-90 transition-opacity cursor-pointer border-0 rounded w-fit">
                  Changer le mot de passe
                </button>
              </form>
            </div>

            <!-- Session -->
            <h3 class="text-black m-0 mb-5">Session</h3>
            <div class="bg-white border-[3px] border-[#dfdfdf] rounded-[10px] px-[30px] py-[22px] mb-8">
              <p class="text-[16px] font-medium text-black m-0 mb-4">
                Connecté en tant que <span class="text-[#72c073]">{user.pseudo ?? user.email}</span>
              </p>
              <form method="POST" enctype="application/x-www-form-urlencoded">
                <input type="hidden" name="_action" value="logout" />
                <button type="submit"
                  class="inline-flex items-center gap-3 border-2 border-[#1e1e1e] text-[#1e1e1e] text-[16px] font-medium px-8 py-[9px] hover:bg-[#1e1e1e] hover:text-white transition-colors cursor-pointer bg-transparent rounded">
                  Se déconnecter
                </button>
              </form>
            </div>

            <!-- Zone dangereuse -->
            <h3 class="text-black m-0 mb-5">Zone dangereuse</h3>
            <div class="bg-white rounded-[10px] px-[30px] py-[22px]" style="border: 3px solid #fecaca;">
              <div class="flex items-center justify-between gap-8">
                <div>
                  <p class="text-[16px] font-medium text-black m-0">Supprimer mon compte</p>
                  <p class="text-sm text-[#646262] m-0 mt-1">Action irréversible. Toutes vos données seront supprimées définitivement.</p>
                </div>
                <form method="POST" enctype="application/x-www-form-urlencoded" id="delete-form" class="shrink-0">
                  <input type="hidden" name="_action" value="delete" />
                  <button type="button" id="delete-btn"
                    class="inline-flex items-center gap-2 border-2 border-red-500 text-red-500 text-[16px] font-medium px-6 py-[9px] hover:bg-red-500 hover:text-white transition-colors cursor-pointer bg-transparent rounded">
                    Supprimer
                  </button>
                </form>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

  </section>

  <script>
    import '../js/profil.js';
  </script>
</Layout>
