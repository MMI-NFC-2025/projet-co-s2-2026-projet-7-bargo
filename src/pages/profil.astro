      <div class="absolute top-[1250px] left-[calc(66.67%-3px)] w-[57px] h-[57px] flex items-center justify-center z-[4] pointer-events-none">
        <img src={chevronIcon.src} alt="" width="24" height="24" />
      </div>
      <span class="view-field absolute top-[1263px] left-[calc(33.33%+65px)] text-[16px] font-medium text-[#1e1e1e] z-[3] leading-[1.4]">{barFavoriNom || '—'}</span>
      <select name="bar_favori"
        class="edit-field hidden absolute top-[1250px] left-[calc(33.33%+37px)] w-[515px] h-[57px] bg-transparent text-[16px] font-medium text-[#1e1e1e] px-6 outline-none cursor-pointer appearance-none z-[3]">
        <option value="">— Choisir un bar —</option>
        {bars.map(b => <option value={b.id} selected={b.id === barFavoriId}>{b.nom}</option>)}
      </select>

      <!-- BOISSON FAVORITE -->
      <p class="absolute top-[1331px] left-[calc(33.33%+37px)] text-[16px] font-medium text-black m-0 z-[2] leading-[1.4]">Boisson favorite</p>
      <div class="absolute top-[1370px] left-[calc(33.33%+37px)] w-[515px] h-[57px] bg-[#f7f1ed] rounded-[5px] z-[2] cursor-pointer"
        style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);" onclick="openSelect('boisson_favori')"></div>
      <div class="absolute top-[1370px] left-[calc(66.67%-3px)] w-[57px] h-[57px] flex items-center justify-center z-[4] pointer-events-none">
        <img src={chevronIcon.src} alt="" width="24" height="24" />
      </div>
      <span class="view-field absolute top-[1383px] left-[calc(33.33%+61px)] text-[16px] font-medium text-[#1e1e1e] z-[3] leading-[1.4]">{boissonFavoriNom || '—'}</span>
      <select name="boisson_favori"
        class="edit-field hidden absolute top-[1370px] left-[calc(33.33%+37px)] w-[515px] h-[57px] bg-transparent text-[16px] font-medium text-[#1e1e1e] px-6 outline-none cursor-pointer appearance-none z-[3]">
        <option value="">— Choisir une boisson —</option>
        {boissons.map(b => <option value={b.id} selected={b.id === boissonFavoriId}>{b.nom}</option>)}
      </select>

      <!-- PRÉFÉRENCE HORAIRE -->
      <p class="absolute top-[1448px] left-[calc(33.33%+37px)] text-[16px] font-medium text-black m-0 z-[2] leading-[1.4]">Préférence horaire</p>
      <!-- Box début -->
      <div class="absolute top-[1487px] left-[calc(33.33%+37px)] w-[219px] h-[57px] bg-[#f7f1ed] rounded-[5px] z-[2] cursor-pointer"
        style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);" onclick="openSelect('preference_horaire_debut')"></div>
      <div class="absolute top-[1487px] left-[calc(41.67%+63px)] w-[57px] h-[57px] flex items-center justify-center z-[4] pointer-events-none">
        <img src={chevronIcon.src} alt="" width="24" height="24" />
      </div>
      <!-- Tiret -->
      <div class="absolute top-[1516px] left-[calc(50%+34px)] w-[45px] border-t-2 border-[#1e1e1e] z-[2]"></div>
      <!-- Box fin -->
      <div class="absolute top-[1487px] left-[calc(58.33%-27px)] w-[219px] h-[57px] bg-[#f7f1ed] rounded-[5px] z-[2] cursor-pointer"
        style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);" onclick="openSelect('preference_horaire_fin')"></div>
      <div class="absolute top-[1487px] left-[calc(66.67%-1px)] w-[57px] h-[57px] flex items-center justify-center z-[4] pointer-events-none">
        <img src={chevronIcon.src} alt="" width="24" height="24" />
      </div>
      <span class="view-field absolute top-[1500px] left-[calc(33.33%+61px)] text-[16px] font-medium text-[#1e1e1e] z-[3] leading-[1.4]">{prefDebut || 'Lundi'}</span>
      <span class="view-field absolute top-[1500px] left-[calc(58.33%-3px)] text-[16px] font-medium text-[#1e1e1e] z-[3] leading-[1.4]">{prefFin || 'Vendredi'}</span>
      <select name="preference_horaire_debut"
        class="edit-field hidden absolute top-[1487px] left-[calc(33.33%+37px)] w-[219px] h-[57px] bg-transparent text-[16px] font-medium text-[#1e1e1e] px-4 outline-none cursor-pointer appearance-none z-[3]">
        {jours.map(j => <option value={j} selected={j === prefDebut}>{j}</option>)}
      </select>
      <select name="preference_horaire_fin"
        class="edit-field hidden absolute top-[1487px] left-[calc(58.33%-27px)] w-[219px] h-[57px] bg-transparent text-[16px] font-medium text-[#1e1e1e] px-4 outline-none cursor-pointer appearance-none z-[3]">
        {jours.map(j => <option value={j} selected={j === prefFin}>{j}</option>)}
      </select>

      <!-- FOND CARTE STATS -->
      <div class="absolute top-[1581px] left-[calc(33.33%+37px)] w-[515px] h-[162px] bg-[#f7f1ed] rounded-[5px] z-[2]"
        style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);"></div>
      <div class="absolute top-[1605px] left-[calc(33.33%+46px)] w-[488px] h-[37px] border-b-2 border-[#e7e5e5] z-[3]"></div>
      <div class="absolute top-[1651px] left-[calc(33.33%+46px)] w-[488px] h-[37px] border-b-2 border-[#e7e5e5] z-[3]"></div>
      <p class="absolute top-[1605px] left-[calc(33.33%+46px)] text-[16px] font-medium text-black m-0 z-[4] leading-[1.4]">Actif depuis</p>
      <p class="absolute top-[1651px] left-[calc(33.33%+46px)] text-[16px] font-medium text-black m-0 z-[4] leading-[1.4]">barathons participés</p>
      <p class="absolute top-[1697px] left-[calc(33.33%+46px)] text-[16px] font-medium text-black m-0 z-[4] leading-[1.4]">organisés</p>
      <p class="absolute top-[1605px] left-[calc(50%+294px)] -translate-x-full text-[16px] font-medium text-[#646262] m-0 z-[4] leading-[1.4] whitespace-nowrap">{createdAt}</p>
      <p class="absolute top-[1651px] left-[calc(50%+294px)] -translate-x-full text-[16px] font-medium text-[#646262] m-0 z-[4] leading-[1.4] whitespace-nowrap">{user.barathon_participer ?? 0}</p>
      <p class="absolute top-[1697px] left-[calc(50%+294px)] -translate-x-full text-[16px] font-medium text-[#646262] m-0 z-[4] leading-[1.4] whitespace-nowrap">{user.barathon_organiser ?? 0}</p>

      <!-- UPLOADS (mode édition) -->
      <div class="edit-field hidden absolute top-[1760px] left-[calc(33.33%+37px)] z-[2]">
        <p class="text-[16px] font-medium text-black m-0 mb-3">Photo de profil</p>
        <input type="file" name="avatar"  accept="image/*"
          class="text-sm text-[#646262] file:mr-4 file:py-2 file:px-4 file:border-0 file:bg-[#347645] file:text-white file:cursor-pointer cursor-pointer mb-4 block" />
        <p class="text-[16px] font-medium text-black m-0 mb-3 mt-4">Bannière</p>
        <input type="file" name="baniere" accept="image/*"
          class="text-sm text-[#646262] file:mr-4 file:py-2 file:px-4 file:border-0 file:bg-[#347645] file:text-white file:cursor-pointer cursor-pointer block" />
      </div>

      <!-- BOUTON SAUVEGARDER (mode édition) -->
      <div class="edit-field hidden absolute top-[1819px] left-[calc(33.33%+37px)] z-[2]">
        <button type="submit"
          class="inline-flex items-center gap-4 bg-[#094736] text-white text-[16px] font-medium leading-[1.4] px-[50px] py-[8px] hover:opacity-90 transition-opacity cursor-pointer border-0">
          Sauvegarder les modifications
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </form>

    <!-- BOUTON ÉDITER (mode vue) -->
    <button id="edit-btn" onclick="toggleEdit()"
      class="absolute top-[1819px] left-[calc(33.33%+37px)] inline-flex items-center gap-4 bg-[#347645] text-white text-[16px] font-medium leading-[1.4] px-[50px] py-[8px] hover:opacity-90 transition-opacity cursor-pointer border-0 z-[2]">
      Editer le profil
      <svg width="35" height="35" viewBox="0 0 35 35" fill="none">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M7.29167 17.5C7.29167 17.016 7.68401 16.6237 8.16667 16.6237H23.8905L18.3959 11.1291C18.0472 10.7803 18.0472 10.2155 18.3959 9.86675C18.7447 9.51797 19.3095 9.51797 19.6582 9.86675L25.7749 15.9834C26.5251 16.7336 26.5251 17.9581 25.7749 18.7083L19.6582 24.825C19.3095 25.1737 18.7447 25.1737 18.3959 24.825C18.0472 24.4762 18.0472 23.9114 18.3959 23.5626L23.8905 18.0763H8.16667C7.68401 18.0763 7.29167 17.6839 7.29167 17.5Z" fill="white"/>
      </svg>
    </button>

    <!-- BOUTON ANNULER (mode édition) -->
    <button id="cancel-btn" onclick="toggleEdit()"
      class="hidden absolute top-[1819px] left-[calc(33.33%+37px)] items-center gap-4 border-2 border-[#347645] text-[#347645] text-[16px] font-medium leading-[1.4] px-[50px] py-[8px] hover:bg-[#347645] hover:text-white transition-colors cursor-pointer bg-transparent z-[2]">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Annuler les modifications
    </button>

  </div><!-- /panel-apropos -->

  <!-- ================================================================ -->
  <!-- PANEL : NOTIFICATIONS                                             -->
  <!-- ================================================================ -->
  <div id="panel-notifications" data-panel class={activeTab !== 'notifications' ? 'hidden' : ''}>
    <div class="absolute top-[914px] left-[calc(33.33%+37px)] w-[843px] z-[2]">

      <!-- En-tête -->
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-black m-0">Notifications</h3>
        {unreadNotifs > 0 && (
          <span class="text-sm text-[#646262] font-medium">{unreadNotifs} non lue{unreadNotifs > 1 ? 's' : ''}</span>
        )}
      </div>

      {notifications.length > 0 ? (
        <div class="flex flex-col gap-3">
          {notifications.map(notif => (
            <div class={`relative flex items-start gap-4 p-5 rounded-[5px] bg-[#f7f1ed] ${!notif.lu ? 'border-l-[5px] border-[#72c073]' : ''}`}
              style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);">
              <!-- Icône -->
              <div class={`w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${notif.type === 'success' ? 'bg-[#72c073]' : notif.type === 'warning' ? 'bg-amber-400' : 'bg-[#347645]'}`}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <!-- Contenu -->
              <div class="flex-1 min-w-0">
                <p class={`text-[16px] m-0 leading-[1.4] ${!notif.lu ? 'font-bold text-black' : 'font-medium text-black'}`}>
                  {notif.message ?? notif.texte ?? notif.contenu ?? 'Notification'}
                </p>
                <p class="text-sm text-[#646262] m-0 mt-1">{timeAgo(notif.created)}</p>
              </div>
              <!-- Point non lu -->
              {!notif.lu && (
                <div class="absolute top-4 right-4 w-2 h-2 rounded-full bg-[#72c073]"></div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <!-- État vide -->
        <div class="flex flex-col items-center justify-center py-24">
          <div class="w-20 h-20 rounded-full bg-[#dfdfdf] flex items-center justify-center mb-6">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="#646262" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="#646262" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <p class="text-[#646262] text-[16px] font-medium m-0">Aucune notification</p>
          <p class="text-sm text-[#9e9a97] m-0 mt-2">Vous êtes à jour !</p>
        </div>
      )}
    </div>
  </div><!-- /panel-notifications -->

  <!-- ================================================================ -->
  <!-- PANEL : MESSAGES                                                  -->
  <!-- ================================================================ -->
  <div id="panel-messages" data-panel class={activeTab !== 'messages' ? 'hidden' : ''}>
    <div class="absolute top-[914px] left-[calc(33.33%+37px)] w-[843px] z-[2]">

      <!-- En-tête -->
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-black m-0">Messages</h3>
        {unreadMessages > 0 && (
          <span class="text-sm text-[#646262] font-medium">{unreadMessages} non lu{unreadMessages > 1 ? 's' : ''}</span>
        )}
      </div>

      {messages.length > 0 ? (
        <div class="flex flex-col gap-3">
          {messages.map(msg => {
            const isExpedie  = msg.expediteur === userId || msg.from_user === userId;
            const otherUser  = isExpedie
              ? (msg.expand?.destinataire ?? msg.expand?.to_user   ?? null)
              : (msg.expand?.expediteur   ?? msg.expand?.from_user ?? null);
            const otherName  = otherUser?.pseudo ?? otherUser?.prenom ?? otherUser?.email ?? 'Utilisateur';
            const initiale   = otherName[0]?.toUpperCase() ?? '?';
            const isUnread   = !msg.lu && !isExpedie;
            const otherAvatar = otherUser?.avatar ? getImageUrl(otherUser, otherUser.avatar) : null;
            return (
              <div class={`relative flex items-center gap-4 p-5 rounded-[5px] bg-[#f7f1ed] cursor-pointer hover:opacity-90 transition-opacity ${isUnread ? 'border-l-[5px] border-[#72c073]' : ''}`}
                style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);">
                <!-- Avatar -->
                <div class="w-12 h-12 rounded-full overflow-hidden shrink-0 bg-[#1e1e1e] flex items-center justify-center">
                  {otherAvatar
                    ? <img src={otherAvatar} alt={otherName} class="w-full h-full object-cover" />
                    : <span class="text-white text-xl font-bold">{initiale}</span>
                  }
                </div>
                <!-- Contenu -->
                <div class="flex-1 min-w-0">
                  <p class={`text-[16px] m-0 leading-[1.4] ${isUnread ? 'font-bold text-black' : 'font-medium text-black'}`}>
                    {otherName}
                  </p>
                  <p class="text-sm text-[#646262] m-0 mt-1 truncate">
                    {isExpedie ? 'Vous : ' : ''}{msg.contenu ?? msg.texte ?? msg.message ?? msg.content ?? ''}
                  </p>
                </div>
                <!-- Heure + point non lu -->
                <div class="flex flex-col items-end gap-2 shrink-0">
                  <span class="text-sm text-[#646262]">{timeAgo(msg.created)}</span>
                  {isUnread && <div class="w-2 h-2 rounded-full bg-[#72c073]"></div>}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <!-- État vide -->
        <div class="flex flex-col items-center justify-center py-24">
          <div class="w-20 h-20 rounded-full bg-[#dfdfdf] flex items-center justify-center mb-6">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="#646262" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <p class="text-[#646262] text-[16px] font-medium m-0">Aucun message</p>
          <p class="text-sm text-[#9e9a97] m-0 mt-2">Vos conversations apparaîtront ici</p>
        </div>
      )}
    </div>
  </div><!-- /panel-messages -->

  <!-- ================================================================ -->
  <!-- PANEL : PARAMÈTRES                                                -->
  <!-- ================================================================ -->
  <div id="panel-parametres" data-panel class={activeTab !== 'parametres' ? 'hidden' : ''}>
    <div class="absolute top-[914px] left-[calc(33.33%+37px)] w-[843px] z-[2]">

      <!-- Section : Informations du compte -->
      <h3 class="text-black m-0 mb-5">Informations du compte</h3>
      <div class="bg-[#f7f1ed] rounded-[5px] p-6 mb-8" style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);">
        <!-- Email actuel -->
        <div class="flex items-center border-b-2 border-[#e7e5e5] pb-4 mb-5">
          <span class="text-[16px] font-medium text-black w-[160px] shrink-0">Email actuel</span>
          <span class="text-[16px] font-medium text-[#646262]">{user.email ?? '—'}</span>
        </div>
        {emailSuccess && (
          <p class="text-[#347645] text-sm font-medium mb-4 m-0">Email mis à jour avec succès.</p>
        )}
        {emailError && (
          <p class="text-red-500 text-sm font-medium mb-4 m-0">{emailError}</p>
        )}
        <form method="POST" enctype="application/x-www-form-urlencoded" class="flex items-end gap-4">
          <input type="hidden" name="_action" value="change_email" />
          <div class="flex-1">
            <label class="block text-[16px] font-medium text-black mb-2">Nouvel email</label>
            <input type="email" name="new_email" placeholder="nouveau@email.com"
              class="w-full text-[16px] font-medium text-[#1e1e1e] bg-white border-2 border-[#dfdfdf] rounded-[5px] px-4 py-2 outline-none focus:border-[#72c073] transition-colors placeholder-[#9e9a97]" />
          </div>
          <button type="submit"
            class="inline-flex items-center gap-2 bg-[#347645] text-white text-[16px] font-medium px-8 py-[9px] hover:opacity-90 transition-opacity cursor-pointer border-0 rounded-[5px] shrink-0">
            Modifier
          </button>
        </form>
      </div>

      <!-- Section : Sécurité -->
      <h3 class="text-black m-0 mb-5">Sécurité</h3>
      <div class="bg-[#f7f1ed] rounded-[5px] p-6 mb-8" style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);">
        {pwdSuccess && (
          <p class="text-[#347645] text-sm font-medium mb-4 m-0">Mot de passe modifié avec succès.</p>
        )}
        {pwdError && (
          <p class="text-red-500 text-sm font-medium mb-4 m-0">{pwdError}</p>
        )}
        <form method="POST" enctype="application/x-www-form-urlencoded" class="flex flex-col gap-5">
          <input type="hidden" name="_action" value="change_password" />
          <div>
            <label class="block text-[16px] font-medium text-black mb-2">Mot de passe actuel</label>
            <input type="password" name="old_password" placeholder="••••••••"
              class="w-full max-w-[500px] text-[16px] font-medium text-[#1e1e1e] bg-white border-2 border-[#dfdfdf] rounded-[5px] px-4 py-2 outline-none focus:border-[#72c073] transition-colors" />
          </div>
          <div class="flex gap-4">
            <div class="flex-1">
              <label class="block text-[16px] font-medium text-black mb-2">Nouveau mot de passe</label>
              <input type="password" name="new_password" placeholder="••••••••"
                class="w-full text-[16px] font-medium text-[#1e1e1e] bg-white border-2 border-[#dfdfdf] rounded-[5px] px-4 py-2 outline-none focus:border-[#72c073] transition-colors" />
            </div>
            <div class="flex-1">
              <label class="block text-[16px] font-medium text-black mb-2">Confirmer</label>
              <input type="password" name="confirm_password" placeholder="••••••••"
                class="w-full text-[16px] font-medium text-[#1e1e1e] bg-white border-2 border-[#dfdfdf] rounded-[5px] px-4 py-2 outline-none focus:border-[#72c073] transition-colors" />
            </div>
          </div>
          <div>
            <button type="submit"
              class="inline-flex items-center gap-3 bg-[#094736] text-white text-[16px] font-medium px-8 py-[9px] hover:opacity-90 transition-opacity cursor-pointer border-0 rounded-[5px]">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="11" width="18" height="11" rx="2" stroke="white" stroke-width="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="white" stroke-width="2" stroke-linecap="round"/>
              </svg>
              Changer le mot de passe
            </button>
          </div>
        </form>
      </div>

      <!-- Zone dangereuse -->
      <h3 class="text-black m-0 mb-5">Zone dangereuse</h3>
      <div class="bg-[#f7f1ed] rounded-[5px] p-6" style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25); border: 1px solid #fecaca;">
        <div class="flex items-center justify-between gap-8">
          <div>
            <p class="text-[16px] font-medium text-black m-0">Supprimer mon compte</p>
            <p class="text-sm text-[#646262] m-0 mt-1">
              Cette action est irréversible. Toutes vos données seront supprimées définitivement.
            </p>
          </div>
          <form method="POST" enctype="application/x-www-form-urlencoded" id="delete-form" class="shrink-0">
            <input type="hidden" name="_action" value="delete" />
            <button type="button" onclick="confirmDelete()"
              class="inline-flex items-center gap-2 border-2 border-red-500 text-red-500 text-[16px] font-medium px-6 py-[9px] hover:bg-red-500 hover:text-white transition-colors cursor-pointer bg-transparent rounded-[5px]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              Supprimer
            </button>
          </form>
        </div>
      </div>

    </div>
  </div><!-- /panel-parametres -->

</div>
</Layout>

<script is:inline>
// ───── Configuration des onglets ─────
const tabConfig = {
  apropos:       { left: 'calc(33.33% + 37px)', width: '126px' },
  notifications: { left: 'calc(41.67% + 65px)', width: '170px' },
  messages:      { left: 'calc(58.33% + 32px)', width: '139px' },
  parametres:    { left: 'calc(75% - 56px)',     width: '140px' }
};

function switchTab(name) {
  document.querySelectorAll('[data-panel]').forEach(p => p.classList.add('hidden'));
  document.getElementById('panel-' + name)?.classList.remove('hidden');

  document.querySelectorAll('[data-tab]').forEach(t => { t.style.color = ''; });
  const activeEl = document.querySelector('[data-tab="' + name + '"]');
  if (activeEl) activeEl.style.color = '#72c073';

  const underline = document.getElementById('tab-underline');
  const cfg = tabConfig[name];
  if (underline && cfg) {
    underline.style.left  = cfg.left;
    underline.style.width = cfg.width;
  }

  // Si on quitte A propos en mode édition → reset
  if (name !== 'apropos') {
    const editBtn   = document.getElementById('edit-btn');
    const cancelBtn = document.getElementById('cancel-btn');
    if (cancelBtn && !cancelBtn.classList.contains('hidden')) {
      document.querySelectorAll('.view-field').forEach(el => el.classList.remove('hidden'));
      document.querySelectorAll('.edit-field').forEach(el => el.classList.add('hidden'));
      if (editBtn) editBtn.classList.remove('hidden');
      cancelBtn.classList.add('hidden');
      cancelBtn.style.display = '';
    }
  }
}

// ───── Toggle édition profil ─────
function toggleEdit() {
  const viewFields = document.querySelectorAll('.view-field');
  const editFields = document.querySelectorAll('.edit-field');
  const editBtn    = document.getElementById('edit-btn');
  const cancelBtn  = document.getElementById('cancel-btn');
  if (!editBtn || !cancelBtn) return;

  const isViewMode = !editBtn.classList.contains('hidden');

  if (isViewMode) {
    viewFields.forEach(el => el.classList.add('hidden'));
    editFields.forEach(el => el.classList.remove('hidden'));
    editBtn.classList.add('hidden');
    cancelBtn.classList.remove('hidden');
    cancelBtn.style.display = 'inline-flex';
  } else {
    viewFields.forEach(el => el.classList.remove('hidden'));
    editFields.forEach(el => el.classList.add('hidden'));
    editBtn.classList.remove('hidden');
    cancelBtn.classList.add('hidden');
    cancelBtn.style.display = '';
  }
}

// ───── Ouvre un select (entre en mode édition si nécessaire) ─────
function openSelect(name) {
  const editBtn = document.getElementById('edit-btn');
  if (editBtn && !editBtn.classList.contains('hidden')) {
    toggleEdit();
  }
  setTimeout(function() {
    var sel = document.querySelector('select[name="' + name + '"]');
    if (sel) {
      sel.focus();
      if (sel.showPicker) sel.showPicker();
    }
  }, 50);
}

// ───── Suppression de compte ─────
function confirmDelete() {
  if (confirm('Supprimer définitivement votre compte ? Cette action est irréversible.')) {
    const form = document.getElementById('delete-form');
    if (form instanceof HTMLFormElement) form.submit();
  }
}
</script>
