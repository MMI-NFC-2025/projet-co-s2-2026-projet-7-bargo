---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getUserAuth, updateUser, deleteUser, getCollection, getImageUrl } from '../js/backend.js';
import defaultBanner from '../assets/img/golden_bar.avif';
import chevronIcon from '../assets/icon/chevron-bottom-normal.svg';

// Auth guard
const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

let updateError   = '';
let updateSuccess = false;
let pwdError      = '';
let pwdSuccess    = false;
let emailError    = '';
let emailSuccess  = false;
let activeTab     = Astro.url.searchParams.get('tab') ?? 'apropos';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action   = formData.get('_action')?.toString();

  if (action === 'delete') {
    await deleteUser(userId, token);
    Astro.cookies.delete('pb_token',   { path: '/' });
    Astro.cookies.delete('pb_user_id', { path: '/' });
    return Astro.redirect('/');
  }

  if (action === 'logout') {
    Astro.cookies.delete('pb_token',   { path: '/' });
    Astro.cookies.delete('pb_user_id', { path: '/' });
    return Astro.redirect('/');
  }

  if (action === 'edit') {
    const pbData = new FormData();
    for (const field of ['prenom', 'nom', 'pseudo', 'age', 'ville', 'bar_favori', 'boisson_favori', 'preference_horaire_debut', 'preference_horaire_fin']) {
      const val = formData.get(field);
      if (val !== null && val.toString() !== '') pbData.append(field, val.toString());
    }
    const avatarFile  = formData.get('avatar');
    const baniereFile = formData.get('baniere');
    if (avatarFile  instanceof File && avatarFile.size  > 0) pbData.append('avatar',  avatarFile,  avatarFile.name);
    if (baniereFile instanceof File && baniereFile.size > 0) pbData.append('baniere', baniereFile, baniereFile.name);
    const result = await updateUser(userId, token, pbData);
    if (result) { updateSuccess = true; } else { updateError = 'Erreur lors de la mise à jour.'; }
    activeTab = 'apropos';
  }

  if (action === 'change_password') {
    const oldPwd     = formData.get('old_password')?.toString()     ?? '';
    const newPwd     = formData.get('new_password')?.toString()     ?? '';
    const confirmPwd = formData.get('confirm_password')?.toString() ?? '';
    if (!oldPwd || !newPwd || !confirmPwd) {
      pwdError = 'Tous les champs sont requis.';
    } else if (newPwd !== confirmPwd) {
      pwdError = 'Les mots de passe ne correspondent pas.';
    } else if (newPwd.length < 8) {
      pwdError = 'Le mot de passe doit contenir au moins 8 caractères.';
    } else {
      const pbData = new FormData();
      pbData.append('oldPassword',    oldPwd);
      pbData.append('password',       newPwd);
      pbData.append('passwordConfirm', confirmPwd);
      const result = await updateUser(userId, token, pbData);
      if (result) { pwdSuccess = true; } else { pwdError = 'Mot de passe actuel incorrect.'; }
    }
    activeTab = 'parametres';
  }

  if (action === 'change_email') {
    const newEmail = formData.get('new_email')?.toString().trim() ?? '';
    if (!newEmail || !newEmail.includes('@')) {
      emailError = 'Adresse email invalide.';
    } else {
      const pbData = new FormData();
      pbData.append('email', newEmail);
      const result = await updateUser(userId, token, pbData);
      if (result) { emailSuccess = true; } else { emailError = 'Erreur lors de la mise à jour.'; }
    }
    activeTab = 'parametres';
  }
}

// Données utilisateur
const user = await getUserAuth(userId, token);
if (!user || user.code === 404) {
  Astro.cookies.delete('pb_token',   { path: '/' });
  Astro.cookies.delete('pb_user_id', { path: '/' });
  return Astro.redirect('/connexion');
}

// Dropdowns
const bars     = await getCollection('bar',     { perPage: 200, sort: 'nom' });
let   boissons = [];
try { boissons = await getCollection('boisson', { perPage: 200, sort: 'nom' }); } catch {}

// Notifications
let notifications = [];
try {
  notifications = await getCollection('notifications', {
    filter:  `user = "${userId}"`,
    sort:    '-created',
    perPage: 50
  });
} catch {}

// Messages
let messages = [];
try {
  messages = await getCollection('messages', {
    filter:  `expediteur = "${userId}" || destinataire = "${userId}"`,
    sort:    '-created',
    perPage: 50,
    expand:  'expediteur,destinataire'
  });
} catch {}

// Images
const avatarUrl  = user.avatar  ? getImageUrl(user, user.avatar)  : null;
const baniereUrl = user.baniere ? getImageUrl(user, user.baniere) : null;

// Relations favoris
const barFavoriId     = Array.isArray(user.bar_favori)     ? user.bar_favori[0]     : user.bar_favori;
const boissonFavoriId = Array.isArray(user.boisson_favori) ? user.boisson_favori[0] : user.boisson_favori;
const barFavoriNom     = user.expand?.bar_favori?.nom     ?? bars.find(b => b.id === barFavoriId)?.nom     ?? '';
const boissonFavoriNom = user.expand?.boisson_favori?.nom ?? boissons.find(b => b.id === boissonFavoriId)?.nom ?? '';

// Préférence horaire
const prefDebut = user.preference_horaire_debut ?? '';
const prefFin   = user.preference_horaire_fin   ?? '';
const jours     = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];

const createdAt = user.created ? new Date(user.created).toLocaleDateString('fr-FR') : '—';

// Compteurs non lus
const unreadNotifs   = notifications.filter(n => !n.lu).length;
const unreadMessages = messages.filter(m => !m.lu && (m.destinataire === userId || m.to_user === userId)).length;

// Positions underline par onglet
const ulPos = {
  apropos:       { left: 'calc(33.33% + 37px)', width: '126px' },
  notifications: { left: 'calc(41.67% + 65px)', width: '170px' },
  messages:      { left: 'calc(58.33% + 32px)', width: '139px' },
  parametres:    { left: 'calc(75% - 56px)',     width: '140px' }
};
const ul = ulPos[activeTab as keyof typeof ulPos] ?? ulPos.apropos;

// Helper date relative
function timeAgo(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1)  return "À l'instant";
  if (mins < 60) return `Il y a ${mins} min`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Il y a ${hrs}h`;
  return `Il y a ${Math.floor(hrs / 24)}j`;
}
---

<Layout title="Mon profil — Bargo">
<div class="relative w-full bg-[#f7f1ed] overflow-x-hidden" style="min-height: 1972px;">

  <!-- ===== BANNER ===== -->
  <div class="absolute top-0 left-0 w-full h-[542px] overflow-hidden">
    {baniereUrl
      ? <img src={baniereUrl} alt="Bannière" class="w-full h-full object-cover" />
      : <Image src={defaultBanner} alt="Bannière" class="w-full h-full object-cover" />
    }
  </div>

  <!-- WHITE HEADER BAR -->
  <div class="absolute top-0 left-0 w-full h-[125px] bg-white z-[1]"></div>

  <!-- GREEN SIDEBAR -->
  <div class="absolute top-[542px] left-0 w-[442px] h-[1430px] bg-[#72c073]"></div>

  <!-- CERCLE BLANC -->
  <div class="absolute top-[384px] left-[58px] w-[314px] h-[314px] rounded-full bg-white z-[2]"></div>

  <!-- PHOTO DE PROFIL -->
  <div class="absolute top-[414px] left-[87px] w-[255px] h-[255px] rounded-full overflow-hidden z-[3]">
    {avatarUrl
      ? <img src={avatarUrl} alt="Avatar" class="w-full h-full object-cover" />
      : <div class="w-full h-full bg-[#1e1e1e] flex items-center justify-center">
          <span class="text-white text-6xl font-bold">{(user.pseudo ?? user.email ?? '?')[0].toUpperCase()}</span>
        </div>
    }
  </div>

  <!-- NOM -->
  <h2 class="absolute top-[592px] left-[calc(33.33%+5px)] text-black m-0 z-[2] font-bold leading-none tracking-[3px]">
    {user.prenom ? `${user.prenom} ${user.nom ?? ''}` : (user.nom ?? user.pseudo ?? '')}
  </h2>

  <!-- PSEUDO -->
  <h3 class="absolute top-[662px] left-[calc(33.33%+5px)] text-[#72c073] m-0 z-[2]">
    {user.pseudo ?? ''}
  </h3>

  <!-- AMI(E)S -->
  <p class="absolute top-[631px] left-[calc(83.33%+32px)] text-[#646262] text-[16px] font-medium m-0 z-[2] leading-[1.4]">
    {user.amis ?? 0} ami(e)s
  </p>

  <!-- BOUTON DÉCONNEXION -->
  <form method="POST" enctype="application/x-www-form-urlencoded" class="absolute top-[761px] left-[80px] z-[2]">
    <input type="hidden" name="_action" value="logout" />
    <button type="submit"
      class="flex items-center justify-center gap-[15px] border-2 border-white text-white text-[16px] font-medium leading-[1.4] px-[50px] py-[8px] hover:bg-white hover:text-[#72c073] transition-colors cursor-pointer bg-transparent w-[269px]">
      Se déconnecter
    </button>
  </form>

  <!-- LIGNE HAUTE TABS -->
  <div class="absolute top-[762px] left-[calc(25%+82px)] w-[998px] h-[25px] border-b-2 border-[#e7e5e5] z-[2]"></div>

  <!-- UNDERLINE TAB ACTIF -->
  <div id="tab-underline"
    class="absolute top-[793px] h-[80px] border-b-[10px] border-[#72c073] z-[2] transition-all duration-200"
    style={`left: ${ul.left}; width: ${ul.width};`}></div>

  <!-- TABS (cliquables) -->
  <span id="tab-apropos" data-tab="apropos" onclick="switchTab('apropos')"
    class="absolute top-[812px] left-[calc(33.33%+46px)] font-bold text-[24px] leading-[1.3] z-[2] cursor-pointer select-none transition-colors"
    style={activeTab === 'apropos' ? 'color:#72c073' : ''}>
    A propos
  </span>
  <span id="tab-notifications" data-tab="notifications" onclick="switchTab('notifications')"
    class="absolute top-[812px] left-[calc(41.67%+74px)] font-bold text-[24px] leading-[1.3] z-[2] cursor-pointer select-none transition-colors"
    style={activeTab === 'notifications' ? 'color:#72c073' : ''}>
    Notifications
  </span>
  <span id="tab-messages" data-tab="messages" onclick="switchTab('messages')"
    class="absolute top-[812px] left-[calc(58.33%+41px)] font-bold text-[24px] leading-[1.3] z-[2] cursor-pointer select-none transition-colors"
    style={activeTab === 'messages' ? 'color:#72c073' : ''}>
    Messages
  </span>
  <span id="tab-parametres" data-tab="parametres" onclick="switchTab('parametres')"
    class="absolute top-[812px] left-[calc(75%-47px)] font-bold text-[24px] leading-[1.3] z-[2] cursor-pointer select-none transition-colors"
    style={activeTab === 'parametres' ? 'color:#72c073' : ''}>
    Paramètre
  </span>

  <!-- BADGE NOTIFICATIONS -->
  {(unreadNotifs > 0 || notifications.length > 0) && (
    <div class="absolute top-[800px] left-[calc(58.33%-14px)] w-[24px] h-[24px] rounded-full bg-red-500 flex items-center justify-center z-[3] pointer-events-none">
      <span class="text-[11px] font-black text-white leading-none">{Math.min(unreadNotifs || notifications.length, 9)}</span>
    </div>
  )}

  <!-- BADGE MESSAGES -->
  {unreadMessages > 0 && (
    <div class="absolute top-[800px] left-[calc(75%-76px)] w-[24px] h-[24px] rounded-full bg-red-500 flex items-center justify-center z-[3] pointer-events-none">
      <span class="text-[11px] font-black text-white leading-none">{Math.min(unreadMessages, 9)}</span>
    </div>
  )}

  <!-- BOUTIQUE -->
  <a href="/boutique"
    class="absolute top-[802px] left-[calc(83.33%+7px)] flex items-center justify-center gap-[15px] bg-[#1e1e1e] text-white text-[16px] font-medium leading-[1.4] px-[50px] py-[8px] hover:opacity-80 transition-opacity z-[2]">
    Boutique
  </a>

  <!-- LIGNE BAS TABS -->
  <div class="absolute top-[853px] left-[calc(25%+82px)] w-[998px] h-[20px] border-b-2 border-[#e7e5e5] z-[2]"
    style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);"></div>

  <!-- ================================================================ -->
  <!-- PANEL : A PROPOS                                                  -->
  <!-- ================================================================ -->
  <div id="panel-apropos" data-panel class={activeTab !== 'apropos' ? 'hidden' : ''}>

    {updateSuccess && (
      <p class="absolute top-[870px] left-[calc(33.33%+37px)] text-[#347645] text-sm font-medium z-[2] m-0">
        Profil mis à jour avec succès.
      </p>
    )}
    {updateError && (
      <p class="absolute top-[870px] left-[calc(33.33%+37px)] text-red-500 text-sm font-medium z-[2] m-0">
        {updateError}
      </p>
    )}

    <form method="POST" enctype="multipart/form-data" id="profile-form">
      <input type="hidden" name="_action" value="edit" />

      <!-- FOND CARTE INFOS -->
      <div class="absolute top-[914px] left-[calc(33.33%+37px)] w-[515px] h-[254px] bg-[#f7f1ed] rounded-[5px] z-[2]"
        style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);"></div>

      <!-- Séparateurs -->
      <div class="absolute top-[938px] left-[calc(33.33%+46px)] w-[488px] h-[37px] border-b-2 border-[#e7e5e5] z-[3]"></div>
      <div class="absolute top-[984px] left-[calc(33.33%+46px)] w-[488px] h-[37px] border-b-2 border-[#e7e5e5] z-[3]"></div>
      <div class="absolute top-[1030px] left-[calc(33.33%+46px)] w-[488px] h-[37px] border-b-2 border-[#e7e5e5] z-[3]"></div>
      <div class="absolute top-[1076px] left-[calc(33.33%+46px)] w-[488px] h-[37px] border-b-2 border-[#e7e5e5] z-[3]"></div>

      <!-- Labels -->
      <p class="absolute top-[938px]  left-[calc(33.33%+46px)] text-[16px] font-medium text-black m-0 z-[4] leading-[1.4]">Prenom</p>
      <p class="absolute top-[984px]  left-[calc(33.33%+46px)] text-[16px] font-medium text-black m-0 z-[4] leading-[1.4]">Nom</p>
      <p class="absolute top-[1030px] left-[calc(33.33%+46px)] text-[16px] font-medium text-black m-0 z-[4] leading-[1.4]">ID utilisateur</p>
      <p class="absolute top-[1076px] left-[calc(33.33%+46px)] text-[16px] font-medium text-black m-0 z-[4] leading-[1.4]">Age</p>
      <p class="absolute top-[1122px] left-[calc(33.33%+46px)] text-[16px] font-medium text-black m-0 z-[4] leading-[1.4]">Ville</p>

      <!-- Valeurs (mode vue) -->
      <p class="view-field absolute top-[938px]  left-[calc(50%+294px)] -translate-x-full text-[16px] font-medium text-[#646262] m-0 z-[4] leading-[1.4] whitespace-nowrap">{user.prenom ?? '—'}</p>
      <p class="view-field absolute top-[984px]  left-[calc(50%+294px)] -translate-x-full text-[16px] font-medium text-[#646262] m-0 z-[4] leading-[1.4] whitespace-nowrap">{user.nom ?? '—'}</p>
      <p class="view-field absolute top-[1030px] left-[calc(50%+294px)] -translate-x-full text-[16px] font-medium text-[#646262] m-0 z-[4] leading-[1.4] whitespace-nowrap">{user.pseudo ?? '—'}</p>
      <p class="view-field absolute top-[1076px] left-[calc(50%+294px)] -translate-x-full text-[16px] font-medium text-[#646262] m-0 z-[4] leading-[1.4] whitespace-nowrap">{user.age ? `${user.age} ans` : '—'}</p>
      <p class="view-field absolute top-[1122px] left-[calc(50%+294px)] -translate-x-full text-[16px] font-medium text-[#646262] m-0 z-[4] leading-[1.4] whitespace-nowrap">{user.ville ?? '—'}</p>

      <!-- Inputs (mode édition) -->
      <input type="text"   name="prenom" value={user.prenom ?? ''} placeholder="Prénom"
        class="edit-field hidden absolute top-[937px]  left-[calc(50%+294px)] -translate-x-full w-[280px] text-right text-[16px] font-medium text-[#646262] bg-transparent outline-none border-b border-[#72c073] z-[4] leading-[1.4]" />
      <input type="text"   name="nom"    value={user.nom    ?? ''} placeholder="Nom"
        class="edit-field hidden absolute top-[983px]  left-[calc(50%+294px)] -translate-x-full w-[280px] text-right text-[16px] font-medium text-[#646262] bg-transparent outline-none border-b border-[#72c073] z-[4] leading-[1.4]" />
      <input type="text"   name="pseudo" value={user.pseudo ?? ''} placeholder="Pseudo"
        class="edit-field hidden absolute top-[1029px] left-[calc(50%+294px)] -translate-x-full w-[280px] text-right text-[16px] font-medium text-[#646262] bg-transparent outline-none border-b border-[#72c073] z-[4] leading-[1.4]" />
      <input type="number" name="age"    value={user.age    ?? ''} placeholder="Âge" min="13" max="120"
        class="edit-field hidden absolute top-[1075px] left-[calc(50%+294px)] -translate-x-full w-[280px] text-right text-[16px] font-medium text-[#646262] bg-transparent outline-none border-b border-[#72c073] z-[4] leading-[1.4]" />
      <input type="text"   name="ville"  value={user.ville  ?? ''} placeholder="Ville"
        class="edit-field hidden absolute top-[1121px] left-[calc(50%+294px)] -translate-x-full w-[280px] text-right text-[16px] font-medium text-[#646262] bg-transparent outline-none border-b border-[#72c073] z-[4] leading-[1.4]" />

      <!-- FOND CARTE DEVISE -->
      <div class="absolute top-[914px] left-[calc(75%-16px)] w-[296px] h-[230px] bg-[#f7f1ed] rounded-[5px] z-[2]"
        style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);"></div>
      <p class="absolute top-[938px] left-[calc(75%-4px)] text-[16px] font-medium text-black m-0 z-[3] leading-[1.4]">Devise :</p>
      <p class="absolute top-[989px] left-[calc(75%-4px)] text-sm text-[#646262] m-0 z-[3] leading-[1.6] w-[241px]">
        {user.devise ?? '"Passionné par les sorties entre amis, toujours partant pour organiser une tournée bien pensée et relever quelques défis au passage."'}
      </p>

      <!-- FOND CARTE POINTS -->
      <div class="absolute top-[1168px] left-[calc(75%-16px)] w-[296px] h-[82px] bg-[#094736] rounded-[5px] z-[2]"
        style="box-shadow: 0px 4px 10px 0px rgba(0,0,0,0.25);"></div>
      <p class="absolute top-[1191px] left-[calc(75%-4px)] font-medium text-[25px] text-white m-0 z-[3] tracking-[-1px] leading-[1.4]">Points :</p>
      <p class="absolute top-[1191px] left-[calc(83.33%+90px)] -translate-x-1/2 font-medium text-[25px] text-white m-0 z-[3] tracking-[-1px] leading-[1.4] text-center">{user.points ?? 0}</p>

      <!-- BAR FAVORI -->
      <p class="absolute top-[1211px] left-[calc(33.33%+37px)] text-[16px] font-medium text-black m-0 z-[2] leading-[1.4]">Bar favori</p>
      <div class="absolute top-[1250px] left-[calc(33.33%+37px)] w-[515px] h-[57px] bg-[#f7f1ed] rounded-[5px] z-[2] cursor-pointer"
