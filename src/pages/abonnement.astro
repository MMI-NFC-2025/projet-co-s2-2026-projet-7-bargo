---
import Layout from '../layouts/Layout.astro';

const plans = [
  {
    id: 'gratuit',
    nom: 'Gratuit',
    prix: '0€',
    periode: '/ mois',
    couleur: '#646262',
    couleurBtn: '#1e1e1e',
    badge: null,
    description: 'L\'essentiel pour découvrir BARGO et organiser vos premières soirées.',
    avantages: [
      'Accès à l\'application BARGO',
      'Création de sessions barathon',
      'Points standards gagnés',
      'Accès à la boutique',
    ],
    manques: [
      'Sessions limitées à 2 par mois',
      'Points bonus',
    ],
    cta: 'Commencer gratuitement',
  },
  {
    id: 'vip',
    nom: 'VIP',
    prix: '4,99€',
    periode: '/ mois',
    couleur: '#347645',
    couleurBtn: '#347645',
    badge: 'Populaire',
    description: 'Plus de sessions et plus de points pour profiter pleinement de vos soirées.',
    avantages: [
      'Tout du plan Gratuit',
      '5 sessions barathon maximum',
      'Points x2 sur chaque session',
      'Badge VIP sur votre profil',
      'Accès prioritaire aux nouveaux bars',
    ],
    manques: [
      'Sessions illimitées',
    ],
    cta: 'Choisir VIP',
  },
  {
    id: 'premium',
    nom: 'Premium',
    prix: '9,99€',
    periode: '/ mois',
    couleur: '#094736',
    couleurBtn: '#094736',
    badge: 'Meilleur choix',
    description: 'L\'expérience BARGO complète, sans limites.',
    avantages: [
      'Tout du plan VIP',
      'Sessions barathon illimitées',
      'Points x5 sur chaque session',
      'Badge Premium exclusif',
      'Accès anticipé aux nouveautés',
    ],
    manques: [],
    cta: 'Choisir Premium',
  },
];
---

<Layout title="Nos abonnements — Bargo">

  <!-- ===== HERO ===== -->
  <section class="bg-primary-900 h-70 lg:h-112.5 relative">
    <h1 class="absolute top-15 left-5 lg:top-35.25 lg:left-20 text-white m-0 uppercase text-10 lg:text-22.5">Nos abonnements</h1>
    <p class="hidden lg:block absolute top-67 left-20 text-neutral-200 text-3.5 font-medium w-136.75 m-0 leading-[1.6]">
      Ici vous pouvez prendre les abonnements qui permettront d'avoir un petit plus sur vos soirées&nbsp;!
    </p>
  </section>

  <!-- ===== CARDS ===== -->
  <div class="bg-neutral-200 px-4 lg:px-20 py-10 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-10">

      {plans.map(plan => (
        <div class="bg-white rounded-1.25 shadow-[0px_4px_10px_0px_rgba(0,0,0,0.15)] flex flex-col overflow-hidden">

          <!-- En-tête coloré -->
          <div class="px-8.75 py-7.5 relative" style={`background-color: ${plan.couleur};`}>
            {plan.badge && (
              <span class="absolute top-5 right-5 bg-primary-500 text-primary-900 text-3 font-bold px-2.5 py-1 rounded-full uppercase tracking-0.125">
                {plan.badge}
              </span>
            )}
            <h3 class="text-white m-0 mb-4 uppercase tracking-0.5">{plan.nom}</h3>
            <div class="flex items-baseline gap-1.5">
              <span class="text-white font-bold leading-none" style="font-size: 50px; font-family: Manrope, sans-serif;">{plan.prix}</span>
              <span class="text-neutral-300 text-4 font-medium">{plan.periode}</span>
            </div>
          </div>

          <!-- Corps -->
          <div class="px-8.75 py-7.5 flex flex-col flex-1">

            <p class="text-neutral-500 text-3.5 font-medium leading-[1.6] m-0 mb-6">{plan.description}</p>

            <!-- Avantages -->
            <ul class="list-none m-0 p-0 flex flex-col gap-3 mb-4">
              {plan.avantages.map(item => (
                <li class="flex items-start gap-2.5">
                  <svg class="shrink-0 mt-0.5" width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="9" fill="#72c073"/>
                    <path d="M4.5 9L7.5 12L13.5 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="text-black text-4 font-medium leading-[1.4]">{item}</span>
                </li>
              ))}
              {plan.manques.map(item => (
                <li class="flex items-start gap-2.5">
                  <svg class="shrink-0 mt-0.5" width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="9" fill="#dfdfdf"/>
                    <path d="M5.5 9h7" stroke="#646262" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                  <span class="text-neutral-500 text-4 font-medium leading-[1.4] line-through">{item}</span>
                </li>
              ))}
            </ul>

            <!-- Spacer -->
            <div class="flex-1"></div>

            <!-- Bouton -->
            <button
              type="button"
              class="mt-6 w-full h-13 flex items-center justify-center text-white text-4 font-medium hover:opacity-90 transition-opacity cursor-pointer border-0 rounded-0.75"
              style={`background-color: ${plan.couleurBtn};`}
            >
              {plan.cta}
            </button>

          </div>
        </div>
      ))}

    </div>
  </div>

</Layout>
