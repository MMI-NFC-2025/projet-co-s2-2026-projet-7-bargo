---
// @ts-nocheck
import Layout from '../layouts/Layout.astro';
import PbImage from '../components/PbImage.astro';
import LikeButton from '../components/LikeButton.astro';
import Pagination from '../components/Pagination.astro';
import likeIcon     from '../assets/icon/like.svg';
import likeFillIcon from '../assets/icon/like_fill.svg';

const PB_URL = 'https://pbbargo.pierre-mouilleseaux-lhuillier.fr';

const page     = parseInt(Astro.url.searchParams.get('page') ?? '1');
const activeTab = Astro.url.searchParams.get('tab') ?? 'avatar';
const perPage  = 12;

const filter = encodeURIComponent(`type="${activeTab}"`);
const res  = await fetch(`${PB_URL}/api/collections/boutique/records?page=${page}&perPage=${perPage}&sort=created&filter=${filter}`);
const data = await res.json();
const produits    = data.items ?? [];
const totalPages  = Math.ceil((data.totalItems ?? 0) / perPage);

// Points utilisateur (si connecté)
const userId = Astro.cookies.get('pb_user_id')?.value;
const token  = Astro.cookies.get('pb_token')?.value;
const isAuth = !!(userId && token);
let userPoints = null;
let userItemsFavori = [];
if (userId && token) {
  const userRes = await fetch(`${PB_URL}/api/collections/users/records/${userId}`, {
    headers: { Authorization: `Bearer ${token}` }
  });
  if (userRes.ok) {
    const user = await userRes.json();
    userPoints = user.points ?? 0;
    userItemsFavori = Array.isArray(user.items_favori) ? user.items_favori : [];
  }
}

const tabs = [
  { id: 'avatar', label: 'Avatar' },
  { id: 'theme',  label: 'Thème du profil' },
  { id: 'titre',  label: 'Titre' },
];

function tabUrl(id) {
  const u = new URL(Astro.url.href);
  u.searchParams.set('tab', id);
  u.searchParams.set('page', '1');
  return u.pathname + u.search;
}
---

<Layout title="Boutique — Bargo">

  <!-- ===== HERO ===== -->
  <section class="bg-primary-900 h-70 lg:h-112.5 relative">
    <h1 class="absolute top-15 left-5 lg:top-35.25 lg:left-20 text-white m-0 uppercase text-10 lg:text-22.5">Boutique</h1>
    <p class="block lg:hidden absolute bottom-6 left-5 right-5 text-neutral-300 text-3.5 font-medium m-0 leading-[1.4]">
      Débloquez des avatars, des thèmes et des titres exclusifs grâce à vos points de barathon.
    </p>
    <p class="hidden lg:block absolute top-67 left-20 text-neutral-200 text-3.5 font-medium w-136.75 m-0 leading-[1.6]">
      Personnalisez votre profil et affirmez votre style au sein du groupe. Débloquez des avatars,
      des cadres et des thèmes exclusifs grâce à votre participation et à vos succès.
      Plus vous prenez part aux barathons, plus votre profil évolue.
    </p>
  </section>

  <!-- ===== CONTENU BEIGE ===== -->
  <div class="bg-neutral-200">

    <!-- Tab bar -->
    <div class="pt-5.75">
      <div class="border-b-2 border-neutral-350 shadow-[0px_4px_10px_0px_rgba(0,0,0,0.25)]">
        <div class="lg:px-20 flex items-center justify-between h-14 lg:h-13">

          <!-- Onglets -->
          <div id="tab-list" class="relative flex items-center flex-1 lg:flex-none h-full overflow-x-auto">
            {tabs.map(tab => (
              <button
                data-tab={tab.id}
                class={`tab-btn flex-1 lg:flex-none flex items-center justify-center lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black bg-transparent border-0 cursor-pointer whitespace-nowrap`}
              >
                {tab.label}
              </button>
            ))}
            <!-- Trait animé -->
            <div id="tab-indicator" class="absolute bottom-0 h-1.5 rounded-full" style="background:#72c073; transition: left 0.3s cubic-bezier(.4,0,.2,1), width 0.3s cubic-bezier(.4,0,.2,1); left:0; width:0;"></div>
          </div>

          <!-- Points utilisateur -->
          {userPoints !== null && (
            <div class="flex items-center gap-2 lg:gap-3 shrink-0 px-3 lg:px-0 lg:ml-4">
              <span class="hidden lg:block text-black text-4 font-medium">Vos points :</span>
              <h3 class="m-0 text-black text-3.5 lg:text-6.25">{userPoints} pts</h3>
            </div>
          )}

        </div>
      </div>
    </div>

    <!-- Grille de produits -->
    <div id="boutique-wrap" class="px-4 lg:px-20 pt-8 lg:pt-23 pb-8 lg:pb-20">
      {produits.length > 0 ? (
        <div id="boutique-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-8">
          {produits.map(produit => {
            const imageFile = Array.isArray(produit.item) ? produit.item[0] : produit.item;
            return (
              <div>

                <!-- MOBILE -->
                <div class="block lg:hidden bg-white rounded-0.5 shadow-[0px_7px_4px_0px_rgba(0,0,0,0.25)] overflow-hidden">
                  <div class="h-40 bg-neutral-500 flex items-center justify-center">
                    <div class="size-27.5 rounded-full overflow-hidden">
                      <PbImage record={produit} recordImage={imageFile} width={150} height={150} />
                    </div>
                  </div>
                  <div class="p-4">
                    <div class="flex items-center justify-between mb-3">
                      <h3 class="m-0 text-black">{produit.prix} pts</h3>
                      {isAuth && (
                        <LikeButton id={produit.id} liked={userItemsFavori.includes(produit.id)} variant="item" class="p-0 border-0 bg-transparent cursor-pointer" ariaLabel="Favori" />
                      )}
                    </div>
                    <button type="button" class="w-full h-12 bg-neutral-800 flex items-center justify-center hover:opacity-90 transition-opacity cursor-pointer border-0">
                      <span class="text-white text-4 font-medium">Acheter</span>
                    </button>
                  </div>
                </div>

                <!-- DESKTOP -->
                <div class="hidden lg:block h-91.75 rounded-0.5 shadow-[0px_4px_6px_0px_rgba(0,0,0,0.25)] relative overflow-hidden bg-neutral-500">
                  <div class="absolute bottom-0 left-0 right-0 h-35.75 bg-white rounded-bl-0.5 rounded-br-0.5"></div>
                  <div class="absolute top-10.5 left-1/2 -translate-x-1/2 size-37.5 rounded-full overflow-hidden">
                    <PbImage record={produit} recordImage={imageFile} width={150} height={150} />
                  </div>
                  <div class="absolute top-59.75 left-7.25 right-6.75 flex items-center justify-between">
                    <h3 class="m-0 text-black text-6.25">{produit.prix} pts</h3>
                    {isAuth && (
                      <LikeButton id={produit.id} liked={userItemsFavori.includes(produit.id)} variant="item" class="p-0 border-0 bg-transparent cursor-pointer" ariaLabel="Favori" />
                    )}
                  </div>
                  <button type="button" class="absolute top-73.75 bottom-3 left-7.25 right-7.5 bg-neutral-800 flex items-center justify-center hover:opacity-90 transition-opacity cursor-pointer border-0">
                    <span class="text-white text-4 font-medium">Acheter</span>
                  </button>
                </div>

              </div>
            );
          })}
        </div>
      ) : (
        <p id="boutique-empty" class="text-neutral-500 text-4 font-medium">Aucun article disponible pour l'instant.</p>
      )}
    </div>

    <!-- Pagination -->
    <Pagination page={page} totalPages={totalPages} currentUrl={Astro.url.href} />

  </div>

  <script is:inline define:vars={{ token, userId, isAuth, PB_URL, perPage, activeTab, likeIconSrc: likeIcon.src, likeFillIconSrc: likeFillIcon.src }}>
    if (isAuth) window.__AUTH__ = { token, userId };
    window.__BOUTIQUE__ = { PB_URL, perPage, activeTab, likeIconSrc, likeFillIconSrc };
  </script>
  <script>
    import '../js/boutique-tabs.js';
  </script>
  <script>
    import '../js/like.js';
  </script>

</Layout>
