---
// @ts-nocheck
import Layout from '../layouts/Layout.astro';
import PbImage from '../components/PbImage.astro';
import LikeButton from '../components/LikeButton.astro';
import Pagination from '../components/Pagination.astro';
import likeIcon     from '../assets/icon/like.svg';
import likeFillIcon from '../assets/icon/like_fill.svg';

const PB_URL = 'https://pbbargo.pierre-mouilleseaux-lhuillier.fr';

const page     = parseInt(Astro.url.searchParams.get('page') ?? '1');
const activeTab = Astro.url.searchParams.get('tab') ?? 'avatar';
const perPage  = 12;

const filter = encodeURIComponent(`type="${activeTab}"`);
const res  = await fetch(`${PB_URL}/api/collections/boutique/records?page=${page}&perPage=${perPage}&sort=created&filter=${filter}`);
const data = await res.json();
const produits    = data.items ?? [];
const totalPages  = Math.ceil((data.totalItems ?? 0) / perPage);

// Points utilisateur (si connecté)
const userId = Astro.cookies.get('pb_user_id')?.value;
const token  = Astro.cookies.get('pb_token')?.value;
const isAuth = !!(userId && token);
let userPoints = null;
let userItemsFavori = [];
if (userId && token) {
  const userRes = await fetch(`${PB_URL}/api/collections/users/records/${userId}`, {
    headers: { Authorization: `Bearer ${token}` }
  });
  if (userRes.ok) {
    const user = await userRes.json();
    userPoints = user.points ?? 0;
    userItemsFavori = Array.isArray(user.items_favori) ? user.items_favori : [];
  }
}

const tabs = [
  { id: 'avatar', label: 'Avatar' },
  { id: 'theme',  label: 'Thème du profil' },
  { id: 'titre',  label: 'Titre' },
];

function tabUrl(id) {
  const u = new URL(Astro.url.href);
  u.searchParams.set('tab', id);
  u.searchParams.set('page', '1');
  return u.pathname + u.search;
}
---

<Layout title="Boutique — Bargo">

  <!-- ===== HERO ===== -->
  <section class="bg-primary-900 h-70 lg:h-112.5 relative">
    <h1 class="absolute top-15 left-5 lg:top-35.25 lg:left-20 text-white m-0 uppercase text-10 lg:text-22.5">Boutique</h1>
    <p class="hidden lg:block absolute top-67 left-20 text-neutral-200 text-3.5 font-medium w-136.75 m-0 leading-[1.6]">
      Personnalisez votre profil et affirmez votre style au sein du groupe. Débloquez des avatars,
      des cadres et des thèmes exclusifs grâce à votre participation et à vos succès.
      Plus vous prenez part aux barathons, plus votre profil évolue.
    </p>
  </section>

  <!-- ===== CONTENU BEIGE ===== -->
  <div class="bg-neutral-200">

    <!-- Tab bar -->
    <div class="pt-5.75">
      <div class="border-b-2 border-neutral-350 shadow-[0px_4px_10px_0px_rgba(0,0,0,0.25)]">
        <div class="px-4 lg:px-20 flex items-center justify-between h-13">

          <!-- Onglets -->
          <div id="tab-list" class="relative flex items-center h-full overflow-x-auto">
            {tabs.map(tab => (
              <button
                data-tab={tab.id}
                class={`tab-btn flex items-center justify-center px-4 lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black bg-transparent border-0 cursor-pointer whitespace-nowrap`}
              >
                {tab.label}
              </button>
            ))}
            <!-- Trait animé -->
            <div id="tab-indicator" class="absolute bottom-0 h-1 rounded-full" style="background:#72c073; transition: left 0.3s cubic-bezier(.4,0,.2,1), width 0.3s cubic-bezier(.4,0,.2,1); left:0; width:0;"></div>
          </div>

          <!-- Points utilisateur -->
          {userPoints !== null && (
            <div class="flex items-center gap-2 lg:gap-3 shrink-0 ml-4">
              <span class="hidden lg:block text-black text-4 font-medium">Vos points :</span>
              <h3 class="m-0 text-black text-3.5 lg:text-6.25">{userPoints} pts</h3>
            </div>
          )}

        </div>
      </div>
    </div>

    <!-- Grille de produits -->
    <div id="boutique-wrap" class="px-4 lg:px-20 pt-8 lg:pt-23 pb-8 lg:pb-20">
      {produits.length > 0 ? (
        <div id="boutique-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-8">
          {produits.map(produit => {
            const imageFile = Array.isArray(produit.item) ? produit.item[0] : produit.item;
            return (
              <div class="h-75 lg:h-91.75 rounded-0.5 shadow-[0px_4px_6px_0px_rgba(0,0,0,0.25)] relative overflow-hidden bg-neutral-500">

                <!-- Zone blanche du bas -->
                <div class="absolute bottom-0 left-0 right-0 h-30 lg:h-35.75 bg-white rounded-bl-0.5 rounded-br-0.5"></div>

                <!-- Image avatar (cercle centré) -->
                <div class="absolute top-7.5 lg:top-10.5 left-1/2 -translate-x-1/2 size-27.5 lg:size-37.5 rounded-full overflow-hidden">
                  <PbImage record={produit} recordImage={imageFile} width={150} height={150} />
                </div>

                <!-- Ligne points + like -->
                <div class="absolute top-48.75 lg:top-59.75 left-4 lg:left-7.25 right-4 lg:right-6.75 flex items-center justify-between">
                  <h3 class="m-0 text-black text-4 lg:text-6.25">{produit.prix} pts</h3>
                  {isAuth && (
                    <LikeButton id={produit.id} liked={userItemsFavori.includes(produit.id)} variant="item" class="p-0 border-0 bg-transparent cursor-pointer" ariaLabel="Favori" />
                  )}
                </div>

                <!-- Bouton Acheter -->
                <button type="button"
                  class="absolute top-60 lg:top-73.75 bottom-2 lg:bottom-3 left-4 lg:left-7.25 right-4 lg:right-7.5 bg-neutral-800 flex items-center justify-center hover:opacity-90 transition-opacity cursor-pointer border-0">
                  <span class="text-white text-3.5 lg:text-4 font-medium">Acheter</span>
                </button>

              </div>
            );
          })}
        </div>
      ) : (
        <p id="boutique-empty" class="text-neutral-500 text-4 font-medium">Aucun article disponible pour l'instant.</p>
      )}
    </div>

    <!-- Pagination -->
    <Pagination page={page} totalPages={totalPages} currentUrl={Astro.url.href} />

  </div>

  <script is:inline define:vars={{ token, userId, isAuth, PB_URL, perPage, activeTab, likeIconSrc: likeIcon.src, likeFillIconSrc: likeFillIcon.src }}>
    if (isAuth) window.__AUTH__ = { token, userId };

    (function () {
      var currentTab  = activeTab;

      function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

      function cardHtml(p) {
        var imageFile = Array.isArray(p.item) ? p.item[0] : p.item;
        var imgSrc    = imageFile ? PB_URL + '/api/files/' + p.collectionName + '/' + p.id + '/' + imageFile : '';
        var likeHtml  = isAuth
          ? '<button class="like-btn-item p-0 border-0 bg-transparent cursor-pointer" data-id="' + p.id + '" type="button" aria-label="Favori">' +
              '<img src="' + likeIconSrc + '" alt="" class="like-empty size-6" />' +
              '<img src="' + likeFillIconSrc + '" alt="" class="like-filled size-6 hidden" />' +
            '</button>'
          : '';
        return '<div class="h-75 lg:h-91.75 rounded-0.5 shadow-[0px_4px_6px_0px_rgba(0,0,0,0.25)] relative overflow-hidden bg-neutral-500">' +
          '<div class="absolute bottom-0 left-0 right-0 h-30 lg:h-35.75 bg-white rounded-bl-0.5 rounded-br-0.5"></div>' +
          (imgSrc ? '<div class="absolute top-7.5 lg:top-10.5 left-1/2 -translate-x-1/2 size-27.5 lg:size-37.5 rounded-full overflow-hidden"><img src="' + imgSrc + '" style="width:100%;height:100%;object-fit:cover;" /></div>' : '') +
          '<div class="absolute top-48.75 lg:top-59.75 left-4 lg:left-7.25 right-4 lg:right-6.75 flex items-center justify-between">' +
            '<h3 class="m-0 text-black text-4 lg:text-6.25">' + esc(p.prix) + ' pts</h3>' +
            likeHtml +
          '</div>' +
          '<button type="button" class="absolute top-60 lg:top-73.75 bottom-2 lg:bottom-3 left-4 lg:left-7.25 right-4 lg:right-7.5 bg-neutral-800 flex items-center justify-center hover:opacity-90 transition-opacity cursor-pointer border-0">' +
            '<span class="text-white text-3.5 lg:text-4 font-medium">Acheter</span>' +
          '</button>' +
        '</div>';
      }

      async function loadTab(tabId) {
        var filter  = encodeURIComponent('type="' + tabId + '"');
        var url     = PB_URL + '/api/collections/boutique/records?page=1&perPage=' + perPage + '&sort=created&filter=' + filter;
        var res     = await fetch(url);
        var data    = res.ok ? await res.json() : { items: [] };
        var items   = data.items ?? [];

        var grid  = document.getElementById('boutique-grid');
        var empty = document.getElementById('boutique-empty');
        var wrap  = document.getElementById('boutique-wrap');

        // Fade out
        var target = grid || empty;
        if (target) {
          target.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
          target.style.opacity = '0';
          target.style.transform = 'translateY(8px)';
        }

        await new Promise(function (r) { setTimeout(r, 200); });

        if (items.length === 0) {
          if (grid) grid.remove();
          if (!document.getElementById('boutique-empty')) {
            var p = document.createElement('p');
            p.id = 'boutique-empty';
            p.className = 'text-neutral-500 text-4 font-medium';
            p.textContent = 'Aucun article disponible pour l\'instant.';
            p.style.opacity = '0';
            p.style.transform = 'translateY(8px)';
            wrap.prepend(p);
            requestAnimationFrame(function () {
              p.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
              p.style.opacity = '1';
              p.style.transform = 'translateY(0)';
            });
          }
        } else {
          if (empty) empty.remove();
          if (!document.getElementById('boutique-grid')) {
            var g = document.createElement('div');
            g.id = 'boutique-grid';
            g.className = 'grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-8';
            wrap.prepend(g);
            grid = g;
          }
          grid.innerHTML = items.map(cardHtml).join('');
          grid.style.opacity = '0';
          grid.style.transform = 'translateY(8px)';
          requestAnimationFrame(function () {
            grid.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
            grid.style.opacity = '1';
            grid.style.transform = 'translateY(0)';
          });
        }

        if (window.__initLikes__) window.__initLikes__();
      }

      function moveIndicator(btn) {
        var indicator = document.getElementById('tab-indicator');
        var list      = document.getElementById('tab-list');
        if (!indicator || !list) return;
        var listRect = list.getBoundingClientRect();
        var btnRect  = btn.getBoundingClientRect();
        indicator.style.left  = (btnRect.left - listRect.left + list.scrollLeft) + 'px';
        indicator.style.width = btnRect.width + 'px';
      }

      // Position initiale
      var activeBtn = document.querySelector('.tab-btn[data-tab="' + currentTab + '"]');
      if (activeBtn) moveIndicator(activeBtn);

      document.querySelectorAll('.tab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var tabId = btn.dataset.tab;
          if (tabId === currentTab) return;
          currentTab = tabId;

          moveIndicator(btn);

          // Mise à jour URL sans rechargement
          var u = new URL(window.location.href);
          u.searchParams.set('tab', tabId);
          u.searchParams.set('page', '1');
          history.pushState({}, '', u.pathname + u.search);

          loadTab(tabId);
        });
      });
    })();
  </script>
  <script>
    import '../js/like.js';
  </script>

</Layout>
