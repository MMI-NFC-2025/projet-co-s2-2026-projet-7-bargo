---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import { PB_URL } from '../../js/backend.js';
import SessionPanel from '../../components/SessionPanel.astro';
import SessionModals from '../../components/SessionModals.astro';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

const { id } = Astro.params;
if (!id) return Astro.redirect('/session');

// Fetch session with expanded relations
const res = await fetch(
  `${PB_URL}/api/collections/session_barathon/records/${id}?expand=id_bar,id_jeux,id_inviter,id_sam`,
  { headers: { Authorization: `Bearer ${token}` } }
);
if (!res.ok) return Astro.redirect('/session');
const session = await res.json();
if (!session || session.code === 404) return Astro.redirect('/session');

// Prepare expanded data
const bars  = (session.expand?.id_bar  ?? []).map(b => ({
  id: b.id, collectionName: b.collectionName,
  nom: b.nom ?? '', adresse: b.adresse ?? '',
  img: b.img?.[0] ?? null,
  lat: b.localisation?.lat ?? null, lon: b.localisation?.lon ?? null,
}));

// id_jeux est Single — peut être un objet ou null
const jeuxRaw = session.expand?.id_jeux;
const jeux = jeuxRaw
  ? [{ id: jeuxRaw.id, collectionName: jeuxRaw.collectionName, nom: jeuxRaw.nom ?? '', description: jeuxRaw.description ?? '', img: Array.isArray(jeuxRaw.img) ? (jeuxRaw.img[0] ?? null) : (jeuxRaw.img ?? null), type_du_jeux: jeuxRaw.type_du_jeux ?? '' }]
  : [];

const amis  = (session.expand?.id_inviter ?? []).map(u => ({
  id: u.id, collectionName: u.collectionName,
  pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '',
  avatar: u.avatar ?? null,
}));

const samIds = (session.expand?.id_sam ?? []).map(u => u.id);

// All users for "Ajouter" modal (re-fetch a light list)
const usersRes  = await fetch(`${PB_URL}/api/collections/users/records?perPage=200&sort=pseudo`);
const usersData = await usersRes.json();
const allUsers  = (usersData.items ?? [])
  .filter(u => u.id !== userId)
  .map(u => ({
    id: u.id, collectionName: u.collectionName,
    pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '',
    avatar: u.avatar ?? null,
  }));

// All bars & jeux for "Ajouter" modal
const barsRes  = await fetch(`${PB_URL}/api/collections/bar/records?perPage=200&sort=nom`);
const barsData = await barsRes.json();
const allBars  = (barsData.items ?? []).map(b => ({
  id: b.id, collectionName: b.collectionName,
  nom: b.nom ?? '', adresse: b.adresse ?? '',
  img: b.img?.[0] ?? null,
  lat: b.localisation?.lat ?? null, lon: b.localisation?.lon ?? null,
}));

const jeuxRes  = await fetch(`${PB_URL}/api/collections/jeux/records?perPage=200&sort=nom`);
const jeuxData = await jeuxRes.json();
const allJeux  = (jeuxData.items ?? []).map(j => ({
  id: j.id, collectionName: j.collectionName,
  nom: j.nom ?? '', description: j.description ?? '',
  img: Array.isArray(j.img) ? (j.img[0] ?? null) : (j.img ?? null),
  type_du_jeux: j.type_du_jeux ?? '',
}));

const isHote = session.id_hote === userId;

const isSam     = (session.expand?.id_sam ?? []).some(u => u.id === userId);
const barActuel = session.bar_actuel ?? 0;

// Determine session state: pas_commencer | en_cours | fini
const statut = session.etat_session ?? 'pas_commencer';
if (statut === 'fini') return Astro.redirect('/session');
let isEnCours = statut === 'en_cours';
if (!isEnCours && session.date_session && session.heur_depart) {
  try {
    const dt = new Date(`${session.date_session}T${session.heur_depart}`);
    if (!isNaN(dt.getTime())) isEnCours = new Date() >= dt;
  } catch(_) {}
}

const pageData = JSON.stringify({
  session: { id: session.id, nom: session.nom, date: session.date_session, heure_debut: session.heur_depart, description: session.description },
  bars, jeux, amis, samIds,
  allBars, allJeux, allUsers,
  PB_URL, token, isHote, isSam, userId, isEnCours, barActuel,
});
---

<Layout title={`${session.nom ?? 'Session'} — Bargo`}>

<div class="flex flex-col lg:flex-row" style="min-height: calc(100vh - 92px);">
  <div id="session-map" class="flex-1 h-70 lg:h-auto" style="background:#dfdfdf; position:relative; z-index:0;"></div>
  <SessionPanel session={{ nom: session.nom, date: session.date_session, heure_debut: session.heur_depart }} isHote={isHote} isEnCours={isEnCours} />
</div>

<SessionModals />

<!-- JSON data -->
<script id="page-data" type="application/json" set:html={pageData}></script>

<script>
import "../../js/session-detail.js";
</script>

</Layout>
