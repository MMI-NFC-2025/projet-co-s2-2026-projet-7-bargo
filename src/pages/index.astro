---
// index.astro — Page d'accueil BARGO (utilisateurs connectés)
import Layout from '../layouts/Layout.astro';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/LandingPage');
import { Image } from 'astro:assets';
import { getCollection } from '../js/backend.js';
import PbImage from '../components/PbImage.astro';
import Faq from '../components/Faq.astro';
import Partenaires from '../components/Partenaires.astro';

import arrowRight     from '../assets/icon/arrow-right.svg';
import carouselGauche from '../assets/icon/carousel_gauche.svg';
import carouselDroit  from '../assets/icon/carousel_droit.svg';
import heroBg         from '../assets/img/hero_acceuil.avif';
import jeux1          from '../assets/img/jeux-img-1.avif';
import jeux2          from '../assets/img/jeux-img-2.avif';
import jeux3          from '../assets/img/jeux-img-3.avif';
import jeux4          from '../assets/img/jeux-img-4.avif';
import jeux5          from '../assets/img/jeux-img-5.avif';
import membre1        from '../assets/img/melvyn_philippon.avif';
import membre2        from '../assets/img/pierre_mouilleseaux_lhuillier.avif';
import membre3        from '../assets/img/alex_ringenbach.avif';

const bars = await getCollection('bar', { sort: 'created' });

const faqItems = [
  {
    question: "Qu'est-ce qu'un barathon ?",
    answer: "Un barathon est une tournée organisée de bars entre amis, structurée avec un itinéraire, des défis et un esprit d'équipe. BARGO vous permet de tout organiser simplement."
  },
  {
    question: "Comment créer un barathon ?",
    answer: "Créez votre compte, formez votre groupe, sélectionnez les bars de votre itinéraire et lancez la session. C'est tout !"
  },
  {
    question: "Faut-il payer pour utiliser BARGO ?",
    answer: "Non, BARGO est gratuit pour les utilisateurs. Certaines fonctionnalités premium peuvent être disponibles à l'avenir."
  },
  {
    question: "Comment inviter mes amis ?",
    answer: "Depuis votre espace, vous pouvez inviter vos amis par lien ou par email directement depuis l'interface."
  },
  {
    question: "Peut-on modifier l'itinéraire en cours de soirée ?",
    answer: "Oui, l'organisateur peut ajuster l'itinéraire en temps réel selon les envies du groupe."
  },
  {
    question: "Comment fonctionne le système de jeux ?",
    answer: "Des défis sont proposés automatiquement à chaque étape du barathon. Les joueurs peuvent les accepter ou les passer selon les règles choisies en début de session."
  },
  {
    question: "Mes données sont-elles protégées ?",
    answer: "Oui, vos données sont hébergées de manière sécurisée et ne sont jamais revendues. Consultez nos mentions légales pour plus d'informations."
  }
];
---

<Layout>

  <!-- ==================== HERO ==================== -->
  <section class="relative w-full h-100 lg:h-175 overflow-hidden">
    <Image src={heroBg} alt="" class="absolute inset-0 w-full h-full object-cover pointer-events-none" />
    <h1 class="absolute text-white left-5 lg:left-20 top-35 lg:top-66.75 uppercase m-0 text-10 lg:text-22.5">
      <span class="block whitespace-nowrap">"Le barathon</span>
      <span class="block whitespace-nowrap mt-5 lg:mt-12.25">Autrement"</span>
    </h1>
    <p class="hidden lg:block absolute text-neutral-300 right-20 top-156 w-114.25 text-right m-0">
      Une soirée. Un groupe. Un parcours.
    </p>
  </section>

  <!-- ==================== A PROPOS ==================== -->
  <section class="bg-neutral-200 w-full" id="apropos">
    <div class="max-w-360 mx-auto px-4 lg:px-20 pt-8 lg:pt-23.5 pb-6 lg:pb-16.25">

      <!-- Ligne intro -->
      <div class="flex flex-col lg:flex-row lg:items-start gap-4 lg:gap-0">
        <h3 class="text-neutral-800 m-0 w-full lg:w-82 lg:shrink-0 lg:mt-15.25">
          Comment ça fonctionne ? C'est très simple.
        </h3>
        <p class="text-neutral-500 m-0 w-full lg:w-165.5 lg:ml-54.75">
          BARGO est une plateforme web dédiée à l'organisation de barathons entre amis. Créez un groupe, sélectionnez vos établissements, attribuez un conducteur responsable et rythmez la soirée avec des défis intégrés.
        </p>
      </div>

      <!-- Steps -->
      <div class="grid grid-cols-1 lg:grid-cols-3 mt-8 lg:mt-37.75 gap-8 lg:gap-0">

        <!-- Step 1 -->
        <div class="flex">
          <span class="font-['Manrope'] font-bold text-15 lg:text-22.5 leading-none tracking-1.35 text-primary-500 w-20 lg:w-27.25 shrink-0">1</span>
          <div class="flex flex-col pt-2.5 lg:pt-3.75">
            <p class="text-neutral-800 leading-[1.4] m-0">Créez votre profil</p>
            <p class="text-neutral-500 text-3.5 leading-[1.1] mt-4 lg:mt-6 w-full lg:w-74 m-0">Inscrivez-vous en quelques secondes pour accéder à toutes les fonctionnalités. Personnalisez votre profil et préparez votre prochaine soirée entre amis.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex">
          <span class="font-['Manrope'] font-bold text-15 lg:text-22.5 leading-none tracking-1.35 text-primary-600 w-20 lg:w-27.25 shrink-0">2</span>
          <div class="flex flex-col pt-2.5 lg:pt-3.75">
            <p class="text-neutral-800 leading-[1.4] m-0">Invitez vos amis</p>
            <p class="text-neutral-500 text-3.5 leading-[1.1] mt-4 lg:mt-6 w-full lg:w-74 m-0">Ajoutez vos proches à votre groupe et formez votre équipe. Plus vous êtes nombreux, plus l'expérience devient conviviale et dynamique.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex">
          <span class="font-['Manrope'] font-bold text-15 lg:text-22.5 leading-none tracking-1.35 text-primary-900 w-20 lg:w-27.25 shrink-0">3</span>
          <div class="flex flex-col pt-2.5 lg:pt-3.75">
            <p class="text-neutral-800 leading-[1.4] m-0">Organisez votre tournée</p>
            <p class="text-neutral-500 text-3.5 leading-[1.1] mt-4 lg:mt-6 w-full lg:w-74 m-0">Sélectionnez les bars, définissez l'itinéraire et lancez votre session. Suivez la progression de la soirée et profitez d'un parcours structuré et ludique.</p>
          </div>
        </div>

      </div>

      <!-- H2 en bas -->
      <h2 class="text-neutral-800 mt-8 lg:mt-49 m-0 text-7.5 lg:text-12.5">Prêts à démarrer votre parcours ?</h2>

    </div>
  </section>

  <!-- ==================== BAR ==================== -->
  <section class="relative w-full h-125 lg:h-167.5 overflow-hidden" id="bars">

    <!-- Track -->
    <div id="bar-track" class="flex h-full" style={`width: ${bars.length * 100}%`}>
      {bars.map((bar) => (
        <div class="flex flex-col lg:flex-row h-full flex-none" style={`width: ${100 / bars.length}%`}>
          <!-- Image -->
          <div class="w-full h-50 lg:w-211.25 lg:h-full shrink-0 overflow-hidden">
            <PbImage record={bar} recordImage={bar.img?.[0]} width={845} height={670} />
          </div>
          <!-- Infos -->
          <div class="bg-neutral-800 flex-1 flex flex-col pt-5 lg:pt-19 pl-5 lg:pl-27.25 pr-5 lg:pr-20 overflow-hidden">
            <h2 class="text-white m-0 mb-3 lg:mb-8.75 text-7 lg:text-12.5">{bar.nom}</h2>
            <p class="text-neutral-200 text-3.5 leading-[1.1] m-0 mb-2 lg:mb-13">{bar.adresse}</p>
            <p class="text-white w-full lg:w-74.25 m-0 mb-4 lg:mb-25.75 line-clamp-2 lg:line-clamp-none">{bar.description}</p>
            <a href={`/bar/${bar.id}`} class="inline-flex items-center gap-2 lg:gap-4 px-6 lg:px-12 py-2 border-2 border-white text-white leading-[1.4] w-fit hover:bg-white hover:text-neutral-800 transition-colors text-3.5 lg:text-4">
              Choisir mes bars
              <img src={arrowRight.src} alt="" width="24" height="24" class="lg:hidden" />
              <img src={arrowRight.src} alt="" width="35" height="35" class="hidden lg:block" />
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Flèches navigation -->
    <div class="absolute bottom-5 lg:bottom-24.25 right-5 lg:right-20 flex gap-4.25 z-10">
      <button id="bar-prev" class="w-10.75 h-10.75" aria-label="Bar précédent">
        <img src={carouselGauche.src} alt="" width="43" height="43" />
      </button>
      <button id="bar-next" class="w-10.75 h-10.75" aria-label="Bar suivant">
        <img src={carouselDroit.src} alt="" width="43" height="43" />
      </button>
    </div>

  </section>

  <!-- ==================== JEUX ==================== -->

  <!-- Mobile -->
  <section class="block lg:hidden bg-neutral-200 px-4 pt-8 pb-0" id="jeux">
    <h3 class="text-neutral-800 m-0 mb-4">Des jeux pour animer la soirée</h3>
    <p class="text-neutral-500 m-0 mb-6">Parmi eux, des défis comme toucher son nez, tenir en équilibre quelques secondes, faire la planche sur une chaise ou répéter une phrase sans erreur, et bien d'autres jeux à relever en équipe.</p>
    <div class="grid grid-cols-2 gap-4">
      <div class="h-45 rounded-1.25 overflow-hidden">
        <Image src={jeux1} alt="Jeux en soirée" class="w-full h-full object-cover block" />
      </div>
      <div class="h-45 rounded-1.25 overflow-hidden">
        <Image src={jeux2} alt="Ambiance soirée" class="w-full h-full object-cover block" />
      </div>
      <div class="h-45 rounded-1.25 overflow-hidden">
        <Image src={jeux4} alt="Soirée entre amis" class="w-full h-full object-cover block" />
      </div>
      <div class="h-45 rounded-1.25 overflow-hidden">
        <Image src={jeux5} alt="Jeux de soirée" class="w-full h-full object-cover block" />
      </div>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden lg:block bg-neutral-200 pt-20 pb-0 relative w-full" id="jeux-desktop">
    <div class="max-w-360 mx-auto px-20">
      <div class="flex gap-8 items-start">

        <!-- Col 1 -->
        <div class="w-82 shrink-0 flex flex-col mt-10.75 pt-8.75 h-222.25">
          <h3 class="text-neutral-800 mb-26.5 m-0">Des jeux pour animer la soirée</h3>
          <p class="text-neutral-500 m-0">Parmi eux, des défis comme toucher son nez, tenir en équilibre quelques secondes, faire la planche sur une chaise ou répéter une phrase sans erreur, et bien d'autres jeux à relever en équipe.</p>
          <div class="w-full h-74.25 rounded-1.25 overflow-hidden mt-auto">
            <Image src={jeux4} alt="Soirée entre amis" class="w-full h-full object-cover block" />
          </div>
        </div>

        <!-- Col 2 -->
        <div class="flex flex-col gap-6 shrink-0 mt-10.75">
          <div class="w-128.75 h-111 rounded-1.25 overflow-hidden">
            <Image src={jeux1} alt="Jeux en soirée" class="w-full h-full object-cover block" />
          </div>
          <div class="w-128.75 h-105.25 rounded-1.25 overflow-hidden">
            <Image src={jeux5} alt="Jeux de soirée" class="w-full h-full object-cover block" />
          </div>
        </div>

        <!-- Col 3 -->
        <div class="flex flex-col gap-6 shrink-0 mt-10.75">
          <div class="w-74 h-81.25 rounded-1.25 overflow-hidden">
            <Image src={jeux2} alt="Ambiance soirée" class="w-full h-full object-cover block" />
          </div>
          <div class="w-74 h-55 rounded-1.25 overflow-hidden">
            <Image src={jeux3} alt="Fête jeux" class="w-full h-full object-cover block" />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== VALEURS ==================== -->
  <section class="bg-neutral-200 w-full">
    <div class="max-w-360 mx-auto px-4 lg:px-20 pt-8 lg:pt-20 pb-6 lg:pb-19.75">
      <h2 class="text-neutral-800 m-0 text-7.5 lg:text-12.5">Au rendez-vous</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 w-full">
      <div class="bg-primary-500 px-5 lg:px-20 pt-10 lg:pt-22.5 pb-8 lg:pb-16 flex flex-col gap-6 lg:gap-15.25">
        <h3 class="text-white m-0">Convivialité</h3>
        <p class="font-medium text-4 leading-[1.4] text-neutral-300 m-0">Nous plaçons l'expérience collective au cœur de chaque barathon. BARGO favorise les moments partagés, l'esprit d'équipe et la bonne ambiance afin que chaque sortie reste un souvenir positif entre amis.</p>
      </div>
      <div class="bg-primary-600 px-5 lg:px-20 pt-10 lg:pt-22.5 pb-8 lg:pb-16 flex flex-col gap-6 lg:gap-15.25">
        <h3 class="text-white m-0">Sécurité</h3>
        <p class="font-medium text-4 leading-[1.4] text-neutral-300 m-0">La sécurité fait partie intégrante de l'organisation. Attribution d'un conducteur pour la soirée, informations utiles et repères clairs permettent de profiter pleinement tout en gardant le contrôle.</p>
      </div>
      <div class="bg-primary-900 px-5 lg:px-20 pt-10 lg:pt-22.5 pb-8 lg:pb-16 flex flex-col gap-6 lg:gap-15.25">
        <h3 class="text-white m-0">Responsabilité</h3>
        <p class="font-medium text-4 leading-[1.4] text-neutral-300 m-0">Un barathon réussi est un barathon maîtrisé. BARGO encourage un comportement responsable et respectueux, pour soi, pour les autres et pour les établissements visités.</p>
      </div>
    </div>
  </section>

  <!-- ==================== EQUIPE ==================== -->
  <section class="bg-neutral-200 py-8 lg:py-20 w-full" id="equipe">
    <div class="max-w-360 mx-auto px-4 lg:px-20">

      <!-- Header équipe -->
      <div class="flex flex-col lg:flex-row lg:items-start mb-8 lg:mb-33.5 gap-4 lg:gap-0">
        <div class="w-full lg:w-191.25 lg:shrink-0">
          <h2 class="text-neutral-800 m-0 text-7.5 lg:text-12.5">Notre équipe</h2>
        </div>
        <p class="font-medium text-4 leading-[1.4] text-neutral-500 m-0 lg:pt-3.25 w-full lg:w-95.5">Derrière BARGO, une équipe passionnée par l'organisation d'expériences collectives. Nous avons imaginé une plateforme simple, structurée et conviviale pour faciliter vos sorties entre amis.</p>
      </div>

      <!-- Cards membres -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-7 mb-8 lg:mb-14">

        <div class="flex flex-col">
          <div class="w-full h-70 lg:h-123.75 rounded-2.5 overflow-hidden mb-6 lg:mb-13.5">
            <Image src={membre1} alt="Melvyn Philippon" class="w-full h-full object-cover block" />
          </div>
          <h3 class="text-primary-500 m-0 mb-4">Melvyn Philippon</h3>
          <p class="font-medium text-4 leading-[1.4] text-neutral-800 m-0 mb-4 lg:mb-10.75">Designer</p>
          <p class="font-medium text-3.5 leading-[1.1] text-neutral-500 m-0">Conçoit l'identité visuelle et l'expérience utilisateur. Il veille à la cohérence graphique et à la simplicité d'utilisation de la plateforme.</p>
        </div>

        <div class="flex flex-col">
          <div class="w-full h-70 lg:h-123.75 rounded-2.5 overflow-hidden mb-6 lg:mb-13.5">
            <Image src={membre2} alt="Pierre Mouilleseaux-Lhuillier" class="w-full h-full object-cover block" />
          </div>
          <h3 class="text-primary-500 m-0 mb-4">Pierre Mouilleseaux-Lhuillier</h3>
          <p class="font-medium text-4 leading-[1.4] text-neutral-800 m-0 mb-4 lg:mb-10.75">Développeur</p>
          <p class="font-medium text-3.5 leading-[1.1] text-neutral-500 m-0">Développe et structure la plateforme. Il transforme les idées en fonctionnalités concrètes et assure le bon fonctionnement du site.</p>
        </div>

        <div class="flex flex-col">
          <div class="w-full h-70 lg:h-123.75 rounded-2.5 overflow-hidden mb-6 lg:mb-13.5">
            <Image src={membre3} alt="Alex Ringenbach" class="w-full h-full object-cover block" />
          </div>
          <h3 class="text-primary-500 m-0 mb-4">Alex Ringenbach</h3>
          <p class="font-medium text-4 leading-[1.4] text-neutral-800 m-0 mb-4 lg:mb-10.75">Communication</p>
          <p class="font-medium text-3.5 leading-[1.1] text-neutral-500 m-0">Gère l'image et la visibilité du projet. Il s'occupe de la stratégie de communication et du lien avec la communauté.</p>
        </div>

      </div>

      <!-- CTA -->
      <div class="flex justify-end">
        <a href="/Apropos" class="inline-flex items-center gap-4 px-12 py-2 bg-neutral-800 text-white font-medium text-4 leading-[1.4] hover:opacity-80 transition-opacity">
          En savoir plus
          <img src={arrowRight.src} alt="" width="35" height="35" />
        </a>
      </div>

    </div>
  </section>

  <!-- ==================== PARTENAIRES ==================== -->
  <Partenaires />

  <Faq items={faqItems} />

</Layout>

<script>
  import '../js/carousel.js';
</script>
