---
// @ts-nocheck
import Layout from '../layouts/Layout.astro';
import { PB_URL } from '../js/backend.js';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

const usersRes  = await fetch(`${PB_URL}/api/collections/users/records?perPage=200&sort=pseudo`, {
  headers: { Authorization: `Bearer ${token}` }
});
const usersData = usersRes.ok ? await usersRes.json() : { items: [] };
const allUsers  = (usersData.items ?? [])
  .filter(u => u.id !== userId)
  .map(u => ({ id: u.id, collectionName: u.collectionName, pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '', avatar: u.avatar ?? null }));
---

<Layout title="Bienvenue sur Bargo" noFooter={true}>

<div class="flex flex-col lg:flex-row" style="min-height: calc(100vh - 92px);">

  <!-- ===== LEFT PANEL ===== -->
  <div class="hidden lg:flex lg:w-164.25 lg:shrink-0 bg-primary-900 flex-col" style="height: calc(100vh - 92px); position: sticky; top: 92px;">

    <!-- Title zone -->
    <div class="px-20 pt-18.75">
      <p style="font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:3px; color:#72c073; margin:0 0 20px 0;">Compléter mon profil</p>
      <h1 id="left-title" class="text-white m-0 uppercase leading-none" style="font-size:50px; letter-spacing:3px; word-break:break-word;">Photo de<br>profil</h1>
    </div>

    <div class="flex-1"></div>

    <!-- Step indicators -->
    <div class="px-20 mb-5">
      <div class="flex items-center">
        <div class="step-circle flex items-center justify-center w-12.5 h-12.5 rounded-full border-2 shrink-0 transition-all duration-400" data-step="1"
          style="background:white; border-color:white;">
          <span class="step-num font-bold" style="font-size:18px; color:#094736;">1</span>
          <svg class="step-check" style="display:none; width:20px; height:20px; color:white;" viewBox="0 0 18 18" fill="none">
            <path d="M3.5 9L7.5 13L14.5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="step-line flex-1 mx-2 transition-all duration-400" style="height:5px; background:rgba(255,255,255,0.25); border-radius:100px;"></div>
        <div class="step-circle flex items-center justify-center w-12.5 h-12.5 rounded-full border-2 shrink-0 transition-all duration-400" data-step="2"
          style="background:transparent; border-color:rgba(255,255,255,0.3);">
          <span class="step-num font-bold" style="font-size:18px; color:rgba(255,255,255,0.3);">2</span>
          <svg class="step-check" style="display:none; width:20px; height:20px; color:white;" viewBox="0 0 18 18" fill="none">
            <path d="M3.5 9L7.5 13L14.5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="step-line flex-1 mx-2 transition-all duration-400" style="height:5px; background:rgba(255,255,255,0.25); border-radius:100px;"></div>
        <div class="step-circle flex items-center justify-center w-12.5 h-12.5 rounded-full border-2 shrink-0 transition-all duration-400" data-step="3"
          style="background:transparent; border-color:rgba(255,255,255,0.3);">
          <span class="step-num font-bold" style="font-size:18px; color:rgba(255,255,255,0.3);">3</span>
          <svg class="step-check" style="display:none; width:20px; height:20px; color:white;" viewBox="0 0 18 18" fill="none">
            <path d="M3.5 9L7.5 13L14.5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="step-line flex-1 mx-2 transition-all duration-400" style="height:5px; background:rgba(255,255,255,0.25); border-radius:100px;"></div>
        <div class="step-circle flex items-center justify-center w-12.5 h-12.5 rounded-full border-2 shrink-0 transition-all duration-400" data-step="4"
          style="background:transparent; border-color:rgba(255,255,255,0.3);">
          <span class="step-num font-bold" style="font-size:18px; color:rgba(255,255,255,0.3);">4</span>
          <svg class="step-check" style="display:none; width:20px; height:20px; color:white;" viewBox="0 0 18 18" fill="none">
            <path d="M3.5 9L7.5 13L14.5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Progress bar -->
    <div class="px-20 mb-15">
      <div class="h-3.75 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.2);">
        <div id="progress-bar" class="h-full rounded-full transition-all duration-500" style="width:0%; background:#72c073;"></div>
      </div>
    </div>
  </div>

  <!-- ===== RIGHT PANEL ===== -->
  <div class="flex-1 bg-neutral-800 overflow-y-auto">

    <!-- ─── STEP 1 : Avatar ─── -->
    <div id="panel-1" class="flex flex-col px-5 lg:px-17.5 py-10 lg:py-14" style="min-height: calc(100vh - 92px);">
      <h3 class="text-white m-0 mb-2" style="font-size:25px; font-weight:500; letter-spacing:-1px;">Votre photo de profil</h3>
      <p style="color:#BDBDBD; font-size:14px; font-weight:500; margin:0 0 40px 0; line-height:1.5;">Choisissez une photo pour que vos amis vous reconnaissent. Vous pourrez la modifier à tout moment.</p>

      <div class="flex flex-col items-start gap-4 flex-1">
        <label class="cursor-pointer group relative">
          <div id="avatar-preview" class="w-36 h-36 rounded-full overflow-hidden flex flex-col items-center justify-center transition-all duration-300"
            style="background:#2c2c2c; border:2px dashed rgba(255,255,255,0.25);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <span style="font-size:12px; font-weight:500; margin-top:6px; color:rgba(255,255,255,0.3);">Photo</span>
          </div>
          <div class="absolute inset-0 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200"
            style="background:rgba(9,71,54,0.8);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
          </div>
          <input id="avatar-input" type="file" accept="image/*" class="hidden" />
        </label>
        <p style="color:rgba(255,255,255,0.35); font-size:13px; font-weight:500; margin:0;">JPG, PNG — max 5 Mo</p>
      </div>

      <!-- Footer step -->
      <div class="flex items-center justify-between gap-4 mt-10 pt-8" style="border-top:1px solid rgba(255,255,255,0.1);">
        <a href="/profil" style="color:rgba(255,255,255,0.4); font-size:14px; font-weight:500; text-decoration:none;" class="hover:opacity-70 transition-opacity">
          Passer cette étape
        </a>
        <button onclick="window.saveAndNext(1)"
          class="flex items-center gap-2 text-white font-medium hover:opacity-90 transition-opacity cursor-pointer border-0"
          style="background:#094736; height:50px; padding:0 32px; font-size:14px; border-radius:4px;">
          Continuer
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- ─── STEP 2 : Infos ─── -->
    <div id="panel-2" class="hidden flex-col px-5 lg:px-17.5 py-10 lg:py-14" style="min-height: calc(100vh - 92px);">
      <h3 class="text-white m-0 mb-2" style="font-size:25px; font-weight:500; letter-spacing:-1px;">Parlez-nous de vous</h3>
      <p style="color:#BDBDBD; font-size:14px; font-weight:500; margin:0 0 40px 0; line-height:1.5;">Ces informations apparaîtront sur votre profil public.</p>

      <div class="flex flex-col gap-7 flex-1">

        <!-- Prénom + Nom -->
        <div class="flex gap-5">
          <div class="flex-1">
            <div class="flex items-center gap-2.5 mb-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span style="font-size:16px; font-weight:700; color:white;">Prénom</span>
            </div>
            <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); height:61px; display:flex; align-items:center; padding:0 20px;">
              <input id="f-prenom" type="text" placeholder="Jean"
                style="background:transparent; width:100%; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e;"
                class="placeholder-neutral-500" />
            </div>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2.5 mb-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span style="font-size:16px; font-weight:700; color:white;">Nom</span>
            </div>
            <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); height:61px; display:flex; align-items:center; padding:0 20px;">
              <input id="f-nom" type="text" placeholder="Dupont"
                style="background:transparent; width:100%; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e;"
                class="placeholder-neutral-500" />
            </div>
          </div>
        </div>

        <!-- Âge + Ville -->
        <div class="flex gap-5">
          <div class="flex-1">
            <div class="flex items-center gap-2.5 mb-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              <span style="font-size:16px; font-weight:700; color:white;">Âge</span>
            </div>
            <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); height:61px; display:flex; align-items:center; padding:0 20px;">
              <input id="f-age" type="number" min="18" max="99" placeholder="25"
                style="background:transparent; width:100%; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e;"
                class="placeholder-neutral-500" />
            </div>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2.5 mb-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
              <span style="font-size:16px; font-weight:700; color:white;">Ville</span>
            </div>
            <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); height:61px; display:flex; align-items:center; padding:0 20px;">
              <input id="f-ville" type="text" placeholder="Montbéliard"
                style="background:transparent; width:100%; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e;"
                class="placeholder-neutral-500" />
            </div>
          </div>
        </div>

      </div>

      <!-- Footer step -->
      <div class="flex items-center justify-between gap-4 mt-10 pt-8" style="border-top:1px solid rgba(255,255,255,0.1);">
        <button onclick="window.skipStep(2)" style="color:rgba(255,255,255,0.4); font-size:14px; font-weight:500; background:transparent; border:none; cursor:pointer; padding:0;" class="hover:opacity-70 transition-opacity">
          Passer cette étape
        </button>
        <button onclick="window.saveAndNext(2)"
          class="flex items-center gap-2 text-white font-medium hover:opacity-90 transition-opacity cursor-pointer border-0"
          style="background:#094736; height:50px; padding:0 32px; font-size:14px; border-radius:4px;">
          Continuer
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- ─── STEP 3 : Bio & Réseaux ─── -->
    <div id="panel-3" class="hidden flex-col px-5 lg:px-17.5 py-10 lg:py-14" style="min-height: calc(100vh - 92px);">
      <h3 class="text-white m-0 mb-2" style="font-size:25px; font-weight:500; letter-spacing:-1px;">Votre univers</h3>
      <p style="color:#BDBDBD; font-size:14px; font-weight:500; margin:0 0 40px 0; line-height:1.5;">Ajoutez une bio et vos réseaux pour que vos amis vous retrouvent facilement.</p>

      <div class="flex flex-col gap-7 flex-1">

        <!-- Description -->
        <div>
          <div class="flex items-center gap-2.5 mb-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span style="font-size:16px; font-weight:700; color:white;">Description</span>
          </div>
          <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); padding:16px 20px;">
            <textarea id="f-description" rows="3" placeholder="Passionné de soirées et de bonne ambiance…"
              style="background:transparent; width:100%; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e; resize:none; line-height:1.6;"
              class="placeholder-neutral-500"></textarea>
          </div>
        </div>

        <!-- Instagram + Facebook -->
        <div class="flex gap-5">
          <div class="flex-1">
            <div class="flex items-center gap-2.5 mb-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="white" stroke="none"/></svg>
              <span style="font-size:16px; font-weight:700; color:white;">Instagram</span>
            </div>
            <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); height:61px; display:flex; align-items:center; padding:0 20px; gap:4px;">
              <span style="font-size:14px; font-weight:500; color:#646262;">@</span>
              <input id="f-insta" type="text" placeholder="votre_pseudo"
                style="background:transparent; flex:1; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e;"
                class="placeholder-neutral-500" />
            </div>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2.5 mb-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
              <span style="font-size:16px; font-weight:700; color:white;">Facebook</span>
            </div>
            <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); height:61px; display:flex; align-items:center; padding:0 20px;">
              <input id="f-facbook" type="text" placeholder="Nom Facebook"
                style="background:transparent; width:100%; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e;"
                class="placeholder-neutral-500" />
            </div>
          </div>
        </div>

        <!-- Discord -->
        <div class="lg:w-1/2">
          <div class="flex items-center gap-2.5 mb-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M20.317 4.492c-1.53-.69-3.17-1.2-4.885-1.49a.075.075 0 00-.079.036c-.21.369-.444.85-.608 1.23a18.566 18.566 0 00-5.487 0 12.36 12.36 0 00-.617-1.23A.077.077 0 008.562 3c-1.714.29-3.354.8-4.885 1.491a.07.07 0 00-.032.027C.533 9.093-.32 13.555.099 17.961a.08.08 0 00.031.055 20.03 20.03 0 005.993 2.98.078.078 0 00.084-.026 13.36 13.36 0 001.226-1.963.074.074 0 00-.041-.104 13.201 13.201 0 01-1.872-.878.075.075 0 01-.008-.125c.126-.093.252-.19.372-.287a.075.075 0 01.078-.01c3.927 1.764 8.18 1.764 12.061 0a.075.075 0 01.079.009c.12.098.245.195.372.288a.075.075 0 01-.006.125c-.598.344-1.22.635-1.873.877a.075.075 0 00-.041.105c.36.687.772 1.341 1.225 1.962a.077.077 0 00.084.028 19.963 19.963 0 006.002-2.981.076.076 0 00.032-.054c.5-5.094-.838-9.52-3.549-13.442a.06.06 0 00-.031-.03z"/></svg>
            <span style="font-size:16px; font-weight:700; color:white;">Discord</span>
          </div>
          <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); height:61px; display:flex; align-items:center; padding:0 20px;">
            <input id="f-discord" type="text" placeholder="pseudo#0000"
              style="background:transparent; width:100%; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e;"
              class="placeholder-neutral-500" />
          </div>
        </div>

      </div>

      <!-- Footer step -->
      <div class="flex items-center justify-between gap-4 mt-10 pt-8" style="border-top:1px solid rgba(255,255,255,0.1);">
        <button onclick="window.skipStep(3)" style="color:rgba(255,255,255,0.4); font-size:14px; font-weight:500; background:transparent; border:none; cursor:pointer; padding:0;" class="hover:opacity-70 transition-opacity">
          Passer cette étape
        </button>
        <button onclick="window.saveAndNext(3)"
          class="flex items-center gap-2 text-white font-medium hover:opacity-90 transition-opacity cursor-pointer border-0"
          style="background:#094736; height:50px; padding:0 32px; font-size:14px; border-radius:4px;">
          Continuer
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <!-- ─── STEP 4 : Amis ─── -->
    <div id="panel-4" class="hidden flex-col px-5 lg:px-17.5 py-10 lg:py-14" style="min-height: calc(100vh - 92px);">
      <h3 class="text-white m-0 mb-2" style="font-size:25px; font-weight:500; letter-spacing:-1px;">Ajouter des amis</h3>
      <p style="color:#BDBDBD; font-size:14px; font-weight:500; margin:0 0 40px 0; line-height:1.5;">Retrouvez vos proches déjà inscrits sur Bargo et connectez-vous avec eux.</p>

      <div class="flex flex-col gap-5 flex-1">

        <!-- Search bar -->
        <div style="background:#f7f1ed; border-radius:5px; box-shadow:0 4px 10px rgba(0,0,0,0.25); height:61px; display:flex; align-items:center; padding:0 20px; gap:12px;">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <circle cx="7.5" cy="7.5" r="5.5" stroke="#646262" stroke-width="1.5"/>
            <path d="M12 12L16 16" stroke="#646262" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <input id="ami-search" type="text" placeholder="Rechercher par pseudo…"
            style="background:transparent; flex:1; font-size:14px; font-weight:500; outline:none; border:none; color:#1e1e1e;"
            class="placeholder-neutral-500" />
        </div>

        <!-- Chips sélectionnés -->
        <div id="ami-chips" class="flex flex-wrap gap-2 min-h-6"></div>

        <!-- Liste -->
        <div id="ami-list" class="flex flex-col gap-2"></div>

      </div>

      <!-- Footer step -->
      <div class="flex items-center justify-between gap-4 mt-10 pt-8" style="border-top:1px solid rgba(255,255,255,0.1);">
        <button onclick="window.skipStep(4)" style="color:rgba(255,255,255,0.4); font-size:14px; font-weight:500; background:transparent; border:none; cursor:pointer; padding:0;" class="hover:opacity-70 transition-opacity">
          Passer cette étape
        </button>
        <button onclick="window.saveAndNext(4)"
          class="flex items-center gap-2 text-white font-medium hover:opacity-90 transition-opacity cursor-pointer border-0"
          style="background:#094736; height:50px; padding:0 32px; font-size:14px; border-radius:4px;">
          Terminer ✓
        </button>
      </div>
    </div>

  </div><!-- end right panel -->
</div>

</Layout>

<script is:inline define:vars={{ pbUrl: PB_URL, pbToken: token, pbUserId: userId, allUsers: allUsers }}>
(function () {
  var TOTAL        = 4;
  var cur          = 1;
  var selectedAmis = [];
  var avatarFile   = null;

  var leftTitles = ['Photo de<br>profil', 'Informations<br>personnelles', 'Bio &amp;<br>Réseaux', 'Vos<br>amis'];

  function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function $(id) { return document.getElementById(id); }

  // ── Progress ─────────────────────────────────────────────
  function updateProgress(n) {
    cur = n;

    var lt = $('left-title');
    if (lt) lt.innerHTML = leftTitles[n - 1];

    var pct = ((n - 1) / TOTAL) * 100;
    var bar = $('progress-bar');
    if (bar) bar.style.width = pct + '%';

    document.querySelectorAll('.step-circle').forEach(function (el) {
      var s = parseInt(el.dataset.step);
      var num = el.querySelector('.step-num');
      var chk = el.querySelector('.step-check');
      if (s < n) {
        el.style.background = '#72c073';
        el.style.borderColor = '#72c073';
        if (num) num.style.display = 'none';
        if (chk) chk.style.display = 'block';
      } else if (s === n) {
        el.style.background = 'white';
        el.style.borderColor = 'white';
        if (num) { num.style.display = 'block'; num.style.color = '#094736'; }
        if (chk) chk.style.display = 'none';
      } else {
        el.style.background = 'transparent';
        el.style.borderColor = 'rgba(255,255,255,0.3)';
        if (num) { num.style.display = 'block'; num.style.color = 'rgba(255,255,255,0.3)'; }
        if (chk) chk.style.display = 'none';
      }
    });

    var lines = document.querySelectorAll('.step-line');
    lines.forEach(function (line, i) {
      line.style.background = i < n - 1 ? '#72c073' : 'rgba(255,255,255,0.25)';
    });
  }

  function showPanel(n) {
    for (var i = 1; i <= TOTAL; i++) {
      var p = $('panel-' + i);
      if (p) {
        if (i === n) {
          p.classList.remove('hidden');
          p.style.display = 'flex';
        } else {
          p.classList.add('hidden');
          p.style.display = 'none';
        }
      }
    }
    updateProgress(n);
    window.scrollTo(0, 0);
  }

  // ── Avatar ──────────────────────────────────────────────
  var avatarInput = $('avatar-input');
  if (avatarInput) {
    avatarInput.addEventListener('change', function () {
      var file = this.files[0];
      if (!file) return;
      avatarFile = file;
      var reader = new FileReader();
      reader.onload = function (e) {
        var preview = $('avatar-preview');
        preview.innerHTML = '<img src="' + e.target.result + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />';
        preview.style.border = '2px solid #72c073';
      };
      reader.readAsDataURL(file);
    });
  }

  // ── API ─────────────────────────────────────────────────
  async function patchUser(data) {
    try {
      await fetch(pbUrl + '/api/collections/users/records/' + pbUserId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pbToken },
        body: JSON.stringify(data),
      });
    } catch (_) {}
  }

  async function uploadAvatar() {
    if (!avatarFile) return;
    try {
      var fd = new FormData();
      fd.append('avatar', avatarFile);
      await fetch(pbUrl + '/api/collections/users/records/' + pbUserId, {
        method: 'PATCH', headers: { Authorization: 'Bearer ' + pbToken }, body: fd,
      });
    } catch (_) {}
  }

  // ── Save & Next ─────────────────────────────────────────
  window.saveAndNext = async function (step) {
    if (step === 1) await uploadAvatar();
    if (step === 2) {
      var d = {};
      var prenom = ($('f-prenom') ? $('f-prenom').value : '').trim(); if (prenom) d.prenom = prenom;
      var nom    = ($('f-nom')    ? $('f-nom').value    : '').trim(); if (nom)    d.nom    = nom;
      var age    = parseInt(($('f-age') ? $('f-age').value : '0')) || null; if (age && age >= 18) d.age = age;
      var ville  = ($('f-ville')  ? $('f-ville').value  : '').trim(); if (ville)  d.ville  = ville;
      if (Object.keys(d).length) await patchUser(d);
    }
    if (step === 3) {
      var d2 = {};
      var desc    = ($('f-description') ? $('f-description').value : '').trim(); if (desc)    d2.description = desc;
      var insta   = ($('f-insta')       ? $('f-insta').value       : '').trim(); if (insta)   d2.insta       = insta;
      var facbook = ($('f-facbook')     ? $('f-facbook').value     : '').trim(); if (facbook) d2.facbook     = facbook;
      var discord = ($('f-discord')     ? $('f-discord').value     : '').trim(); if (discord) d2.discord     = discord;
      if (Object.keys(d2).length) await patchUser(d2);
    }
    if (step === 4) {
      if (selectedAmis.length) await patchUser({ amies: selectedAmis });
      window.location.href = '/profil';
      return;
    }
    showPanel(step + 1);
  };

  window.skipStep = function (step) {
    if (step >= TOTAL) { window.location.href = '/profil'; return; }
    showPanel(step + 1);
  };

  // ── Amis ────────────────────────────────────────────────
  function imgUrl(u) {
    return u.avatar ? pbUrl + '/api/files/' + u.collectionName + '/' + u.id + '/' + u.avatar : null;
  }
  function av(u, size) {
    size = size || 36;
    var url = imgUrl(u);
    if (url) return '<img src="' + url + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />';
    var l = (u.pseudo || u.prenom || '?').charAt(0).toUpperCase();
    return '<div style="width:100%;height:100%;background:#094736;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:' + Math.round(size * 0.38) + 'px;">' + esc(l) + '</div>';
  }

  function renderChips() {
    var el = $('ami-chips');
    if (!el) return;
    el.innerHTML = selectedAmis.map(function (id) {
      var u = allUsers.find(function (x) { return x.id === id; });
      if (!u) return '';
      return '<span style="display:inline-flex;align-items:center;gap:5px;background:#094736;color:white;font-size:12px;font-weight:500;padding:3px 10px 3px 4px;border-radius:20px;">' +
        '<span style="width:22px;height:22px;border-radius:50%;overflow:hidden;flex-shrink:0;">' + av(u, 22) + '</span>' +
        esc(u.pseudo || u.prenom || 'User') +
        '<button data-rid="' + id + '" style="background:transparent;border:none;color:rgba(255,255,255,0.55);cursor:pointer;font-size:15px;padding:0;line-height:1;margin-left:1px;">×</button>' +
      '</span>';
    }).join('');
    el.querySelectorAll('[data-rid]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectedAmis = selectedAmis.filter(function (id) { return id !== btn.dataset.rid; });
        renderChips();
        var s = $('ami-search'); renderList(s ? s.value : '');
      });
    });
  }

  function renderList(q) {
    var el = $('ami-list');
    if (!el) return;
    q = (q || '').toLowerCase();
    var filtered = allUsers.filter(function (u) {
      return !q || (u.pseudo + ' ' + u.prenom + ' ' + u.nom).toLowerCase().includes(q);
    }).slice(0, 12);

    el.innerHTML = filtered.map(function (u) {
      var sel = selectedAmis.indexOf(u.id) >= 0;
      return '<div style="display:flex;align-items:center;gap:12px;background:#2c2c2c;border-radius:6px;padding:10px 14px;">' +
        '<div style="width:40px;height:40px;flex-shrink:0;border-radius:50%;overflow:hidden;">' + av(u, 40) + '</div>' +
        '<p style="color:white;font-size:14px;font-weight:500;margin:0;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(u.pseudo || (u.prenom + ' ' + u.nom).trim() || 'Utilisateur') + '</p>' +
        '<button data-uid="' + u.id + '" style="flex-shrink:0;height:32px;padding:0 14px;font-size:12px;font-weight:600;border:none;cursor:pointer;border-radius:20px;transition:all 0.15s;background:' + (sel ? '#72c073' : '#094736') + ';color:' + (sel ? '#094736' : 'white') + ';">' + (sel ? '✓ Ajouté' : '+ Ajouter') + '</button>' +
      '</div>';
    }).join('') || '<p style="color:rgba(255,255,255,0.3);font-size:13px;margin:0;">Aucun résultat.</p>';

    el.querySelectorAll('[data-uid]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var uid = btn.dataset.uid;
        var idx = selectedAmis.indexOf(uid);
        if (idx >= 0) selectedAmis.splice(idx, 1); else selectedAmis.push(uid);
        renderChips();
        var s = $('ami-search'); renderList(s ? s.value : '');
      });
    });
  }

  var amiSearch = $('ami-search');
  if (amiSearch) amiSearch.addEventListener('input', function () { renderList(this.value); });

  showPanel(1);
  renderList('');
})();
</script>
