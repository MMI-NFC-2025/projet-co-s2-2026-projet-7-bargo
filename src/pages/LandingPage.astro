        <button id="lp-mob-prev" aria-label="Précédent" class="absolute left-[18px] top-[357px] w-[31px] h-[31px] bg-black border-0 rounded-[100px] cursor-pointer flex items-center justify-center">
          <svg width="10" height="10" viewBox="0 0 14 14" fill="none"><path d="M9 11L4 7L9 3" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button id="lp-mob-next" aria-label="Suivant" class="absolute left-[64px] top-[357px] w-[31px] h-[31px] bg-[#646262] border-0 rounded-[100px] cursor-pointer flex items-center justify-center">
          <svg width="10" height="10" viewBox="0 0 14 14" fill="none"><path d="M5 3L10 7L5 11" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <a id="lp-mob-link" href={`/bar/${barsData[0].id}`} class="absolute right-0 top-[353px] w-[162px] h-[40px] bg-[#1e1e1e] inline-flex items-center justify-center text-white text-sm font-medium no-underline">En savoir plus</a>
      </div>

      <!-- Nom du bar -->
      <h2 id="lp-mob-nom" class="absolute top-[700px] left-[25px] text-white text-[35px] tracking-[2px] leading-[1.1] w-[300px]">{barsData[0].nom}</h2>
    </div>

  </section>
)}

<!-- ========== VALEURS CAROUSEL ========== -->
<section id="vision" class="relative w-full h-[736px] lg:h-[761px] overflow-hidden bg-white">

  <h2 id="lp-values-h2"
