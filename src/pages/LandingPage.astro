    </button>
    <button id="lp-bar-next" aria-label="Bar suivant" class="hidden lg:flex absolute left-[1064px] top-[708px] w-[65px] h-[65px] bg-transparent border-0 cursor-pointer items-center justify-center z-10">
      <div class="absolute w-[46px] h-[46px] bg-[#f7f1ed] opacity-50 rounded-[100px]"></div>
      <svg class="relative z-[1]" width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M7 4L12 9L7 14" stroke="#1e1e1e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <p id="lp-bar-counter" class="hidden lg:block absolute left-[1234px] top-[725px] text-[#f7f1ed] text-base font-medium leading-[1.4] whitespace-nowrap z-10">1 / {barsData.length}</p>
    <div class="hidden lg:block absolute left-[157px] top-0 w-px h-[270px] bg-[rgba(247,241,237,0.35)] z-10"></div>
    <div class="hidden lg:block absolute left-[157px] top-[527px] w-px bottom-0 bg-[rgba(247,241,237,0.35)] z-10"></div>

    <!-- Mobile: carte bar -->
    <div class="block lg:hidden absolute inset-0">
      <!-- Image de fond (moitié basse) -->
      <div class="absolute left-0 top-[524px] w-full h-[278px] overflow-hidden">
