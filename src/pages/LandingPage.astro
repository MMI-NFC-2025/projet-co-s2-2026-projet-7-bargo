        <div class="absolute left-[328px] top-[156px] w-[438px] h-[505px] rounded-r-[10px] overflow-hidden shadow-[-15px_15px_30px_0px_rgba(0,0,0,0.25)]">
          <img id="lp-img-a" src={barsData[0].cardImgUrl} alt="" class="w-full h-full object-cover block" />
        </div>
      </div>
      <div id="lp-card-b" class="absolute left-0 top-0 w-full h-full -translate-x-full">
        <div class="absolute left-0 top-[156px] w-[328px] h-[505px] bg-white rounded-l-[10px] shadow-[-15px_15px_30px_0px_rgba(0,0,0,0.15)]"></div>
        <p id="lp-adr-b"  class="absolute left-[78px] top-[214px] w-[218px] text-base font-medium leading-[1.4] text-black"></p>
