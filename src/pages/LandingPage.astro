---
// @ts-nocheck
import { Image } from 'astro:assets';
import { getCollection, getImageUrl } from '../js/backend.js';

import logoDark      from '../assets/icon/logo-dark.svg';
import logoLight     from '../assets/icon/logo-light.svg';
import iconFb        from '../assets/icon/facebook.svg';
import iconInsta     from '../assets/icon/insta.svg';
import iconDiscord   from '../assets/icon/discord.svg';

import heroImg     from '../assets/img/landing_page_hero.avif';
import cotelImg    from '../assets/img/cotel.avif';
import carouselImg from '../assets/img/img_carousle-1.avif';
import footerBg    from '../assets/img/footer.avif';
import membre1     from '../assets/img/melvyn_philippon.avif';
import membre2     from '../assets/img/pierre_mouilleseaux_lhuillier.avif';
import membre3     from '../assets/img/alex_ringenbach.avif';

import '../styles/global.css';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (token && userId) return Astro.redirect('/');

const bars = await getCollection('bar', { sort: 'created' });

function truncate15(text) {
  if (!text) return '';
  const words = text.trim().split(/\s+/);
  if (words.length <= 15) return text;
  return words.slice(0, 15).join(' ') + '\u2026';
}

const barsData = bars.map(bar => ({
  id:          bar.id,
  nom:         bar.nom ?? '',
  adresse:     bar.adresse ?? '',
  description: truncate15(bar.description),
  parallaxUrl: bar.galerie?.[0]
    ? getImageUrl(bar, bar.galerie[0])
    : (bar.img?.[0] ? getImageUrl(bar, bar.img[0]) : ''),
  cardImgUrl: bar.img?.[0] ? getImageUrl(bar, bar.img[0]) : '',
}));

const valeurs = [
  {
    titre: 'Convivialité',
    texte: "Bargo favorise les moments de partage entre amis. La plateforme est pensée pour rendre les sorties plus simples, agréables et collectives.",
  },
  {
    titre: 'Sécurité',
    texte: "La sécurité est au cœur du projet Bargo. La plateforme aide les utilisateurs à organiser leurs sorties tout en facilitant un retour plus serein après la soirée.",
  },
  {
    titre: 'Responsabilité',
    texte: "Le projet encourage une approche responsable des sorties. Bargo propose des outils qui aident les utilisateurs à mieux anticiper leurs déplacements et leurs décisions.",
  },
];
const valeursImages = [cotelImg, heroImg, carouselImg];
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bargo — Sortez organisés, rentrez en sécurité</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700&family=Manrope:wght@500;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.svg" sizes="any" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 16px; line-height: 1.4; background: #f7f1ed; }
    h1 { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 90px; line-height: 1; letter-spacing: 5.4px; }
    h2 { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 50px; line-height: 1; letter-spacing: 3px; }
    h3 { font-family: 'Manrope', sans-serif; font-weight: 500; font-size: 25px; line-height: 1.4; letter-spacing: -1px; }
  </style>
</head>
<body>

<!-- ========== HEADER ========== -->
<header style="position:fixed;top:0;left:0;width:100%;z-index:50;background:#fff;height:92px;box-shadow:0px 4px 4px 0px rgba(0,0,0,0.25);">
  <div style="max-width:1440px;margin:0 auto;padding:0 80px;height:92px;display:flex;align-items:center;">
    <a href="/LandingPage" style="flex-shrink:0;">
      <img src={logoDark.src} alt="Bargo" style="height:42px;width:auto;display:block;" />
    </a>
    <nav style="display:flex;align-items:center;margin-left:52px;">
      <a href="#produit" style="padding:25px 35px;font-weight:500;font-size:14px;line-height:1.1;color:#000;text-decoration:none;white-space:nowrap;">Produit</a>
      <a href="#bars"    style="padding:25px 35px;font-weight:500;font-size:14px;line-height:1.1;color:#000;text-decoration:none;white-space:nowrap;">Bars</a>
      <a href="#vision"  style="padding:25px 35px;font-weight:500;font-size:14px;line-height:1.1;color:#000;text-decoration:none;white-space:nowrap;">Vision</a>
      <a href="#equipe"  style="padding:25px 35px;font-weight:500;font-size:14px;line-height:1.1;color:#000;text-decoration:none;white-space:nowrap;">Équipe</a>
    </nav>
    <div style="flex:1;"></div>
    <a href="/connexion" style="display:inline-flex;align-items:center;justify-content:center;padding:0 50px;height:45px;background:#000;color:#fff;font-weight:500;font-size:14px;line-height:1.1;text-decoration:none;white-space:nowrap;">
      INSCRIPTION
    </a>
  </div>
</header>

<!-- ========== HERO (685px total, 92px behind header) ========== -->
<section style="position:relative;width:100%;height:685px;overflow:hidden;">
  <!-- Background image -->
  <Image src={heroImg} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
  <!-- Overlay -->
  <div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(30,30,30,0.7),#1e1e1e);"></div>

  <!-- H1: center at top:309px (equiv to 309px from section top, 217px below header) -->
  <h1 style="position:absolute;top:309px;transform:translateY(-50%);left:80px;width:1038px;color:#fff;text-transform:uppercase;">
    Sortez organisés rentrez en sécurité
  </h1>

  <!-- Description: top:521px -->
  <p style="position:absolute;top:521px;left:80px;width:515px;font-size:16px;font-weight:500;line-height:1.4;color:#fff;">
    Bargo est la première plateforme qui simplifie l'organisation des soirées entre amis tout en garantissant un retour sécurisé à la maison.
  </p>

  <!-- CTA button: top:544px, left:calc(75%-16px)≈1064px -->
  <a href="/connexion" style="position:absolute;top:544px;left:calc(75% - 16px);width:296px;height:60px;background:#347645;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:16px;text-decoration:none;">
    Découvrir Bargo
  </a>
</section>

<!-- ========== CE QUE BARGO PERMET (h:1153px) ========== -->
<section id="produit" style="position:relative;width:100%;height:1153px;background:#fff;overflow:hidden;">

  <!-- H2: top:157px from section top -->
  <h2 style="position:absolute;top:157px;left:80px;width:508px;color:#000;">Ce que Bargo permet de faire</h2>

  <!-- Right image: top:157px, left:736px, w:704px, h:862px -->
  <div style="position:absolute;top:157px;left:736px;width:704px;height:862px;border-radius:0 0 10px 10px;overflow:hidden;">
    <Image src={cotelImg} alt="Soirée Bargo" style="width:100%;height:100%;object-fit:cover;display:block;" />
  </div>

  <!-- Features list: top:334px, left:80px, w:516px -->
  <div style="position:absolute;top:334px;left:80px;width:516px;display:flex;flex-direction:column;gap:59px;">

    <div style="display:flex;flex-direction:column;gap:26px;">
      <h3 style="color:#000;">Planifiez votre soirée facilement</h3>
      <p style="color:#646262;font-size:16px;font-weight:500;line-height:1.4;">Créez une sortie en quelques clics. Choisissez les bars, définissez l'ordre des étapes et préparez votre parcours pour la soirée.</p>
    </div>

    <div style="display:flex;flex-direction:column;gap:26px;">
      <h3 style="color:#000;">Invitez vos amis</h3>
      <p style="color:#646262;font-size:16px;font-weight:500;line-height:1.4;">Invitez facilement vos amis à rejoindre votre sortie. Chacun peut consulter les informations de la soirée et suivre le parcours prévu.</p>
    </div>

    <div style="display:flex;flex-direction:column;gap:26px;">
      <h3 style="color:#000;">Découvrez les bars autour de vous</h3>
      <p style="color:#646262;font-size:16px;font-weight:500;line-height:1.4;">Bargo intègre une sélection de bars disponibles. Consultez les informations essentielles et créez facilement votre parcours pour la soirée.</p>
    </div>

    <div style="display:flex;flex-direction:column;gap:26px;">
      <h3 style="color:#000;">Débloquez des récompenses</h3>
      <p style="color:#646262;font-size:16px;font-weight:500;line-height:1.4;">Bargo propose un système de badges et de récompenses pour encourager les sorties responsables. Participez à des barathons et débloquez des récompenses au fil de vos soirées.</p>
    </div>

  </div>
</section>

<!-- ========== NOS BARS BANNER (h:440px) ========== -->
<section style="position:relative;width:100%;height:440px;background:#094736;" id="bars">
  <!-- H1 NOS BARS: top:113px, left:80px -->
  <h1 style="position:absolute;top:113px;left:80px;color:#fff;text-transform:uppercase;white-space:nowrap;">
    NOS BARS
  </h1>
  <!-- Description: top:128px, left:736px, w:547px -->
  <p style="position:absolute;top:128px;left:736px;width:547px;color:#f7f1ed;font-size:16px;font-weight:500;line-height:1.4;">
    Explorez les bars de Montbéliard et choisissez les étapes de votre prochaine tournée. Créez un parcours sur mesure pour une soirée organisée et conviviale.
  </p>
</section>

<!-- ========== BAR CAROUSEL (h:844px) — animation : bg monte, card part à gauche ========== -->
{barsData.length > 0 && (
  <section style="position:relative;width:100%;height:844px;overflow:hidden;background:#094736;">

    <!-- ── Zone gauche : image de fond + nom du bar (595px, overflow:hidden pour l'animation) ── -->
    <div id="lp-bg-wrap" style="position:absolute;left:0;top:0;width:595px;height:100%;overflow:hidden;border-radius:0 5px 0 0;">

      <!-- Slide A (actif) -->
      <div id="lp-bg-a" style="position:absolute;left:0;top:0;width:100%;height:100%;">
        <div id="lp-prlx-a" style={`position:absolute;inset:0;background-image:url('${barsData[0].parallaxUrl}');background-size:cover;background-position:center 50%;`}></div>
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(30,30,30,0.65) 0%,transparent 55%);pointer-events:none;"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(30,30,30,0.35) 0%,transparent 40%);pointer-events:none;"></div>
        <h2 id="lp-nom-a" style="position:absolute;left:73px;top:378px;color:#fff;width:411px;margin:0;">{barsData[0].nom}</h2>
      </div>

      <!-- Slide B (prêt en dessous) -->
      <div id="lp-bg-b" style="position:absolute;left:0;top:0;width:100%;height:100%;transform:translateY(100%);">
        <div id="lp-prlx-b" style="position:absolute;inset:0;background-size:cover;background-position:center 50%;"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(30,30,30,0.65) 0%,transparent 55%);pointer-events:none;"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(30,30,30,0.35) 0%,transparent 40%);pointer-events:none;"></div>
        <h2 id="lp-nom-b" style="position:absolute;left:73px;top:378px;color:#fff;width:411px;margin:0;"></h2>
      </div>
    </div>

    <!-- ── Zone droite : carte blanche + photo extérieure (de left:517px, overflow:hidden) ── -->
    <div id="lp-card-wrap" style="position:absolute;left:517px;top:0;right:0;height:100%;overflow:hidden;">

      <!-- Card A (active) -->
      <div id="lp-card-a" style="position:absolute;left:0;top:0;width:100%;height:100%;">
        <!-- carte blanche : left:0 (= 517px section), top:156px, w:328px, h:505px -->
        <div style="position:absolute;left:0;top:156px;width:328px;height:505px;background:#fff;border-radius:10px 0 0 10px;box-shadow:-15px 15px 30px 0px rgba(0,0,0,0.15);"></div>
        <!-- adresse : left:78px (= 595-517), top:214px -->
        <p id="lp-adr-a" style="position:absolute;left:78px;top:214px;width:218px;font-size:16px;font-weight:500;line-height:1.4;color:#000;">{barsData[0].adresse}</p>
        <!-- description : top:343px -->
        <p id="lp-desc-a" style="position:absolute;left:78px;top:343px;width:177px;font-size:14px;font-weight:500;line-height:1.1;color:#646262;">{barsData[0].description}</p>
        <!-- bouton : top:526px, h:80px, w:218px -->
        <a id="lp-link-a" href={`/bar/${barsData[0].id}`}
          style="position:absolute;left:78px;top:526px;width:218px;height:80px;background:#1e1e1e;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:16px;font-weight:500;text-decoration:none;">
          En savoir plus
        </a>
        <!-- photo extérieure : left:328px (= 845-517), top:156px, w:438px, h:505px -->
        <div style="position:absolute;left:328px;top:156px;width:438px;height:505px;border-radius:0 10px 10px 0;overflow:hidden;box-shadow:-15px 15px 30px 0px rgba(0,0,0,0.25);">
          <img id="lp-img-a" src={barsData[0].cardImgUrl} alt="" style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
      </div>

      <!-- Card B (prête à droite) -->
      <div id="lp-card-b" style="position:absolute;left:0;top:0;width:100%;height:100%;transform:translateX(-100%);">
        <div style="position:absolute;left:0;top:156px;width:328px;height:505px;background:#fff;border-radius:10px 0 0 10px;box-shadow:-15px 15px 30px 0px rgba(0,0,0,0.15);"></div>
        <p id="lp-adr-b" style="position:absolute;left:78px;top:214px;width:218px;font-size:16px;font-weight:500;line-height:1.4;color:#000;"></p>
        <p id="lp-desc-b" style="position:absolute;left:78px;top:343px;width:177px;font-size:14px;font-weight:500;line-height:1.1;color:#646262;"></p>
        <a id="lp-link-b" href="#"
          style="position:absolute;left:78px;top:526px;width:218px;height:80px;background:#1e1e1e;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:16px;font-weight:500;text-decoration:none;">
          En savoir plus
        </a>
        <div style="position:absolute;left:328px;top:156px;width:438px;height:505px;border-radius:0 10px 10px 0;overflow:hidden;box-shadow:-15px 15px 30px 0px rgba(0,0,0,0.25);">
          <img id="lp-img-b" src="" alt="" style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
      </div>
    </div>

    <!-- ── Navigation (statique, au-dessus des wraps) ── -->
    <button id="lp-bar-prev" aria-label="Bar précédent"
      style="position:absolute;left:955px;top:708px;width:65px;height:65px;background:transparent;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10;">
      <div style="position:absolute;width:46px;height:46px;background:#f7f1ed;border-radius:100px;"></div>
      <svg style="position:relative;z-index:1;" width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M11 14L6 9L11 4" stroke="#1e1e1e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <button id="lp-bar-next" aria-label="Bar suivant"
      style="position:absolute;left:1064px;top:708px;width:65px;height:65px;background:transparent;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10;">
      <div style="position:absolute;width:46px;height:46px;background:#f7f1ed;opacity:0.5;border-radius:100px;"></div>
      <svg style="position:relative;z-index:1;" width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M7 4L12 9L7 14" stroke="#1e1e1e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <p id="lp-bar-counter" style="position:absolute;left:1234px;top:725px;color:#f7f1ed;font-size:16px;font-weight:500;line-height:1.4;white-space:nowrap;z-index:10;">
      1 / {barsData.length}
    </p>

    <!-- Lignes décoratives verticales -->
    <div style="position:absolute;left:157px;top:0;width:1px;height:270px;background:rgba(247,241,237,0.35);z-index:10;"></div>
    <div style="position:absolute;left:157px;top:527px;width:1px;bottom:0;background:rgba(247,241,237,0.35);z-index:10;"></div>

  </section>
)}

<!-- ========== VALEURS CAROUSEL (h:761px) ========== -->
<section id="vision" style="position:relative;width:100%;height:761px;overflow:hidden;background:#fff;">

  <!-- H2: top:98px, left:71px -->
  <h2 style="position:absolute;top:98px;left:71px;color:#000;width:1219px;">
    Ce que vous trouverez en venant chez nous
  </h2>

  <!-- Slides track -->
  <div id="lp-val-track" style="position:absolute;top:0;left:0;width:300%;height:100%;display:flex;transition:transform 0.5s ease-in-out;">
    {valeurs.map((v, i) => (
      <div style="width:1440px;height:100%;flex-shrink:0;position:relative;background:#fff;">
        <!-- Text: left:80px, top:261px, w:296px -->
        <div style="position:absolute;left:80px;top:261px;width:296px;display:flex;flex-direction:column;gap:49px;">
          <h3 style="color:#000;">{v.titre}</h3>
          <p style="font-size:16px;font-weight:500;line-height:1.4;color:#000;width:279px;">{v.texte}</p>
        </div>
        <!-- Image: left:517px, top:218px, w:843px, h:400px -->
        <div style="position:absolute;left:517px;top:218px;width:843px;height:400px;border-radius:10px;overflow:hidden;">
          <Image src={valeursImages[i]} alt={v.titre} style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
      </div>
    ))}
  </div>

  <!-- Nav: left:80px, top:575px -->
  <button id="lp-val-prev" aria-label="Précédent"
    style="position:absolute;left:80px;top:575px;width:43px;height:43px;background:transparent;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;">
    <div style="position:absolute;inset:50% 50%;transform:translate(-50%,-50%);width:30px;height:30px;background:#000;border-radius:100px;"></div>
    <svg style="position:relative;z-index:1;" width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M9 11L4 7L9 3" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <button id="lp-val-next" aria-label="Suivant"
    style="position:absolute;left:142px;top:575px;width:43px;height:43px;background:transparent;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;">
    <div style="position:absolute;inset:50% 50%;transform:translate(-50%,-50%);width:30px;height:30px;background:#000;opacity:0.5;border-radius:100px;"></div>
    <svg style="position:relative;z-index:1;" width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M5 3L10 7L5 11" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- "En savoir plus" green button: left:calc(75%+43px)≈1123px, top:669px -->
  <a href="/Apropos"
    style="position:absolute;left:calc(75% + 43px);top:669px;width:237px;height:60px;background:#347645;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:16px;font-weight:500;text-decoration:none;padding:0 50px;">
    En savoir plus
  </a>

</section>

<!-- ========== ÉQUIPE ========== -->
<section id="equipe" style="position:relative;width:100%;height:1375px;background:#fff;overflow:hidden;">

  <!-- H2: top:0 (3989-3882=107px?), left:80px -->
  <!-- Relative to section start (3882px from page = after valeurs carousel): -->
  <!-- Team section starts at: 685+1153+440+844+761 = 3883px from page top -->
  <!-- H2 at page:3989 → section:3989-3883=106px from section top -->
  <h2 style="position:absolute;top:106px;left:80px;width:657px;color:#000;">L'équipe derrière Bargo</h2>

  <!-- Description texts on left -->
  <p style="position:absolute;top:185px;left:80px;width:515px;color:#646262;font-size:16px;font-weight:500;line-height:1.4;">
    Bargo est un projet réalisé par une équipe d'étudiants passionnés par le design, le numérique et l'expérience utilisateur.
  </p>
  <p style="position:absolute;top:273px;left:80px;width:405px;color:#646262;font-size:16px;font-weight:500;line-height:1.4;">
    Le projet a été conçu dans le cadre d'un travail de réflexion et de création autour d'une plateforme dédiée à l'organisation des sorties.
  </p>
  <p style="position:absolute;top:383px;left:80px;width:296px;color:#646262;font-size:16px;font-weight:500;line-height:1.4;">
    Notre objectif était d'imaginer une solution simple, moderne et adaptée aux habitudes des étudiants et jeunes adultes.
  </p>

  <!-- Alex photo (right, starts highest): page:3989 → section:106px, left:calc(66.67%-5px)≈955px, w:405px, h:495px -->
  <div style="position:absolute;top:106px;left:955px;width:405px;height:495px;border-radius:10px;overflow:hidden;">
    <Image src={membre3} alt="Alex Ringenbach" style="width:100%;height:100%;object-fit:cover;display:block;" />
  </div>
  <h3 style="position:absolute;top:655px;left:955px;color:#72c073;width:328px;">Alex Ringenbach</h3>
  <p style="position:absolute;top:707px;left:955px;color:#000;font-size:16px;font-weight:500;line-height:1.4;width:296px;">Communication</p>
  <p style="position:absolute;top:771px;left:955px;color:#646262;font-size:14px;font-weight:500;line-height:1.1;width:328px;">Gère l'image et la visibilité du projet. Il s'occupe de la stratégie de communication et du lien avec la communauté.</p>

  <!-- Pierre photo (center, 220px lower): page:4209 → section:326px, left:calc(33.33%+37px)≈517px, w:406px, h:495px -->
  <div style="position:absolute;top:326px;left:517px;width:406px;height:495px;border-radius:10px;overflow:hidden;">
    <Image src={membre2} alt="Pierre Mouilleseaux-Lhuillier" style="width:100%;height:100%;object-fit:cover;display:block;" />
