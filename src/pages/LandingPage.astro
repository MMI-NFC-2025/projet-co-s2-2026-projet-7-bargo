<script type="application/json" id="lp-bars-data" set:html={JSON.stringify(barsData)}></script>

<script is:inline>
(function () {
  // ============================================================
  // CAROUSEL BARS — bg monte vers le haut, card part à gauche
  // ============================================================
  var _bars    = JSON.parse(document.getElementById('lp-bars-data').textContent || '[]');
  var _barIdx  = 0;
  var _current = 'a';   // slot visible ('a' ou 'b')
  var _busy    = false;
  var DUR      = 600;   // durée ms

  function _q(id) { return document.getElementById(id); }

  function _goTo(newIdx) {
    if (_busy || !_bars.length || newIdx === _barIdx) return;
    _busy = true;

    var next = _current === 'a' ? 'b' : 'a';
    var b    = _bars[newIdx];

    // Charger les données dans le prochain slot
    var prlx = _q('lp-prlx-' + next);
    if (prlx) prlx.style.backgroundImage = b.parallaxUrl ? "url('" + b.parallaxUrl + "')" : '';
    var nom = _q('lp-nom-' + next);  if (nom)  nom.textContent  = b.nom;
    var adr  = _q('lp-adr-'  + next); if (adr)  adr.textContent  = b.adresse;
    var desc = _q('lp-desc-' + next); if (desc) desc.textContent = b.description;
    var lnk  = _q('lp-link-' + next); if (lnk)  lnk.href = '/bar/' + b.id;
    var img  = _q('lp-img-'  + next); if (img)  img.src  = b.cardImgUrl || '';

    // Placer le prochain slot hors-écran (sans transition)
    var bgNext   = _q('lp-bg-'   + next);
    var cardNext = _q('lp-card-' + next);
    bgNext.style.transition   = 'none';
    bgNext.style.transform    = 'translateY(100%)';  // en dessous
    cardNext.style.transition = 'none';
    cardNext.style.transform  = 'translateX(-100%)';  // prêt à gauche (entrera depuis la gauche)

    // Forcer le reflow
    bgNext.offsetHeight;

    // Lancer les transitions
    var ease = 'transform ' + DUR + 'ms cubic-bezier(0.4, 0, 0.2, 1)';
    var bgCur   = _q('lp-bg-'   + _current);
    var cardCur = _q('lp-card-' + _current);

    // Sortie : bg monte, card part à droite
    bgCur.style.transition   = ease;
    bgCur.style.transform    = 'translateY(-100%)';
    cardCur.style.transition = ease;
    cardCur.style.transform  = 'translateX(100%)';

    // Entrée : bg depuis le bas, card depuis la gauche
    bgNext.style.transition   = ease;
    bgNext.style.transform    = 'translateY(0)';
    cardNext.style.transition = ease;
    cardNext.style.transform  = 'translateX(0)';

    setTimeout(function () {
      // Repositionner l'ancien slot pour le prochain cycle
      bgCur.style.transition   = 'none';
      bgCur.style.transform    = 'translateY(100%)';
      cardCur.style.transition = 'none';
      cardCur.style.transform  = 'translateX(-100%)';

      _current = next;
      _barIdx  = newIdx;
      _busy    = false;

      var ctr = _q('lp-bar-counter');
      if (ctr) ctr.textContent = (_barIdx + 1) + ' / ' + _bars.length;
    }, DUR + 50);
  }

  var prev = _q('lp-bar-prev');
  var nxt  = _q('lp-bar-next');
  if (prev) prev.addEventListener('click', function () { _goTo((_barIdx - 1 + _bars.length) % _bars.length); });
  if (nxt)  nxt.addEventListener('click',  function () { _goTo((_barIdx + 1) % _bars.length); });

  // Parallax scroll : décale le background-position-y du slot actif
  window.addEventListener('scroll', function () {
    var prlx = _q('lp-prlx-' + _current);
    if (!prlx) return;
    var wrap = _q('lp-bg-wrap');
    if (!wrap) return;
    var rect = wrap.getBoundingClientRect();
    var pct  = 50 - (rect.top / window.innerHeight) * 15;
    prlx.style.backgroundPositionY = pct + '%';
  }, { passive: true });

  // ============================================================
  // CAROUSEL VALEURS
  // ============================================================
  var _valIdx   = 0;
  var _valTotal = 3;
  var _valTrack = _q('lp-val-track');

  function _updateVal() {
    if (_valTrack) {
      _valTrack.style.transition = 'transform 0.5s ease-in-out';
      _valTrack.style.transform  = 'translateX(-' + (_valIdx * (100 / _valTotal)) + '%)';
    }
  }

  var vp = _q('lp-val-prev');
  var vn = _q('lp-val-next');
  if (vp) vp.addEventListener('click', function () { _valIdx = (_valIdx - 1 + _valTotal) % _valTotal; _updateVal(); });
  if (vn) vn.addEventListener('click', function () { _valIdx = (_valIdx + 1) % _valTotal; _updateVal(); });
})();
</script>

</body>
