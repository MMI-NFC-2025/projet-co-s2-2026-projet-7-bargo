     class="absolute top-[593px] left-[34px] w-[162px] h-[40px] text-sm
            lg:top-[669px] lg:left-[calc(75%+43px)] lg:w-[237px] lg:h-[60px] lg:text-base lg:font-medium
            bg-[#347645] inline-flex items-center justify-center text-white no-underline">
    En savoir plus
  </a>
</section>

<!-- ========== ÉQUIPE ========== -->
<section id="equipe" class="relative w-full bg-white overflow-hidden lg:h-[1375px]">

  <!-- Titre & descriptions -->
  <h2 class="px-[34px] pt-0 lg:px-0 lg:absolute lg:top-[106px] lg:left-[80px] lg:w-[657px] text-[25px] font-medium tracking-[-1px] leading-[1.4] lg:text-[50px] lg:font-bold lg:tracking-[3px] lg:leading-none text-black">
    L'équipe derrière Bargo
  </h2>
  <p class="px-[34px] mt-4 lg:px-0 lg:mt-0 lg:absolute lg:top-[185px] lg:left-[80px] lg:w-[515px] text-[#646262] text-base font-medium leading-[1.4]">
    Bargo est un projet réalisé par une équipe d'étudiants passionnés par le design, le numérique et l'expérience utilisateur.
  </p>
  <p class="px-[34px] mt-4 lg:px-0 lg:mt-0 lg:absolute lg:top-[273px] lg:left-[80px] lg:w-[405px] text-[#646262] text-base font-medium leading-[1.4]">
    Le projet a été conçu dans le cadre d'un travail de réflexion et de création autour d'une plateforme dédiée à l'organisation des sorties.
  </p>
  <p class="px-[34px] mt-4 lg:px-0 lg:mt-0 lg:absolute lg:top-[383px] lg:left-[80px] lg:w-[296px] text-[#646262] text-base font-medium leading-[1.4]">
    Notre objectif était d'imaginer une solution simple, moderne et adaptée aux habitudes des étudiants et jeunes adultes.
  </p>

  <!-- Desktop: photos -->
  <div class="hidden lg:block absolute top-[106px] left-[955px] w-[405px] h-[495px] rounded-[10px] overflow-hidden">
    <Image src={membre3} alt="Alex Ringenbach" class="w-full h-full object-cover block" />
  </div>
