        <div class="absolute inset-0 bg-gradient-to-b from-[rgba(9,71,54,0.9)] to-[rgba(9,71,54,0.5)]"></div>
      </div>

      <!-- Carte blanche -->
      <div class="absolute top-[227px] left-[25px] w-[344px] h-[416px] bg-white rounded-[5px] shadow-[-7px_7px_15px_0px_rgba(0,0,0,0.25)] overflow-hidden">
        <div class="w-full h-[217px] overflow-hidden rounded-t-[5px] shrink-0">
          <img id="lp-mob-img" src={barsData[0].cardImgUrl} alt="" class="w-full h-full object-cover block" />
