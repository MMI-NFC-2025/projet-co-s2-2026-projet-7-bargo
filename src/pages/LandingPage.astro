        <div class="absolute left-[328px] top-[156px] w-[438px] h-[505px] rounded-r-[10px] overflow-hidden shadow-[-15px_15px_30px_0px_rgba(0,0,0,0.25)]">
          <img id="lp-img-b" src="" alt="" class="w-full h-full object-cover block" />
