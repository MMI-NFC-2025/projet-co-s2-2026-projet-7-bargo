---
// @ts-nocheck
import { Image } from 'astro:assets';
import { getCollection, getImageUrl } from '../js/backend.js';
import Layout from '../layouts/Layout.astro';

import heroImg     from '../assets/img/landing_page_hero.avif';
import cotelImg    from '../assets/img/cotel.avif';
import carouselImg from '../assets/img/img_carousle-1.avif';
import footerBg    from '../assets/img/footer.avif';
import membre1     from '../assets/img/melvyn_philippon.avif';
import membre2     from '../assets/img/pierre_mouilleseaux_lhuillier.avif';
import membre3     from '../assets/img/alex_ringenbach.avif';
import iconFb      from '../assets/icon/facebook.svg';
import iconInsta   from '../assets/icon/insta.svg';
import iconDiscord from '../assets/icon/discord.svg';
import logoLight   from '../assets/icon/logo-light.svg';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (token && userId) return Astro.redirect('/');

const bars = await getCollection('bar', { sort: 'created' });

function truncate15(text) {
  if (!text) return '';
  const words = text.trim().split(/\s+/);
  if (words.length <= 15) return text;
  return words.slice(0, 15).join(' ') + '\u2026';
}

const barsData = bars.map(bar => ({
  id:          bar.id,
  nom:         bar.nom ?? '',
  adresse:     bar.adresse ?? '',
  description: truncate15(bar.description),
  parallaxUrl: bar.galerie?.[0]
    ? getImageUrl(bar, bar.galerie[0])
    : (bar.img?.[0] ? getImageUrl(bar, bar.img[0]) : ''),
  cardImgUrl: bar.img?.[0] ? getImageUrl(bar, bar.img[0]) : '',
}));

const valeurs = [
  { titre: 'Convivialité',   texte: "Bargo favorise les moments de partage entre amis. La plateforme est pensée pour rendre les sorties plus simples, agréables et collectives." },
  { titre: 'Sécurité',       texte: "La sécurité est au cœur du projet Bargo. La plateforme aide les utilisateurs à organiser leurs sorties tout en facilitant un retour plus serein après la soirée." },
  { titre: 'Responsabilité', texte: "Le projet encourage une approche responsable des sorties. Bargo propose des outils qui aident les utilisateurs à mieux anticiper leurs déplacements et leurs décisions." },
];
const valeursImages = [cotelImg, heroImg, carouselImg];
---

<Layout title="Bargo — Sortez organisés, rentrez en sécurité" noFooter>

<!-- ========== HERO ========== -->
<section class="relative w-full h-[630px] lg:h-[685px] overflow-hidden">
  <Image src={heroImg} alt="" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-b from-[rgba(30,30,30,0.7)] to-[#1e1e1e]"></div>

  <h1 class="absolute top-[150px] left-[13px] w-[360px] text-[35px] leading-[1.2] tracking-[2.1px]
             lg:top-[309px] lg:-translate-y-1/2 lg:left-[80px] lg:w-[1038px] lg:text-[90px] lg:leading-none lg:tracking-[5.4px]
             text-white uppercase">
    Sortez organisés rentrez en sécurité
  </h1>

  <p class="absolute top-[375px] left-[13px] w-[265px] text-[14px] leading-[1.1]
            lg:top-[521px] lg:left-[80px] lg:w-[515px] lg:text-base lg:leading-[1.4]
            text-white font-medium">
    Bargo est la première plateforme qui simplifie l'organisation des soirées entre amis tout en garantissant un retour sécurisé à la maison.
  </p>

  <a href="/connexion"
     class="absolute top-[537px] left-[13px] w-[200px] h-[40px] text-[14px] font-medium
            lg:top-[544px] lg:left-[calc(75%-16px)] lg:w-[296px] lg:h-[60px] lg:text-base lg:font-bold
            bg-[#347645] inline-flex items-center justify-center text-white no-underline">
    Découvrir Bargo
  </a>
</section>

<!-- ========== CE QUE BARGO ========== -->
<section id="produit" class="relative w-full bg-white overflow-hidden lg:h-[1153px]">

  <!-- Desktop image (droite, cachée mobile) -->
  <div class="hidden lg:block absolute top-[157px] left-[736px] w-[704px] h-[862px] rounded-b-[10px] overflow-hidden">
    <Image src={cotelImg} alt="Soirée Bargo" class="w-full h-full object-cover block" />
  </div>

  <!-- Titre -->
  <h2 class="px-[19px] pt-[48px] pb-6 text-[25px] font-medium tracking-[-1px] leading-[1.4]
             lg:absolute lg:top-[157px] lg:left-[80px] lg:px-0 lg:pt-0 lg:pb-0 lg:w-[508px] lg:text-[50px] lg:font-bold lg:tracking-[3px] lg:leading-none
             text-black">
    Ce que Bargo permet de faire
  </h2>

  <!-- Feat 1 & 2 (mobile) -->
  <div class="flex flex-col gap-6 px-[28px] lg:hidden pb-6">
    <div class="flex flex-col gap-[10px]">
      <h3 class="text-black text-[16px] font-bold tracking-normal leading-[1.4]">Planifiez votre soirée facilement</h3>
      <p class="text-[#646262] text-[14px] font-medium leading-[1.1]">Créez une sortie en quelques clics. Choisissez les bars, définissez l'ordre des étapes et préparez votre parcours pour la soirée.</p>
    </div>
    <div class="flex flex-col gap-[10px]">
      <h3 class="text-black text-[16px] font-bold tracking-normal leading-[1.4]">Invitez vos amis</h3>
      <p class="text-[#646262] text-[14px] font-medium leading-[1.1]">Invitez facilement vos amis à rejoindre votre sortie. Chacun peut consulter les informations de la soirée et suivre le parcours prévu.</p>
    </div>
  </div>

  <!-- Image mobile (entre feat 2 et 3) -->
  <div class="block lg:hidden w-full h-[306px] overflow-hidden">
    <Image src={cotelImg} alt="Soirée Bargo" class="w-full h-full object-cover block" />
  </div>

  <!-- Feat 3 & 4 (mobile) -->
  <div class="flex flex-col gap-6 px-[28px] lg:hidden py-6">
    <div class="flex flex-col gap-[10px]">
      <h3 class="text-black text-[16px] font-bold tracking-normal leading-[1.4]">Découvrez les bars autour de vous</h3>
      <p class="text-[#646262] text-[14px] font-medium leading-[1.1]">Bargo intègre une sélection de bars disponibles. Consultez les informations essentielles et créez facilement votre parcours pour la soirée.</p>
    </div>
    <div class="flex flex-col gap-[10px] pb-10">
      <h3 class="text-black text-[16px] font-bold tracking-normal leading-[1.4]">Débloquez des récompenses</h3>
      <p class="text-[#646262] text-[14px] font-medium leading-[1.1]">Bargo propose un système de badges et de récompenses pour encourager les sorties responsables. Participez à des barathons et débloquez des récompenses au fil de vos soirées.</p>
    </div>
  </div>

  <!-- Feat 1-4 desktop (toutes les 4, absolues) -->
  <div class="hidden lg:flex absolute top-[334px] left-[80px] w-[516px] flex-col gap-[59px]">
    <div class="flex flex-col gap-[26px]">
      <h3 class="text-black">Planifiez votre soirée facilement</h3>
      <p class="text-[#646262] text-base font-medium leading-[1.4]">Créez une sortie en quelques clics. Choisissez les bars, définissez l'ordre des étapes et préparez votre parcours pour la soirée.</p>
    </div>
    <div class="flex flex-col gap-[26px]">
      <h3 class="text-black">Invitez vos amis</h3>
      <p class="text-[#646262] text-base font-medium leading-[1.4]">Invitez facilement vos amis à rejoindre votre sortie. Chacun peut consulter les informations de la soirée et suivre le parcours prévu.</p>
    </div>
    <div class="flex flex-col gap-[26px]">
      <h3 class="text-black">Découvrez les bars autour de vous</h3>
      <p class="text-[#646262] text-base font-medium leading-[1.4]">Bargo intègre une sélection de bars disponibles. Consultez les informations essentielles et créez facilement votre parcours pour la soirée.</p>
    </div>
    <div class="flex flex-col gap-[26px]">
      <h3 class="text-black">Débloquez des récompenses</h3>
      <p class="text-[#646262] text-base font-medium leading-[1.4]">Bargo propose un système de badges et de récompenses pour encourager les sorties responsables. Participez à des barathons et débloquez des récompenses au fil de vos soirées.</p>
    </div>
  </div>
</section>

<!-- ========== NOS BARS BANNER ========== -->
<section id="bars" class="relative w-full h-[200px] lg:h-[440px] bg-[#094736]">
  <h1 class="absolute top-[44px] left-[19px] text-[25px] font-bold tracking-[-1px] leading-[1.4]
             lg:top-[113px] lg:left-[80px] lg:text-[90px] lg:tracking-[5.4px] lg:leading-none
             text-white uppercase whitespace-nowrap">
    NOS BARS
  </h1>
  <p class="absolute top-[100px] left-[25px] w-[332px] text-[14px] leading-[1.1]
            lg:top-[128px] lg:left-[736px] lg:w-[547px] lg:text-base lg:leading-[1.4]
            text-[#f7f1ed] font-medium">
    Explorez les bars de Montbéliard et choisissez les étapes de votre prochaine tournée. Créez un parcours sur mesure pour une soirée organisée et conviviale.
  </p>
</section>

<!-- ========== BAR CAROUSEL ========== -->
{barsData.length > 0 && (
  <section id="lp-bar-carousel" class="relative w-full h-[802px] lg:h-[844px] overflow-hidden bg-[#094736]">

    <!-- Desktop: parallax panel gauche -->
