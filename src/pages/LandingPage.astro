      <div class="flex-shrink-0 w-1/3 h-full relative bg-transparent lg:bg-white">
        <!-- Image -->
        <div class="absolute top-[150px] left-[34px] w-[325px] h-[255px] rounded-[5px] overflow-hidden
                    lg:top-[218px] lg:left-[517px] lg:w-[843px] lg:h-[400px] lg:rounded-[10px]">
          <Image src={valeursImages[i]} alt={v.titre} class="w-full h-full object-cover block" />
        </div>
        <!-- Texte -->
        <div class="absolute top-[440px] left-[34px] w-[265px] flex flex-col gap-4
                    lg:top-[261px] lg:left-[80px] lg:w-[296px] lg:gap-[49px]">
          <h3 class="text-black text-[16px] font-medium tracking-normal leading-[1.4] lg:text-[25px] lg:tracking-[-1px]">{v.titre}</h3>
          <p class="text-black text-sm font-medium leading-[1.1] lg:text-base lg:leading-[1.4] lg:w-[279px]">{v.texte}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Boutons nav -->
  <button id="lp-val-prev" aria-label="Précédent"
          class="absolute top-[598px] left-[284px] w-[31px] h-[31px]
                 lg:top-[575px] lg:left-[80px] lg:w-[43px] lg:h-[43px]
                 bg-transparent border-0 cursor-pointer flex items-center justify-center">
    <div class="absolute inset-1/2 -translate-x-1/2 -translate-y-1/2 w-[22px] h-[22px] lg:w-[30px] lg:h-[30px] bg-black rounded-[100px]"></div>
    <svg class="relative z-[1]" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 11L4 7L9 3" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button id="lp-val-next" aria-label="Suivant"
          class="absolute top-[598px] left-[328px] w-[31px] h-[31px]
                 lg:top-[575px] lg:left-[142px] lg:w-[43px] lg:h-[43px]
