---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page introuvable · Bargo">

  <section class="w-full min-h-[calc(100vh-92px)] bg-[#f7f1ed] flex flex-col">

    <!-- Header interne -->
    <div class="border-t-0.5 border-[#094736] py-7">
      <div class="max-w-360 mx-auto px-4 lg:px-20 flex justify-between items-center">
        <span class="text-[#094736] text-3.5 font-medium leading-[1.1] uppercase tracking-1">
          BARGO
        </span>
        <span class="text-[#646262] text-3.5 font-medium leading-[1.1]">
          Erreur / Page introuvable
        </span>
      </div>
    </div>

    <!-- Zone 404 — flex-1 pour occuper l'espace -->
    <div class="flex-1 flex items-center border-b-0.5 border-[#094736] overflow-hidden">
      <div class="max-w-360 mx-auto px-4 lg:px-20 w-full py-10">

        <!-- Gros 404 -->
        <h1 class="m-0 text-[#094736] leading-none" style="font-size: clamp(160px, 22vw, 340px); letter-spacing: -0.02em;">
          404
        </h1>

        <!-- Ligne verte sous le 404 -->
        <div class="w-full h-1.5 bg-[#72c073]"></div>

      </div>
    </div>

    <!-- Bas : message + CTAs -->
    <div class="py-15">
      <div class="max-w-360 mx-auto px-4 lg:px-20 flex flex-col lg:flex-row lg:justify-between items-start lg:items-center gap-6 lg:gap-20">

        <!-- Texte -->
        <div class="flex flex-col gap-4">
          <h3 class="text-[#1e1e1e] m-0">
            Cette page a fermé ses portes.
          </h3>
          <p class="text-[#646262] text-4 font-medium leading-[1.4] m-0">
            L'adresse que vous cherchez n'existe pas ou a été déplacée.<br />
            La tournée continue ailleurs.
          </p>
        </div>

        <!-- CTAs -->
        <div class="flex items-center gap-3 lg:gap-6 shrink-0 flex-wrap">
          <a href="/"
            class="inline-flex items-center justify-center px-12.5 h-15 bg-[#094736] text-white text-4 font-medium leading-[1.4] whitespace-nowrap hover:opacity-90 transition-opacity">
            Retour à l'accueil
          </a>
          <a href="/bar"
            class="inline-flex items-center justify-center px-12.5 h-15 border-0.5 border-[#094736] text-[#094736] text-4 font-medium leading-[1.4] whitespace-nowrap hover:bg-[#094736] hover:text-white transition-colors">
            Voir nos bars
          </a>
        </div>

      </div>
    </div>

  </section>

</Layout>
