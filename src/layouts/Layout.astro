---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bargo — Organisez votre barathon',
  description = 'Bargo vous aide à organiser et vivre des barathons inoubliables. Découvrez nos bars partenaires, nos jeux et créez votre parcours.',
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1e1e1e" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />

    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500&family=Manrope:wght@500;700&display=swap" rel="stylesheet" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg" sizes="any" />
  </head>

  <body class="min-h-full m-0 w-full bg-black text-white antialiased">
    <Header />

    <main class="w-full pt-[92px]">
      <slot />
    </main>

    <Footer />
    <CookieBanner />
  </body>
</html>