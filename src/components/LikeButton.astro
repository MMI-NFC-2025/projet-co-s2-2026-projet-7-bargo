---
import likeIcon     from '../assets/icon/like.svg';
import likeFillIcon from '../assets/icon/like_fill.svg';

const { id, liked = false, variant = 'bar', class: className = '', ariaLabel = 'Favori' } = Astro.props;
---

<button
  class:list={[`like-btn-${variant}`, className]}
  data-id={id}
  type="button"
  aria-label={ariaLabel}>
  <img src={likeIcon.src}     alt="" class={`like-empty size-6 ${liked ? 'hidden' : ''}`} />
  <img src={likeFillIcon.src} alt="" class={`like-filled size-6 ${liked ? '' : 'hidden'}`} />
</button>
