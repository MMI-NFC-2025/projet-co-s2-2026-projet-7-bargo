---
// @ts-nocheck
import notifIcon from '../assets/icon/notifcation.svg';
import { PB_URL } from '../js/backend.js';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
const isLoggedIn = !!(token && userId);

let demandeAmies   = [];
let demandeSession = [];
let notifications  = [];

if (isLoggedIn) {
  try {
    const userRes = await fetch(
      `${PB_URL}/api/collections/users/records/${userId}?expand=demande_amies,demande_session`,
      { headers: { Authorization: `Bearer ${token}` } }
    );
    if (userRes.ok) {
      const user = await userRes.json();
      demandeAmies   = user.expand?.demande_amies  ?? [];
      demandeSession = user.expand?.demande_session ?? [];
    }
  } catch {}

  try {
    const filter = encodeURIComponent(`user = "${userId}" && lu = false`);
    const notifRes = await fetch(
      `${PB_URL}/api/collections/notifications/records?perPage=10&sort=-created&filter=${filter}`,
      { headers: { Authorization: `Bearer ${token}` } }
    );
    if (notifRes.ok) {
      const data = await notifRes.json();
      notifications = data.items ?? [];
    }
  } catch {}
}

const totalCount = demandeAmies.length + demandeSession.length + notifications.length;

function timeAgo(dateStr) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1)  return "À l'instant";
  if (mins < 60) return `Il y a ${mins} min`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Il y a ${hrs}h`;
  return `Il y a ${Math.floor(hrs / 24)}j`;
}
---

{isLoggedIn && totalCount > 0 && (
  <div id="notif-widget" class="notif-widget">

    <!-- Panneau -->
    <div id="notif-panel" class="notif-panel" role="dialog" aria-label="Notifications" aria-modal="false">

      <!-- Header -->
      <div class="notif-panel__header">
        <span class="notif-panel__title">Notifications</span>
        <span class="notif-panel__badge">{totalCount} nouvelle{totalCount > 1 ? 's' : ''}</span>
      </div>

      <!-- Liste -->
      <div class="notif-panel__list">

        {demandeAmies.map(u => (
          <div class="notif-item notif-item--unread">
            <div class="notif-item__avatar notif-item__avatar--dark" aria-hidden="true">
              {(u.pseudo || u.prenom || '?')[0].toUpperCase()}
            </div>
            <p class="notif-item__text">
              <strong class="notif-item__name">{u.pseudo || `${u.prenom ?? ''} ${u.nom ?? ''}`.trim() || 'Utilisateur'}</strong> vous a envoyé une demande d'ami
            </p>
            <div class="notif-item__dot" aria-hidden="true"></div>
          </div>
        ))}

        {demandeSession.map(s => (
          <div class="notif-item notif-item--unread">
            <div class="notif-item__avatar notif-item__avatar--dark" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
              </svg>
            </div>
            <p class="notif-item__text">
              Invitation au barathon <strong class="notif-item__name">{s.nom ?? 'Session sans nom'}</strong>
            </p>
            <div class="notif-item__dot" aria-hidden="true"></div>
          </div>
        ))}

        {notifications.map(notif => (
          <div class="notif-item notif-item--unread">
            <div class="notif-item__avatar notif-item__avatar--green" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="notif-item__body">
              <p class="notif-item__text">{notif.message ?? notif.texte ?? notif.contenu ?? 'Notification'}</p>
              <p class="notif-item__time">{timeAgo(notif.created)}</p>
            </div>
            <div class="notif-item__dot" aria-hidden="true"></div>
          </div>
        ))}

      </div>

      <!-- Footer -->
      <a href="/profil?tab=notifications" class="notif-panel__footer">
        Voir toutes les notifications →
      </a>
    </div>

    <!-- Bouton cloche -->
    <button
      id="notif-btn"
      class="notif-btn"
      aria-label={`Notifications — ${totalCount} non lue${totalCount > 1 ? 's' : ''}`}
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <img src={notifIcon.src} alt="" width="22" height="22" class="notif-btn__icon" aria-hidden="true" />
      <span class="notif-btn__badge" aria-hidden="true">{totalCount > 99 ? '99+' : totalCount}</span>
    </button>

  </div>
)}

<script>
  import '../js/notif-bubble.js';
</script>

<style>
  .notif-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  /* ── Bouton ── */
  .notif-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #1e1e1e;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    position: relative;
    flex-shrink: 0;
  }
  .notif-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
  }
  .notif-btn__icon {
    filter: brightness(0) invert(1);
    flex-shrink: 0;
    pointer-events: none;
  }
  .notif-btn__badge {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background: #ef4444;
    color: white;
    border-radius: 18px;
    font-size: 10px;
    font-weight: 700;
    font-family: 'Inter', sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid white;
    box-sizing: border-box;
    line-height: 1;
    pointer-events: none;
  }

  /* ── Panneau ── */
  .notif-panel {
    display: none;
    width: 320px;
    max-height: 440px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    flex-direction: column;
    overflow: hidden;
  }
  .notif-panel--open {
    display: flex;
  }
  .notif-panel__header {
    padding: 14px 16px;
    background: #1e1e1e;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }
  .notif-panel__title {
    color: white;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 15px;
  }
  .notif-panel__badge {
    background: #ef4444;
    color: white;
    font-size: 10px;
    font-weight: 700;
    font-family: 'Inter', sans-serif;
    padding: 2px 7px;
    border-radius: 20px;
  }
  .notif-panel__list {
    overflow-y: auto;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .notif-panel__footer {
    display: block;
    padding: 11px 16px;
    text-align: center;
    font-size: 13px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    color: #094736;
    text-decoration: none;
    border-top: 1px solid #dfdfdf;
    background: white;
    flex-shrink: 0;
  }
  .notif-panel__footer:hover {
    opacity: 0.8;
  }

  /* ── Items ── */
  .notif-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid #f7f1ed;
  }
  .notif-item--unread {
    background: #f0faf0;
  }
  .notif-item__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 700;
    color: white;
    font-family: 'Inter', sans-serif;
  }
  .notif-item__avatar--dark  { background: #094736; }
  .notif-item__avatar--green { background: #347645; }
  .notif-item__text {
    flex: 1;
    font-size: 12px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    color: #1e1e1e;
    margin: 0;
    line-height: 1.4;
  }
  .notif-item__name { color: #094736; }
  .notif-item__body { flex: 1; min-width: 0; }
  .notif-item__time {
    font-size: 11px;
    font-family: 'Inter', sans-serif;
    color: #646262;
    margin: 3px 0 0;
  }
  .notif-item__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ef4444;
    flex-shrink: 0;
  }
</style>
