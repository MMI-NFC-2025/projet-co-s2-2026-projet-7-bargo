---
// CookieBanner.astro — bandeau de consentement cookies
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[9999] hidden"
  style="background: rgba(20,20,20,0.97); backdrop-filter: blur(8px); border-top: 1px solid rgba(255,255,255,0.08);"
>
  <div class="max-w-360 mx-auto px-4 lg:px-20 py-4 lg:py-5 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 lg:gap-8">
    <p class="text-sm text-[#dfdfdf] m-0 lg:max-w-175 leading-[1.6]">
      Nous utilisons des cookies essentiels pour le bon fonctionnement du site (connexion, session).
      En continuant à naviguer, vous acceptez leur utilisation conformément à notre
      <a href="/mention_legal" class="underline text-[#72c073] hover:opacity-80 transition-opacity">politique de confidentialité</a>.
    </p>
    <div class="flex items-center gap-3 lg:gap-4 shrink-0">
      <button
        id="cookie-refuse"
        class="flex-1 lg:flex-none text-sm text-[#dfdfdf] font-medium px-4 lg:px-6 py-2 border border-[#646262] hover:border-white hover:text-white transition-colors cursor-pointer bg-transparent"
      >
        Refuser
      </button>
      <button
        id="cookie-accept"
        class="flex-1 lg:flex-none text-sm text-white font-medium px-4 lg:px-6 py-2 bg-[#347645] hover:opacity-90 transition-opacity cursor-pointer border-0"
      >
        Accepter
      </button>
    </div>
  </div>
</div>

<script>
  import '../js/cookie-banner.js';
</script>
