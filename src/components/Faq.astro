---
const { items = [], title = "FAQ" } = Astro.props;
---

<section class="bg-[#1e1e1e] py-10 lg:py-20 w-full" id="faq">
  <div class="max-w-360 mx-auto px-4 lg:px-20">
    <h2 class="text-white mb-8 lg:mb-16 m-0 text-10 lg:text-22.5">{title}</h2>
    <div class="lg:ml-[calc(33.33%+38px)]">
      {items.map((item) => (
        <details class="faq-item border-b border-[#dfdfdf]/30 first:border-t first:border-[#dfdfdf]/30">
          <summary class="flex items-center justify-between py-5 font-medium text-4 leading-[1.4] text-[#dfdfdf] cursor-pointer list-none gap-5 select-none [&::-webkit-details-marker]:hidden">
            <span>{item.question}</span>
            <span class="faq-icon shrink-0 text-[#dfdfdf] text-xl leading-none transition-transform duration-200">+</span>
          </summary>
          <p class="font-medium text-3.5 leading-[1.4] text-[#646262] m-0 pb-5 pr-2 lg:pr-10">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import '../js/faq.js';
</script>
