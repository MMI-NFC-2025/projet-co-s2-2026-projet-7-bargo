---
import logoDark from '../assets/icon/logo-dark.svg';
import userIcon  from '../assets/icon/user.svg';
import { getImageUrl } from '../js/backend.js';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
const isLoggedIn = !!(token && userId);
const profileHref = isLoggedIn ? '/profil' : '/connexion';
const path = Astro.url.pathname;

const PB_URL = 'https://pbbargo.pierre-mouilleseaux-lhuillier.fr';
let avatarUrl = null;
if (isLoggedIn) {
  const res = await fetch(`${PB_URL}/api/collections/users/records/${userId}`, {
    headers: { Authorization: `Bearer ${token}` }
  });
  if (res.ok) {
    const user = await res.json();
    if (user.avatar) {
      avatarUrl = getImageUrl(user, user.avatar);
    }
  }
}
---

<header class="fixed top-0 left-0 w-full z-50 bg-white shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)]">
  <div class="max-w-360 mx-auto px-4 lg:px-20 h-23 flex items-center">

    <!-- Logo -->
    <a href="/" class="shrink-0">
      <img src={logoDark.src} alt="Bargo" class="h-10.5 w-auto block" />
    </a>

    <!-- Navigation desktop — inchangé -->
    <nav class="hidden lg:flex items-center ml-13">
      <a href="/bar"
        class={`px-8.75 py-6.25 font-medium text-3.5 leading-[1.1] text-black hover:opacity-70 transition-opacity whitespace-nowrap border-b-1.75 ${path.startsWith('/bar') ? 'border-[#72c073]' : 'border-transparent'}`}>
        Nos bars
      </a>
      <a href="/Apropos"
        class={`px-8.75 py-6.25 font-medium text-3.5 leading-[1.1] text-black hover:opacity-70 transition-opacity whitespace-nowrap border-b-1.75 ${path.startsWith('/Apropos') ? 'border-[#72c073]' : 'border-transparent'}`}>
        A propos
      </a>
      <a href="/jeux"
        class={`px-8.75 py-6.25 font-medium text-3.5 leading-[1.1] text-black hover:opacity-70 transition-opacity whitespace-nowrap border-b-1.75 ${path.startsWith('/jeux') ? 'border-[#72c073]' : 'border-transparent'}`}>
        Nos jeux
      </a>
      <a href="/boutique"
        class={`px-8.75 py-6.25 font-medium text-3.5 leading-[1.1] text-black hover:opacity-70 transition-opacity whitespace-nowrap border-b-1.75 ${path.startsWith('/boutique') ? 'border-[#72c073]' : 'border-transparent'}`}>
        Boutique
      </a>
      <a href="/abonnement"
        class={`px-8.75 py-6.25 font-medium text-3.5 leading-[1.1] text-black hover:opacity-70 transition-opacity whitespace-nowrap border-b-1.75 ${path.startsWith('/abonnement') ? 'border-[#72c073]' : 'border-transparent'}`}>
        Abonnement
      </a>
    </nav>

    <!-- Spacer -->
    <div class="flex-1"></div>

    <!-- Actions desktop — inchangées -->
    <div class="hidden lg:flex items-center gap-6.5">
      <a href={profileHref} aria-label="Mon profil" class="hover:opacity-70 transition-opacity">
        {avatarUrl ? (
          <img src={avatarUrl} alt="Mon profil" width="31" height="31" class="size-7.75 rounded-full object-cover" />
        ) : (
          <img src={userIcon.src} alt="" width="31" height="31" />
        )}
      </a>
      <a href="/session" class="inline-flex items-center justify-center px-12.5 h-11.25 bg-black text-white font-medium text-3.5 leading-[1.1] whitespace-nowrap hover:opacity-80 transition-opacity">
        Crée un barathon
      </a>
    </div>

    <!-- Zone droite mobile : icône connexion + hamburger -->
    <div class="lg:hidden flex items-center gap-4">

      <!-- Connexion / profil -->
      <a href={profileHref} aria-label="Mon profil" class="hover:opacity-70 transition-opacity">
        {avatarUrl ? (
          <img src={avatarUrl} alt="Mon profil" width="30" height="30" class="size-7.5 rounded-full object-cover" />
        ) : (
          <img src={userIcon.src} alt="" width="28" height="28" />
        )}
      </a>

      <!-- Bouton hamburger / croix -->
      <button id="nav-hamburger" aria-label="Ouvrir le menu"
        class="relative w-6.5 h-5 bg-transparent border-0 cursor-pointer p-0 shrink-0">
        <span class="ham-bar absolute left-0 w-full h-0.5 bg-black top-0 origin-center"></span>
        <span class="ham-bar absolute left-0 w-full h-0.5 bg-black top-2.25 origin-center"></span>
        <span class="ham-bar absolute left-0 w-full h-0.5 bg-black top-4.5 origin-center"></span>
      </button>

    </div>

  </div>
</header>

<!-- =====================================================
     MENU MOBILE PLEIN ÉCRAN
===================================================== -->
<div id="nav-mobile-menu"
  class="lg:hidden fixed left-0 right-0 bottom-0 z-[45] flex flex-col"
  style="top: 92px;">

  <!-- Fond flouté -->
  <div id="nav-backdrop" class="absolute inset-0 bg-[#1e1e1e]/92 backdrop-blur-xl"></div>

  <!-- Contenu du menu -->
  <nav class="relative z-10 flex flex-col justify-center h-full px-8 gap-1">

    <!-- Liens nav -->
    <a href="/bar"
      class={`nav-link group flex items-center justify-between py-5 border-b border-white/10 ${path.startsWith('/bar') ? 'text-[#72c073]' : 'text-white'}`}>
      <span class="font-['Manrope'] font-bold text-9 leading-none uppercase tracking-wide">Nos bars</span>
      <span class="text-[#72c073] text-7 font-light opacity-0 group-hover:opacity-100 transition-opacity">→</span>
    </a>

    <a href="/Apropos"
      class={`nav-link group flex items-center justify-between py-5 border-b border-white/10 ${path.startsWith('/Apropos') ? 'text-[#72c073]' : 'text-white'}`}>
      <span class="font-['Manrope'] font-bold text-9 leading-none uppercase tracking-wide">A propos</span>
      <span class="text-[#72c073] text-7 font-light opacity-0 group-hover:opacity-100 transition-opacity">→</span>
    </a>

    <a href="/jeux"
      class={`nav-link group flex items-center justify-between py-5 border-b border-white/10 ${path.startsWith('/jeux') ? 'text-[#72c073]' : 'text-white'}`}>
      <span class="font-['Manrope'] font-bold text-9 leading-none uppercase tracking-wide">Nos jeux</span>
      <span class="text-[#72c073] text-7 font-light opacity-0 group-hover:opacity-100 transition-opacity">→</span>
    </a>

    <a href="/boutique"
      class={`nav-link group flex items-center justify-between py-5 border-b border-white/10 ${path.startsWith('/boutique') ? 'text-[#72c073]' : 'text-white'}`}>
      <span class="font-['Manrope'] font-bold text-9 leading-none uppercase tracking-wide">Boutique</span>
      <span class="text-[#72c073] text-7 font-light opacity-0 group-hover:opacity-100 transition-opacity">→</span>
    </a>

    <a href="/abonnement"
      class={`nav-link group flex items-center justify-between py-5 border-b border-white/10 ${path.startsWith('/abonnement') ? 'text-[#72c073]' : 'text-white'}`}>
      <span class="font-['Manrope'] font-bold text-9 leading-none uppercase tracking-wide">Abonnement</span>
      <span class="text-[#72c073] text-7 font-light opacity-0 group-hover:opacity-100 transition-opacity">→</span>
    </a>

    <!-- CTA session -->
    <div class="mt-8">
      <a href="/session"
        class="nav-link inline-flex items-center justify-center w-full h-14 bg-[#72c073] text-[#094736] font-bold text-4 uppercase tracking-widest hover:bg-[#5aad5b] transition-colors">
        Crée un barathon
      </a>
    </div>

  </nav>
</div>

<style>
  /* Hamburger bars transition */
  .ham-bar {
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), opacity 0.3s ease;
  }

  /* État ouvert */
  #nav-hamburger.is-open .ham-bar:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }
  #nav-hamburger.is-open .ham-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #nav-hamburger.is-open .ham-bar:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  /* Menu overlay transition */
  #nav-mobile-menu {
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.4,0,0.2,1),
                transform 0.35s cubic-bezier(0.4,0,0.2,1);
  }
  #nav-mobile-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Apparition décalée des liens */
  .nav-link {
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.3s ease, transform 0.3s ease, color 0.2s ease;
  }
  #nav-mobile-menu.is-open .nav-link:nth-child(1) { opacity: 1; transform: translateX(0); transition-delay: 0.05s; }
  #nav-mobile-menu.is-open .nav-link:nth-child(2) { opacity: 1; transform: translateX(0); transition-delay: 0.1s;  }
  #nav-mobile-menu.is-open .nav-link:nth-child(3) { opacity: 1; transform: translateX(0); transition-delay: 0.15s; }
  #nav-mobile-menu.is-open .nav-link:nth-child(4) { opacity: 1; transform: translateX(0); transition-delay: 0.2s;  }
  #nav-mobile-menu.is-open .nav-link:nth-child(5) { opacity: 1; transform: translateX(0); transition-delay: 0.25s; }
  #nav-mobile-menu.is-open .nav-link:nth-child(6) { opacity: 1; transform: translateX(0); transition-delay: 0.3s;  }
</style>

<script>
  const btn  = document.getElementById('nav-hamburger');
  const menu = document.getElementById('nav-mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      btn.classList.toggle('is-open', isOpen);
      btn.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
      // Bloquer le scroll de la page quand le menu est ouvert
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    // Fermer si on clique sur un lien
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('is-open');
        btn.classList.remove('is-open');
        document.body.style.overflow = '';
      });
    });
  }
</script>
